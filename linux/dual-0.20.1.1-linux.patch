+namespace {
+
+// When closing was last found switched on in a profile. A tab last used
+// before that is timed from here, so switching on closes nothing at once.
+constexpr char kTabAutoCloseSincePref[] = "helium.dual.tab_auto_close.since";
+
+// How often the tabs are looked at.
+constexpr base::TimeDelta kLookInterval = base::Minutes(5);
+// After the browser starts or the Mac wakes, nothing is closed for this
+// long: tabs that came due meanwhile can still be brought to the front.
+constexpr base::TimeDelta kQuietTime = base::Minutes(10);
+
+// For the tests: --dual-tab-auto-close-test-speed=N makes the time this
+// feature goes by pass N times as fast (an hour of the setting lasts 3600/N
+// seconds; so do the look interval and the quiet time, in proportion).
+double TestSpeed() {
+  static const double speed = [] {
+    double value = 1;
+    const std::string given =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "dual-tab-auto-close-test-speed");
+    if (!base::StringToDouble(given, &value) || !(value >= 1 && value <= 3600)) {
+      value = 1;
+    }
+    return value;
+  }();
+  return speed;
+}
+
+// When a tab was last found in use, where that is later than when it was
+// last brought to the front.
+class LastFoundInUse : public content::WebContentsUserData<LastFoundInUse> {
+ public:
+  ~LastFoundInUse() override = default;
+
+  base::Time time;
+
+ private:
+  friend class content::WebContentsUserData<LastFoundInUse>;
+
+  explicit LastFoundInUse(content::WebContents* contents)
+      : content::WebContentsUserData<LastFoundInUse>(*contents) {}
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
