+// Closing tabs that have gone unused for a long time. Off unless switched on
+// in settings (Performance > Memory), where the time is entered in hours and
+// tabs playing sound can be kept. Never closed: pinned tabs, the tab in front
+// in each window, tabs on screen or at work (a call, a recording, a floating
+// video), tabs whose page asks before it is left, and tabs of private
+// windows. The closed tabs can be opened again from History.
+inline constexpr char kTabAutoCloseEnabledPref[] =
+    "helium.dual.tab_auto_close.enabled";
+inline constexpr char kTabAutoCloseHoursPref[] =
+    "helium.dual.tab_auto_close.hours";
+inline constexpr char kTabAutoCloseKeepAudiblePref[] =
+    "helium.dual.tab_auto_close.keep_audible";
+
+// The settings page offers the same range.
+inline constexpr int kTabAutoCloseDefaultHours = 24;
+inline constexpr int kTabAutoCloseMinHours = 1;
+inline constexpr int kTabAutoCloseMaxHours = 8760;
+
+void RegisterTabAutoClosePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// Starts looking at the open tabs every few minutes. Called when a browser
+// window is created; only the first call does anything.
+void StartTabAutoClose();
+
+// When a tab was last used: brought to the front or, if later, found in use
+// by a look (in front, pinned, at work, or playing sound where such tabs are
+// kept). Session saves record this as the tab's last active time, so it
+// survives a restart.
+base::Time TabLastUsed(content::WebContents* contents);
+
+}  // namespace helium_dual
