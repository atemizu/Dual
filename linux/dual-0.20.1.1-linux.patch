+// Created on 2026-10-06. Licensed under GPL-3.0; see the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_DUAL_PANE_STATE_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_DUAL_PANE_STATE_H_
+
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/ui/helium/helium_dual_state.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+
+namespace ui {
+class UnownedUserDataHost;
+}  // namespace ui
+
+// A browser window's place in a Dual window: which pane it is, which pair it
+// belongs to, and the shared geometry, which the native coordinator keeps up
+// to date for session saves. Attached to the window's UnownedUserDataHost, so
+// any holder of a BrowserWindowInterface reaches it with From().
+class HeliumDualPaneState {
+ public:
+  DECLARE_USER_DATA(HeliumDualPaneState);
+
+  HeliumDualPaneState(const HeliumDualState& state,
+                      ui::UnownedUserDataHost& host);
+  HeliumDualPaneState(const HeliumDualPaneState&) = delete;
+  HeliumDualPaneState& operator=(const HeliumDualPaneState&) = delete;
+  ~HeliumDualPaneState();
+
+  static HeliumDualPaneState* From(BrowserWindowInterface* browser);
+  static const HeliumDualPaneState* From(const BrowserWindowInterface* browser);
+
+  const HeliumDualState& state() const { return state_; }
+  HeliumDualRole role() const { return state_.role; }
+  const std::string& group_id() const { return state_.group_id; }
+  void set_group_id(std::string_view group_id);
+  double ratio() const { return state_.ratio; }
+  void set_ratio(double ratio);
+  const std::string& host_bounds() const { return state_.host_bounds; }
+  void set_host_bounds(std::string_view bounds);
+
+ private:
+  HeliumDualState state_;
+  ui::ScopedUnownedUserData<HeliumDualPaneState> scoped_unowned_user_data_;
+};
+
+namespace helium_dual {
+
+// The pane a browser window is; kNone for no window, and for one that carries
+// no Dual state (a window of a test).
+HeliumDualRole RoleOf(const BrowserWindowInterface* browser);
+
+inline bool IsPaneWindow(const BrowserWindowInterface* browser) {
+  return IsPane(RoleOf(browser));
+}
+
+}  // namespace helium_dual
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_DUAL_PANE_STATE_H_
