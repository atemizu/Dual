+namespace content {
+
+bool HasPendingCompositorFrameForNativeResize(WebContents* web_contents) {
+  if (!web_contents || !web_contents->GetPrimaryMainFrame()) {
+    return false;
+  }
+  bool pending = false;
+  // Start at the primary page, excluding prerendered and back-forward cached
+  // pages. A page's out-of-process subframes must participate in the wait:
+  // the outer IOSurface can already have its new width while a child is stale.
+  web_contents->GetPrimaryMainFrame()->ForEachRenderFrameHostWithAction(
+      [&](RenderFrameHost* frame) {
+        auto* host = RenderWidgetHostImpl::From(frame->GetRenderWidgetHost());
+        auto* view = host->GetView();
+        if (view && !host->IsHidden() && !view->GetViewBounds().IsEmpty()) {
+          const auto& requested = view->GetLocalSurfaceId();
+          const auto& activated =
+              host->render_frame_metadata_provider()->LastRenderFrameMetadata();
+          pending = requested.is_valid() &&
+                    (!activated.local_surface_id ||
+                     !activated.local_surface_id->IsSameOrNewerThan(requested));
+        }
+        return pending ? RenderFrameHost::FrameIterationAction::kStop
+                       : RenderFrameHost::FrameIterationAction::kContinue;
+      });
+  return pending;
+}
+
