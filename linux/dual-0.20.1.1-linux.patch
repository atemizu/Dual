+// The interface ----------------------------------------------------------------
+
+namespace {
+
+BrowserPair* Find(const BrowserView* view) {
+  const BrowserWindowInterface* browser = view ? view->browser() : nullptr;
+  if (!browser) {
+    return nullptr;
+  }
+  auto profile = Pairs().find(browser->GetProfile());
+  if (profile == Pairs().end()) {
+    return nullptr;
+  }
+  auto pair =
+      profile->second.find(HeliumDualPaneState::From(browser)->group_id());
+  if (pair == profile->second.end() || !pair->second ||
+      pair->second->retired() ||
+      pair->second->browser_at(SideIndex(RoleOf(browser))) != browser) {
+    return nullptr;
+  }
+  return pair->second.get();
+}
+
+}  // namespace
+
+namespace {
+
+BrowserPair* FindByWindow(gfx::NativeWindow window) {
+  for (const auto& profile : Pairs()) {
+    for (const auto& entry : profile.second) {
+      BrowserPair* pair = entry.second.get();
+      if (pair && !pair->retired() && pair->widget() &&
+          pair->widget()->GetNativeWindow() == window) {
+        return pair;
+      }
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+bool IsPaneNativeWindow(gfx::NativeWindow window) {
+  BrowserView* view =
+      window ? BrowserView::GetBrowserViewForNativeWindow(window) : nullptr;
+  return view && Find(view);
+}
+
+gfx::NativeWindow PaneWindowAtPoint(
+    gfx::NativeWindow window,
+    const gfx::Point& point,
+    const std::set<gfx::NativeWindow>& excluded_panes,
+    bool* look_beneath) {
+  *look_beneath = false;
+  BrowserPair* pair = window ? FindByWindow(window) : nullptr;
+  if (!pair) {
+    return window;
+  }
+  const gfx::NativeWindow pane = pair->PaneWindowAt(point);
+  // The pane there is left out (being dragged, or emptied by the drag), or
+  // the whole window is: what lies beneath counts.
+  if ((pane && excluded_panes.contains(pane)) ||
+      pair->AllPanesIn(excluded_panes) || !pair->HasVisiblePane()) {
+    *look_beneath = true;
+  }
+  return pane;
+}
+
+gfx::NativeWindow PaneWindowAtPointDirect(
+    const gfx::Point& point,
+    const std::set<gfx::NativeWindow>& excluded_panes) {
+  gfx::NativeWindow best;
+  for (const auto& profile : Pairs()) {
+    for (const auto& entry : profile.second) {
+      BrowserPair* pair = entry.second.get();
+      if (!pair || pair->retired() || !pair->widget() ||
+          !pair->widget()->IsVisible() || pair->widget()->IsMinimized()) {
+        continue;
+      }
+      const gfx::NativeWindow pane = pair->PaneWindowAt(point);
+      if (!pane || excluded_panes.contains(pane)) {
+        continue;
+      }
+      if (!best || pair->IsWindowActive()) {
+        best = pane;
+      }
+    }
+  }
+  return best;
+}
+
+bool HasSiblingPane(const BrowserView* view) {
+  BrowserPair* pair = Find(view);
+  return pair && pair->has_both();
+}
+
+gfx::NativeView ReservePaneHost(BrowserView* view) {
+  BrowserWindowInterface* browser = view->browser();
+  CHECK(IsPane(RoleOf(browser)));
+  PairMap& map = Pairs()[browser->GetProfile()];
+  const std::string original_id = HeliumDualPaneState::From(browser)->group_id();
+  // A pane asked for by its window (the "+"), or one of a restored window.
+  if (auto original = map.find(original_id); original != map.end()) {
+    BrowserPair* owner = original->second.get();
+    BrowserWindowInterface* occupant =
+        owner->browser_at(SideIndex(RoleOf(browser)));
+    if (!owner->retired() && !occupant) {
+      owner->Reserve(view);
+      return owner->native_view();
+    }
+  }
+  // Restoring can bring back a window whose group is still open, or two
+  // windows that claim the same place: the second goes to a window of its
+  // own, and the other pane of its group follows it there.
+  auto& remaps = RestoreRemaps()[browser->GetProfile()];
+  for (auto it = remaps.begin(); it != remaps.end();) {
+    if (it->second.expires < base::TimeTicks::Now() ||
+        !map.contains(it->second.replacement) ||
+        map.at(it->second.replacement)->retired()) {
+      it = remaps.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  if (auto remap = remaps.find(original_id); remap != remaps.end()) {
+    BrowserPair* target = map.at(remap->second.replacement).get();
+    if (!target->browser_at(SideIndex(RoleOf(browser)))) {
+      HeliumDualPaneState::From(browser)->set_group_id(
+          remap->second.replacement);
+      target->Reserve(view);
+      return target->native_view();
+    }
+  }
+  if (auto existing = map.find(original_id); existing != map.end()) {
+    const std::string replacement =
+        base::Uuid::GenerateRandomV4().AsLowercaseString();
+    HeliumDualPaneState::From(browser)->set_group_id(replacement);
+    remaps[original_id] = {replacement,
+                           base::TimeTicks::Now() + base::Seconds(30)};
+  }
+  const std::string group = HeliumDualPaneState::From(browser)->group_id();
+  auto& pair = map[group];
+  CHECK(!pair);
+  pair = std::make_unique<BrowserPair>(browser->GetProfile(), group, view);
+  pair->Reserve(view);
+  return pair->native_view();
+}
+
+gfx::Rect PaneBoundsInScreen(BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    return pair->PaneBoundsInScreen(SideIndex(RoleOf(view->browser())));
+  }
+  return gfx::Rect(0, 0, kMinimumPaneWidth, kMinimumPaneHeight);
+}
+
+void ShowPaneWindow(BrowserView* view, ui::mojom::WindowShowState state) {
+  if (BrowserPair* pair = Find(view)) {
+    pair->ShowPaneWithState(view, state);
+  }
+}
