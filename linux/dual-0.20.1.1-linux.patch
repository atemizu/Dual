+using PairMap = std::map<std::string, std::unique_ptr<BrowserPair>>;
+using ProfileMap = std::map<const Profile*, PairMap>;
+
+ProfileMap& Pairs() {
+  static base::NoDestructor<ProfileMap> pairs;
+  return *pairs;
+}
+
+struct RestoreRemap {
+  std::string replacement;
+  base::TimeTicks expires;
+};
+
+std::map<Profile*, std::map<std::string, RestoreRemap>>& RestoreRemaps() {
+  static base::NoDestructor<
+      std::map<Profile*, std::map<std::string, RestoreRemap>>>
+      remaps;
+  return *remaps;
+}
+
+// The same limits as on macOS (helium_dual_window_host_mac.mm), in DIPs.
+constexpr int kMinimumPaneWidth = 280;
+constexpr int kMinimumPaneHeight = 360;
+constexpr int kDividerWidth = 6;
+// Panes leave a band along the window's sides and bottom free, where the
+// window is resized from (the top is the panes' toolbars, as a title bar).
+constexpr int kResizeEdgeInset = 4;
+// Frameless mode (Zen mode in the source): the outer rails hide like
+// Helium's floating side chrome, and come out at the window's edge.
+constexpr int kFloatingRailInset = 8;
+constexpr int kRailRevealLeeway = 8;
+constexpr int kRailRevealFullscreenTrigger = 2;
+constexpr base::TimeDelta kRailHoverExitGrace = base::Milliseconds(150);
+constexpr base::TimeDelta kRailCursorExitGrace = base::Seconds(3);
+constexpr base::TimeDelta kRailPollInterval = base::Milliseconds(100);
+constexpr base::TimeDelta kRailRevealDuration = base::Milliseconds(200);
+
+size_t SideIndex(HeliumDualRole role) {
+  return role == HeliumDualRole::kRight ? 1 : 0;
+}
+
+bool IsJapanese() {
+  return g_browser_process &&
+         g_browser_process->GetApplicationLocale().starts_with("ja");
+}
+
+std::u16string Words(std::u16string_view ja, std::u16string_view en) {
+  return std::u16string(IsJapanese() ? ja : en);
+}
+
+std::u16string LaunchLabel(bool right) {
+  return right ? Words(u"右のブラウザで新しいタブを開く",
+                       u"Open a new tab in the right browser")
+               : Words(u"左のブラウザで新しいタブを開く",
+                       u"Open a new tab in the left browser");
+}
+
+// See helium_dual_browser_mac.mm.
+VerticalTabStripRegionView* GetPaneRail(BrowserWindowInterface* browser) {
+  auto* elements = BrowserElementsViews::From(browser);
+  if (!elements || !elements->GetContext()) {
+    return nullptr;
+  }
+  for (auto* view : elements->GetAllViews(kTabStripRegionElementId,
+                                          /*require_visible=*/false)) {
+    if (auto* rail = views::AsViewClass<VerticalTabStripRegionView>(view)) {
+      return rail;
+    }
+  }
+  return nullptr;
+}
+
+void InvalidateLayoutOfTree(views::View* root) {
+  root->InvalidateLayout();
+  for (views::View* child : root->children()) {
+    InvalidateLayoutOfTree(child);
+  }
+}
+
+// Saved as "x,y,width,height" in screen DIPs.
+std::string BoundsToString(const gfx::Rect& bounds) {
+  return base::StringPrintf("%d,%d,%d,%d", bounds.x(), bounds.y(),
+                            bounds.width(), bounds.height());
+}
+
+std::optional<gfx::Rect> BoundsFromString(std::string_view text) {
+  const std::vector<std::string_view> parts = base::SplitStringPiece(
+      text, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  int values[4];
+  if (parts.size() != 4) {
+    return std::nullopt;
+  }
+  for (size_t i = 0; i < 4; ++i) {
+    if (!base::StringToInt(parts[i], &values[i])) {
+      return std::nullopt;
+    }
+  }
+  if (values[2] < kMinimumPaneWidth || values[3] < kMinimumPaneHeight) {
+    return std::nullopt;
+  }
+  return gfx::Rect(values[0], values[1], values[2], values[3]);
+}
