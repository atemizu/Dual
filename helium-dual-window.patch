+  BOOL _timeBasesAgree;
+  CGFloat _grabOffsetX;
+  CGFloat _mouseDownScreenX;
+  NSTimeInterval _downEventTime;
+  uint32_t _upCountAtDown;
+  NSTimer* _dragUpdateTimer;
+  CFTimeInterval _lastDragUpdate;
