+
+#pragma mark - Zen mode rails
+
+- (BOOL)autoHideRails {
+  return _autoHideRails;
+}
+
+- (void)setAutoHideRails:(BOOL)autoHide {
+  if (_autoHideRails == autoHide) return;
+  _autoHideRails = autoHide;
+  [self updatePointerMonitor];
+  [self relayout];
+}
+
+// The window edge whose rail hides in Zen mode: a collapsed pane's side, or
+// the empty side next to a lone pane.
+- (BOOL)hideableRailEdge:(HeliumDualPaneSide*)edge {
+  if (!_autoHideRails || _closing) return NO;
+  if (_leftWindow && _rightWindow) {
+    if (_paneHidden[0] == _paneHidden[1]) return NO;
+    *edge = _paneHidden[0] ? HeliumDualPaneSideLeft : HeliumDualPaneSideRight;
+    return YES;
+  }
+  if (!_leftWindow && !_rightWindow) return NO;
+  *edge = _leftWindow ? HeliumDualPaneSideRight : HeliumDualPaneSideLeft;
+  return YES;
+}
+
+- (NSWindow*)railRevealWindow {
+  HeliumDualPaneSide edge = HeliumDualPaneSideRight;
+  if (![self hideableRailEdge:&edge]) return nil;
+  if (_leftWindow && _rightWindow) return [self browserWindowForSide:edge];
+  return _railOverlay;
+}
+
+- (void)updatePointerMonitor {
+  const BOOL wanted = _autoHideRails && !_closing;
+  if (wanted && !_pointerMonitor) {
+    __weak HeliumDualWindowHost* weakSelf = self;
+    _pointerMonitor = [NSEvent
+        addLocalMonitorForEventsMatchingMask:NSEventMaskMouseMoved |
+                                             NSEventMaskLeftMouseDragged
+                                     handler:^NSEvent*(NSEvent* event) {
+      if (RailTraceEnabled()) {
+        NSLog(@"DualRail event type=%lu window=%@", (unsigned long)event.type,
+              event.window.title);
+      }
+      [weakSelf pointerMoved];
+      return event;
+    }];
+  } else if (!wanted && _pointerMonitor) {
+    [NSEvent removeMonitor:_pointerMonitor];
+    _pointerMonitor = nil;
+    [self cancelRailHide];
+    [self setPointerPolling:NO];
+  }
+}
+
+// The visible pane nearest |edge|, not counting a hidden Zen rail.
+- (nullable NSWindow*)paneAtEdge:(HeliumDualPaneSide)edge
+                            side:(HeliumDualPaneSide*)side {
+  NSWindow* rail = [self railRevealWindow];
+  NSWindow* panes[] = {_leftWindow, _rightWindow};
+  NSWindow* best = nil;
+  CGFloat bestDistance = 0;
+  for (size_t index = 0; index < 2; ++index) {
+    if (!panes[index] || panes[index] == rail) continue;
+    const NSRect frame = _expectedPaneFrames[index];
+    const CGFloat distance = edge == HeliumDualPaneSideLeft
+                                 ? NSMinX(frame) - NSMinX(_window.frame)
+                                 : NSMaxX(_window.frame) - NSMaxX(frame);
+    if (!best || distance < bestDistance) {
+      best = panes[index];
+      bestDistance = distance;
+      *side = index ? HeliumDualPaneSideRight : HeliumDualPaneSideLeft;
+    }
+  }
+  return best;
+}
+
+- (void)pointerMoved {
+  if (!_autoHideRails || _closing || !_window.visible ||
+      _window.miniaturized) {
+    [self setPointerPolling:NO];
+    return;
+  }
+  [self evaluatePointer:NSEvent.mouseLocation];
+  // Movement over other apps is not reported; poll while a rail is shown.
+  [self setPointerPolling:_railRevealed];
+}
+
+- (void)setPointerPolling:(BOOL)polling {
+  if (polling == (_railPollTimer != nil)) return;
+  if (!polling) {
+    [_railPollTimer invalidate];
+    _railPollTimer = nil;
+    return;
+  }
+  __weak HeliumDualWindowHost* weakSelf = self;
+  _railPollTimer = [NSTimer scheduledTimerWithTimeInterval:kRailPollInterval
+                                                   repeats:YES
+                                                     block:^(NSTimer* timer) {
+    [weakSelf pointerMoved];
+  }];
+  _railPollTimer.tolerance = kRailPollInterval / 2;
+}
+
+- (void)evaluatePointer:(NSPoint)point {
+  const NSRect host = _window.frame;
+  const BOOL inside = NSPointInRect(point, NSInsetRect(host, -1, -1));
+  HeliumDualPaneSide edge = HeliumDualPaneSideRight;
+  const BOOL hasRail = [self hideableRailEdge:&edge];
+  // The resize band beyond a pane stands in for that pane's own Zen trigger,
+  // which no longer reaches the window edge (or, for a strip facing the
+  // scroll bar side, is kept to the pane's last point).
+  const CGFloat band = [self edgeInset];
+  if (inside && band > 0 && !(NSEvent.pressedMouseButtons & 1)) {
+    const BOOL leftBand = point.x - NSMinX(host) < band;
+    const BOOL rightBand = NSMaxX(host) - point.x < band;
+    const HeliumDualPaneSide bandEdge =
+        leftBand ? HeliumDualPaneSideLeft : HeliumDualPaneSideRight;
+    HeliumDualPaneSide paneSide = HeliumDualPaneSideLeft;
+    if ((leftBand || rightBand) && !(hasRail && edge == bandEdge) &&
+        [self paneAtEdge:bandEdge side:&paneSide] &&
+        [self.delegate respondsToSelector:@selector(heliumDualWindowHost:
+                                                    pointerReachedEdge:
+                                                                ofPane:)]) {
+      [self.delegate heliumDualWindowHost:self
+                       pointerReachedEdge:bandEdge
+                                   ofPane:paneSide];
+    }
+  }
+  if (!hasRail) return;
+  if (!inside) {
+    // Brief excursions outside the window keep the rail, as in Helium.
+    if (_railRevealed) [self scheduleRailHide:kRailCursorExitGrace];
+    return;
+  }
+  const BOOL right = edge == HeliumDualPaneSideRight;
+  const CGFloat fromEdge =
+      right ? NSMaxX(host) - point.x : point.x - NSMinX(host);
+  NSWindow* rail = [self railRevealWindow];
+  const CGFloat railReach =
+      !rail ? 0
+            : (right ? NSMaxX(host) - NSMinX(rail.frame)
+                     : NSMaxX(rail.frame) - NSMinX(host));
+  const CGFloat edgeInset = [self edgeInset];
+  // A drag (a scroll bar, a text selection) passing the edge reveals nothing.
+  const BOOL inTrigger =
+      !(NSEvent.pressedMouseButtons & 1) &&
+      fromEdge < (edgeInset > 0 ? edgeInset : kRailRevealFullscreenTrigger);
+  const BOOL overRail =
+      _railRevealed && fromEdge < railReach + kRailRevealLeeway;
+  if (RailTraceEnabled()) {
+    NSLog(@"DualRail pointer fromEdge=%.1f trigger=%d over=%d revealed=%d "
+          @"pressed=%lu active=%d key=%@",
+          fromEdge, inTrigger, overRail, _railRevealed,
+          (unsigned long)NSEvent.pressedMouseButtons, NSApp.active,
+          NSApp.keyWindow.title);
+  }
+  if (inTrigger || overRail) {
+    [self cancelRailHide];
+    [self setRailRevealed:YES];
+  } else if (_railRevealed) {
+    [self scheduleRailHide:kRailHoverExitGrace];
+  }
+}
+
+- (void)scheduleRailHide:(NSTimeInterval)delay {
+  if (_railHideTimer) {
+    // Keep an earlier deadline; only bring a later one forward.
+    if (_railHideTimer.fireDate.timeIntervalSinceNow <= delay) return;
+    [_railHideTimer invalidate];
+  }
+  __weak HeliumDualWindowHost* weakSelf = self;
+  _railHideTimer = [NSTimer
+      scheduledTimerWithTimeInterval:delay
+                             repeats:NO
+                               block:^(NSTimer* timer) {
+    HeliumDualWindowHost* host = weakSelf;
+    if (!host) return;
+    host->_railHideTimer = nil;
+    // Never fade a rail under a press, e.g. while one of its tabs is dragged.
+    if (NSEvent.pressedMouseButtons & 1) {
+      [host scheduleRailHide:kRailHoverExitGrace];
+      return;
+    }
+    [host setRailRevealed:NO];
+  }];
+}
+
+- (void)cancelRailHide {
+  [_railHideTimer invalidate];
+  _railHideTimer = nil;
+}
+
+- (void)setRailRevealed:(BOOL)revealed {
+  if (_railRevealed == revealed) return;
+  if (RailTraceEnabled()) NSLog(@"DualRail revealed=%d", revealed);
+  _railRevealed = revealed;
+  if (revealed) {
+    // Keep reading the pointer while shown (see -pointerMoved).
+    [self setPointerPolling:YES];
+    // Above the pane it overlaps, which may have been attached or ordered
+    // front after it.
+    if (_window.visible && !_window.miniaturized) {
+      [self bringChildToFront:[self railRevealWindow]];
+    }
+  } else {
+    [self cancelRailHide];
+  }
+  [self applyRailVisibilityAnimated:YES];
+}
+
+// Helium's floating side chrome geometry in host content coordinates.
+- (NSRect)floatingRailRect:(NSRect)area width:(CGFloat)width right:(BOOL)right {
+  const CGFloat inset = kFloatingRailInset;
+  const CGFloat top = _railStyle.floatingTop;
+  const CGFloat bottom = _railStyle.floatingBottom;
+  return NSMakeRect(right ? NSMaxX(area) - inset - width : NSMinX(area) + inset,
+                    NSMinY(area) + bottom, width,
+                    std::max<CGFloat>(0, NSHeight(area) - top - bottom));
+}
+
+// Child windows stack in the order they were added, and -orderWindow:
+// relativeTo: does not reorder siblings. Re-adding one raises it.
+- (void)bringChildToFront:(NSWindow*)child {
+  if (!child || child.parentWindow != _window) return;
+  [_window removeChildWindow:child];
+  [_window addChildWindow:child ordered:NSWindowAbove];
+}
+
+// The launch panel slides in from the window edge like Helium's strip.
+- (void)applyRailPanelVisible:(BOOL)show animated:(BOOL)animated {
+  if (!_railPanel) return;
+  const BOOL changed = show != _railPanelShown;
+  _railPanelShown = show;
+  if (show) _railOverlay.alphaValue = 1;
+  if (!changed || !animated) {
+    // Geometry changes during a slide are applied when it ends.
+    if (!changed && _railPanelAnimating) return;
+    _railPanelAnimating = NO;
+    _railPanel.frame = show ? _railPanelShownFrame : _railPanelHiddenFrame;
+    if (!show) _railOverlay.alphaValue = 0;
+    return;
+  }
+  if (_railPanelAnimating) {
+    // Reverse from where the panel is now, not from the last target.
+    if (CALayer* presentation = _railPanel.layer.presentationLayer) {
+      _railPanel.frame = presentation.frame;
+    }
+  }
+  _railPanelAnimating = YES;
+  __weak HeliumDualWindowHost* weakSelf = self;
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = kRailRevealDuration;
+    // Helium's FAST_OUT_SLOW_IN_3.
+    context.timingFunction =
+        [CAMediaTimingFunction functionWithControlPoints:0.2f :0.f :0.f :1.f];
+    self->_railPanel.animator.frame =
+        show ? self->_railPanelShownFrame : self->_railPanelHiddenFrame;
+  }
+      completionHandler:^{
+        HeliumDualWindowHost* host = weakSelf;
+        if (!host || host->_railPanelShown != show) return;
+        host->_railPanelAnimating = NO;
+        host->_railPanel.frame =
+            show ? host->_railPanelShownFrame : host->_railPanelHiddenFrame;
+        if (!show) host->_railOverlay.alphaValue = 0;
+      }];
+}
+
+- (void)applyRailVisibilityAnimated:(BOOL)animated {
+  NSWindow* rail = [self railRevealWindow];
+  // Everything except a hidden Zen rail is fully shown and interactive.
+  NSWindow* panes[] = {_leftWindow, _rightWindow};
+  for (NSWindow* pane : panes) {
+    if (!pane || pane == rail) continue;
+    if (pane.alphaValue != 1) pane.alphaValue = 1;
+    SetPaneInteractive(pane, YES);
+  }
+  if (_railOverlay && _railOverlay != rail) {
+    _railPanelAnimating = NO;
+    [self applyRailPanelVisible:NO animated:NO];
+    SetPaneInteractive(_railOverlay, NO);
+  }
+  if (!rail) return;
+  const BOOL show = _railRevealed;
+  SetPaneInteractive(rail, show);
+  if (rail == _railOverlay) {
+    [self applyRailPanelVisible:show animated:animated];
+    return;
+  }
+  const CGFloat alpha = show ? 1 : 0;
+  if (rail.alphaValue == alpha && !animated) return;
+  // Also supersedes a fade still in flight.
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = animated ? kRailRevealDuration : 0;
+    rail.animator.alphaValue = alpha;
+  }];
+}
+
+- (void)toggleFullscreen {
+  [self requestFullscreen:!self.fullscreen];
+}
+
+- (BOOL)isFullscreen {
+  return _fullscreenTransition
+             ? _fullscreenTarget
+             : (_window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+}
+
+- (BOOL)fullscreenTransition {
+  return _fullscreenTransition;
+}
+
+- (void)requestFullscreen:(BOOL)fullscreen {
+  if (_closing) {
+    return;
+  }
+  if (_fullscreenTransition) {
+    _hasPendingFullscreenRequest = YES;
+    _pendingFullscreenRequest = fullscreen;
+    return;
+  }
+  _hasPendingFullscreenRequest = NO;
+  if (self.fullscreen != fullscreen) {
+    _fullscreenTransition = YES;
+    _fullscreenTarget = fullscreen;
+    [_window toggleFullScreen:nil];
+  }
+}
+
+- (void)closeAfterBrowserShutdown {
+  NSAssert(!_leftWindow && !_rightWindow,
+           @"Detach both browsers after normal shutdown before closing host");
+  [self abandonStagedResize];
+  _closing = YES;
+  [self updatePointerMonitor];
+  if (_railOverlay) {
+    [_window removeChildWindow:_railOverlay];
+    [_railOverlay orderOut:nil];
+  }
+  [_window close];
+}
+
+- (BOOL)windowShouldClose:(NSWindow*)sender {
+  if (_closing) {
+    return YES;
+  }
+  [self.delegate heliumDualWindowHostDidRequestClose:self];
+  return NO;
+}
+
+- (void)captureNormalFrameIfNeeded {
+  if (!_fullscreenTransition && !_window.miniaturized &&
+      (_window.styleMask & NSWindowStyleMaskFullScreen) == 0) {
+    _normalFrame = _window.frame;
+  }
+}
+
+- (void)windowDidResize:(NSNotification*)notification {
+  [self captureNormalFrameIfNeeded];
+  [self relayout];
+  if ([self.delegate
+          respondsToSelector:@selector(heliumDualWindowHostDidChangeFrame:)]) {
+    [self.delegate heliumDualWindowHostDidChangeFrame:self];
+  }
+}
+- (void)windowDidMove:(NSNotification*)notification {
+  [self captureNormalFrameIfNeeded];
+  [self relayout];
+  if ([self.delegate
+          respondsToSelector:@selector(heliumDualWindowHostDidChangeFrame:)]) {
+    [self.delegate heliumDualWindowHostDidChangeFrame:self];
+  }
+}
+- (void)windowDidChangeScreen:(NSNotification*)notification {
+  [self relayout];
+}
+- (void)windowDidBecomeKey:(NSNotification*)notification {
+  // The outer shell has no browser command dispatcher. Window-menu and
+  // titlebar activation must restore focus to this host's last active pane.
+  if (!_closing && !_fullscreenTransition) {
+    [self restoreLastActivePane];
+  }
+}
+
+- (void)windowDidDeminiaturize:(NSNotification*)notification {
+  [self relayout];
+  [self restoreLastActivePane];
+}
+- (void)windowWillEnterFullScreen:(NSNotification*)notification {
+  _normalFrame = _window.frame;
+  [self beginFullscreenTransition:YES];
+}
+- (void)windowWillExitFullScreen:(NSNotification*)notification {
+  [self beginFullscreenTransition:NO];
+}
+
+- (void)beginFullscreenTransition:(BOOL)fullscreen {
+  _fullscreenTransition = YES;
+  _fullscreenTarget = fullscreen;
+  if ([self.delegate
+          respondsToSelector:@selector(
+                                 heliumDualWindowHost:willChangeFullscreen:)]) {
+    [self.delegate heliumDualWindowHost:self willChangeFullscreen:fullscreen];
+  }
+}
+
+- (void)completeFullscreenTransition:(BOOL)fullscreen {
+  // A failed native transition must restore the UI and complete the browser
+  // controllers too, just like NativeWidgetMacNSWindowHost does.
+  if (_fullscreenTarget != fullscreen &&
+      [self.delegate
+          respondsToSelector:@selector(
+                                 heliumDualWindowHost:willChangeFullscreen:)]) {
+    _fullscreenTarget = fullscreen;
+    [self.delegate heliumDualWindowHost:self willChangeFullscreen:fullscreen];
+  }
+  _fullscreenTransition = NO;
+  _fullscreenTarget = fullscreen;
+  [self captureNormalFrameIfNeeded];
+  [self relayout];
+  [self restoreLastActivePane];
+  if ([self.delegate
+          respondsToSelector:@selector(
+                                 heliumDualWindowHost:didChangeFullscreen:)]) {
+    [self.delegate heliumDualWindowHost:self didChangeFullscreen:fullscreen];
+  }
+  if (_hasPendingFullscreenRequest) {
+    __weak HeliumDualWindowHost* weakSelf = self;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      HeliumDualWindowHost* host = weakSelf;
+      if (host && host->_hasPendingFullscreenRequest) {
+        const BOOL pending = host->_pendingFullscreenRequest;
+        host->_hasPendingFullscreenRequest = NO;
+        [host requestFullscreen:pending];
+      }
+    });
+  }
+}
+
+- (void)windowDidEnterFullScreen:(NSNotification*)notification {
+  [self completeFullscreenTransition:YES];
+}
+- (void)windowDidExitFullScreen:(NSNotification*)notification {
+  [self completeFullscreenTransition:NO];
+}
+
+- (void)windowDidFailToEnterFullScreen:(NSWindow*)window {
+  [self completeFullscreenTransition:NO];
+}
+
+- (void)windowDidFailToExitFullScreen:(NSWindow*)window {
+  [self completeFullscreenTransition:YES];
+}
+@end
