+                                       action:@selector(requestRightPane:)];
+  _launchButton.bezelStyle = NSBezelStyleRegularSquare;
+  _launchButton.bordered = NO;
+  _launchButton.toolTip = LaunchLabel(YES);
+  _launchButton.accessibilityLabel = LaunchLabel(YES);
+  [_window.contentView addSubview:_launchButton];
+  _leftLaunchButton =
+      [HeliumDualLaunchButton buttonWithTitle:@""
+                                       target:self
+                                       action:@selector(requestLeftPane:)];
+  _leftLaunchButton.bezelStyle = NSBezelStyleRegularSquare;
+  _leftLaunchButton.bordered = NO;
+  _leftLaunchButton.toolTip = LaunchLabel(NO);
+  _leftLaunchButton.accessibilityLabel = LaunchLabel(NO);
+  [_window.contentView addSubview:_leftLaunchButton];
+
+  __weak HeliumDualWindowHost* weakSelf = self;
+  background.pointerHandler = ^{
+    [weakSelf pointerMoved];
+  };
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  [_notificationTokens
+      addObject:[center addObserverForName:NSWindowDidBecomeKeyNotification
+                                    object:nil
+                                     queue:nil
+                                usingBlock:^(NSNotification* notification) {
+                                  HeliumDualWindowHost* host = weakSelf;
+                                  if (!host) {
+                                    return;
+                                  }
+                                  NSWindow* pane = notification.object;
+                                  if (pane == host->_leftWindow ||
+                                      pane == host->_rightWindow) {
+                                    host->_activePane =
+                                        pane == host->_rightWindow
+                                            ? HeliumDualPaneSideRight
+                                            : HeliumDualPaneSideLeft;
+                                    id<HeliumDualWindowHostDelegate> delegate =
+                                        host.delegate;
+                                    if ([delegate
+                                            respondsToSelector:
+                                                @selector(heliumDualWindowHost:
+                                                          didActivatePane:)]) {
+                                      [delegate
+                                          heliumDualWindowHost:host
+                                               didActivatePane:host->
+                                                               _activePane];
+                                    }
+                                  }
+                                }]];
+  [_notificationTokens
+      addObject:[center addObserverForName:NSWindowWillCloseNotification
+                                    object:nil
+                                     queue:nil
+                                usingBlock:^(NSNotification* notification) {
+                                  HeliumDualWindowHost* host = weakSelf;
+                                  if (!host || host->_closing) {
+                                    return;
+                                  }
+                                  NSWindow* pane = notification.object;
+                                  if (pane == host->_leftWindow ||
+                                      pane == host->_rightWindow) {
+                                    [host detachBrowserWindow:pane];
+                                  }
+                                }]];
+  // AppKit or Chromium can complete a pane move after a host layout. Only
+  // reconcile a real frame mismatch, so our own resize notifications cannot
+  // start a layout loop.
+  for (NSNotificationName name in @[NSWindowDidResizeNotification,
+                                     NSWindowDidMoveNotification]) {
+    [_notificationTokens addObject:
+        [center addObserverForName:name object:nil queue:nil
+                        usingBlock:^(NSNotification* notification) {
+      HeliumDualWindowHost* host = weakSelf;
+      if (!host || host->_closing || host->_layingOut) return;
+      NSWindow* pane = notification.object;
+      if (pane == host->_leftWindow || pane == host->_rightWindow) {
+        NSUInteger side = pane == host->_leftWindow ? 0 : 1;
+        if (!NSEqualRects(pane.frame, host->_expectedPaneFrames[side]))
+          [host scheduleRelayout];
+      }
+    }]];
+  }
+  // Panes are not movable on their own. A press on a pane's draggable
+  // background (which its content view does not claim) moves the host, and a
+  // double-click there follows the system titlebar double-click setting.
+  _paneDragMonitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:NSEventMaskLeftMouseDown |
+                                           NSEventMaskRightMouseDown |
+                                           NSEventMaskOtherMouseDown
+                                   handler:^NSEvent*(NSEvent* event) {
+    HeliumDualWindowHost* host = weakSelf;
+    NSWindow* pane = event.window;
+    if (!host || host->_closing ||
+        (pane != host->_leftWindow && pane != host->_rightWindow)) {
+      return event;
+    }
+    // A pane with staged frames already lays out for them while it still
+    // shows its present contents; a press now would land on what is not
+    // there yet.
+    if (host->_staging) {
+      return nil;
+    }
+    if (event.type != NSEventTypeLeftMouseDown) {
+      return event;
+    }
+    NSView* content = pane.contentView;
+    const NSPoint point =
+        [content.superview convertPoint:event.locationInWindow fromView:nil];
+    if ([content hitTest:point]) {
+      return event;
+    }
+    if (event.clickCount == 2) {
+      PerformTitlebarDoubleClick(host->_window);
+      return nil;
+    }
+    [host->_window performWindowDragWithEvent:event];
+    return nil;
+  }];
+  [self applyRailStyle:_railStyle];
+  [self relayout];
+  return self;
+}
+
+- (void)dealloc {
+  if (_paneDragMonitor) {
+    [NSEvent removeMonitor:_paneDragMonitor];
+  }
+  if (_pointerMonitor) {
+    [NSEvent removeMonitor:_pointerMonitor];
+  }
+  [_railHideTimer invalidate];
+  [_railPollTimer invalidate];
+  [_dividerGhostTimer invalidate];
+  if (_dividerGhost) {
+    [_dividerGhost.parentWindow removeChildWindow:_dividerGhost];
+    [_dividerGhost orderOut:nil];
+  }
+  for (id token in _notificationTokens) {
+    [NSNotificationCenter.defaultCenter removeObserver:token];
+  }
+  _window.delegate = nil;
+  _divider.host = nil;
+  _launchButton.target = nil;
+  _leftLaunchButton.target = nil;
+  _overlayLaunchButton.target = nil;
+  if (_railOverlay) {
+    [_window removeChildWindow:_railOverlay];
+    [_railOverlay orderOut:nil];
+  }
+  // Never close browser windows here: their BrowserWidgets own their teardown.
+  if (_leftWindow.parentWindow == _window) {
+    [_window removeChildWindow:_leftWindow];
+  }
+  if (_rightWindow.parentWindow == _window) {
+    [_window removeChildWindow:_rightWindow];
+  }
+  [_window orderOut:nil];
+}
+
+- (NSWindow*)window {
+  return _window;
+}
+- (NSRect)normalFrame {
+  return _normalFrame;
+}
+- (double)splitRatio {
+  return _splitRatio;
+}
+- (CGFloat)minimumContentWidth {
+  return 2 * kResizeEdgeInset +
+         ((_leftWindow && _rightWindow)
+              ? 2 * kHeliumDualMinimumPaneWidth + kDividerWidth
+              : kHeliumDualMinimumPaneWidth + _railStyle.width);
+}
+- (CGFloat)edgeInset {
+  // Fullscreen has nothing to resize; panes reach the screen edges there.
+  return (_window.styleMask & NSWindowStyleMaskFullScreen) ? 0
+                                                           : kResizeEdgeInset;
+}
+- (BOOL)hasRightPane {
+  return _rightWindow != nil;
+}
+- (HeliumDualPaneSide)activePane {
+  return _activePane;
+}
+- (void)setSplitRatio:(double)ratio {
+  if (!std::isfinite(ratio)) {
+    return;
+  }
+  const double clamped =
+      std::clamp(ratio, helium_dual::kMinRatio, helium_dual::kMaxRatio);
+  _desiredRatio = clamped;
+  [self abandonStagedResize];
+  // A reentrant setter still needs relayout to mark _layoutPending.
+  if (clamped == _splitRatio && !_layingOut) return;
+  _splitRatio = clamped;
+  [self relayout];
+  [self notifySplitRatioChanged];
+}
+
+- (void)notifySplitRatioChanged {
+  if ([self.delegate
+          respondsToSelector:@selector(
+                                 heliumDualWindowHost:didChangeSplitRatio:)]) {
+    [self.delegate heliumDualWindowHost:self didChangeSplitRatio:_splitRatio];
+  }
+}
+
+- (NSWindow*)browserWindowForSide:(HeliumDualPaneSide)side {
+  return side == HeliumDualPaneSideRight ? _rightWindow : _leftWindow;
+}
+
+- (void)attachBrowserWindow:(NSWindow*)pane side:(HeliumDualPaneSide)side {
+  NSAssert(NSThread.isMainThread, @"Window operations require the main thread");
+  NSAssert(pane != _window, @"A host cannot be its own pane");
+  NSWindow* previous = [self browserWindowForSide:side];
+  NSAssert(!previous || previous == pane, @"Detach the old pane first");
+  if (previous == pane) {
+    return;
+  }
+  if (side == HeliumDualPaneSideRight) {
+    _rightWindow = pane;
+  } else {
+    _leftWindow = pane;
+  }
+  if (pane.parentWindow) {
+    [pane.parentWindow removeChildWindow:pane];
+  }
+  // Keep the native browser window object and delegate. In production this
+  // style is also selected before window construction so layout is consistent.
+  pane.styleMask = NSWindowStyleMaskBorderless;
+  pane.hasShadow = NO;
+  pane.movable = NO;
+  pane.movableByWindowBackground = NO;
+  pane.tabbingMode = NSWindowTabbingModeDisallowed;
+  pane.collectionBehavior = NSWindowCollectionBehaviorTransient |
+                            NSWindowCollectionBehaviorIgnoresCycle |
+                            NSWindowCollectionBehaviorFullScreenAuxiliary;
+  pane.excludedFromWindowsMenu = YES;
+  [_window addChildWindow:pane ordered:NSWindowAbove];
+
+  const CGFloat minimumWidth = [self minimumContentWidth];
+  _window.contentMinSize = NSMakeSize(minimumWidth, kHeliumDualMinimumPaneHeight);
+  NSSize size = _window.contentView.bounds.size;
+  if (size.width < minimumWidth && !_window.miniaturized) {
+    [_window setContentSize:NSMakeSize(minimumWidth, size.height)];
+  }
+  [self relayout];
+  if (_window.visible && !_window.miniaturized) {
+    [pane orderFront:nil];
+  }
+}
+
+- (void)detachBrowserWindow:(NSWindow*)pane {
+  NSAssert(NSThread.isMainThread, @"Window operations require the main thread");
+  const BOOL wasRight = pane == _rightWindow;
+  if (!wasRight && pane != _leftWindow) {
+    return;
+  }
+  if (pane.parentWindow == _window) {
+    [_window removeChildWindow:pane];
+  }
+  // A pane leaving while its Zen rail was hidden must not stay invisible.
+  pane.alphaValue = 1;
+  SetPaneInteractive(pane, YES);
+  _windowControlsAlpha[wasRight ? 1 : 0] = 1;
+  _paneHidden[0] = _paneHidden[1] = NO;
+  if (wasRight) {
+    _rightWindow = nil;
+    _activePane = HeliumDualPaneSideLeft;
+  } else {
+    _leftWindow = nil;
+    _activePane = HeliumDualPaneSideRight;
+  }
+  _window.contentMinSize =
+      NSMakeSize([self minimumContentWidth], kHeliumDualMinimumPaneHeight);
+  [self relayout];
+}
+
+- (void)showAndActivate:(BOOL)activate {
+  if (_closing) {
+    return;
+  }
+  if (_window.miniaturized) {
+    [_window deminiaturize:nil];
+  }
+  [self relayout];
+  if (activate) {
+    [_window makeKeyAndOrderFront:nil];
+    [self restoreLastActivePane];
+  } else {
+    [_window orderFront:nil];
+  }
+  [_leftWindow orderFront:nil];
+  [_rightWindow orderFront:nil];
+}
+
+- (void)activatePane:(HeliumDualPaneSide)side {
+  NSWindow* pane = [self browserWindowForSide:side];
+  if (!pane || _closing || _window.miniaturized) {
+    return;
+  }
+  _activePane = side;
+  [pane makeKeyAndOrderFront:nil];
+}
+
+- (void)restoreLastActivePane {
+  NSWindow* pane = [self browserWindowForSide:_activePane];
+  if (!pane) {
+    _activePane =
+        _leftWindow ? HeliumDualPaneSideLeft : HeliumDualPaneSideRight;
+  }
+  [self activatePane:_activePane];
+}
+
+- (void)applyRailStyle:(HeliumDualRailStyle*)style {
+  NSAssert(style.width > 0 && style.buttonHeight > 0,
+           @"Rail metrics must be positive");
+  const BOOL metricsChanged =
+      _railStyle.width != style.width ||
+      _railStyle.buttonHeight != style.buttonHeight ||
+      _railStyle.horizontalPadding != style.horizontalPadding ||
+      _railStyle.buttonTop != style.buttonTop ||
+      _railStyle.paneEdgeInset != style.paneEdgeInset ||
+      _railStyle.floatingTop != style.floatingTop ||
+      _railStyle.floatingBottom != style.floatingBottom ||
+      _railStyle.floatingCornerRadius != style.floatingCornerRadius ||
+      _railStyle.floatingWidth != style.floatingWidth ||
+      _railStyle.floatingRowTop != style.floatingRowTop;
+  _railStyle = style;
+  HeliumDualBackgroundView* background =
+      (HeliumDualBackgroundView*)_window.contentView;
+  background.railStyle = style;
+  background.needsDisplay = YES;
+  _window.backgroundColor = style.backgroundColor;
+  _divider.fillColor = style.separatorColor;
+  _divider.needsDisplay = YES;
+  for (HeliumDualLaunchButton* button in
+       @[ _launchButton, _leftLaunchButton ]) {
+    button.railStyle = style;
+    button.needsDisplay = YES;
+  }
+  _overlayLaunchButton.railStyle = style;
+  _overlayLaunchButton.needsDisplay = YES;
+  _railPanel.railStyle = style;
+  _railPanel.needsDisplay = YES;
+  _window.contentMinSize =
+      NSMakeSize([self minimumContentWidth], kHeliumDualMinimumPaneHeight);
+  // Palette/background updates must not feed native bounds notifications back
+  // into another layout; only changed geometry needs to move the panes.
+  if (metricsChanged) {
+    [self relayout];
+  }
+}
+
+- (void)setHiddenRailWidth:(CGFloat)width side:(HeliumDualPaneSide)side {
+  _hiddenRailWidth[side] = std::max<CGFloat>(kDefaultLaunchRailWidth, width);
+}
+- (BOOL)isPaneHidden:(HeliumDualPaneSide)side {
+  return _paneHidden[side];
+}
+- (void)setPaneHidden:(BOOL)hidden side:(HeliumDualPaneSide)side {
+  if (hidden && (!_leftWindow || !_rightWindow)) {
+    return;
+  }
+  if (hidden && _paneHidden[1 - side]) {
+    // Never both: hiding the pane that shows brings the other one back, in
+    // the same layout. A Zen mode rail revealed at the other edge has gone.
+    _paneHidden[1 - side] = NO;
+    [self cancelRailHide];
+    _railRevealed = NO;
+  }
+  _paneHidden[side] = hidden;
+  [self relayout];
+  if (hidden) {
+    [self activatePane:side == HeliumDualPaneSideLeft
+                           ? HeliumDualPaneSideRight : HeliumDualPaneSideLeft];
+  }
+}
+
+- (void)scheduleRelayout {
+  if (_relayoutScheduled || _closing) return;
+  _relayoutScheduled = YES;
+  __weak HeliumDualWindowHost* weakSelf = self;
+  CFRunLoopPerformBlock(CFRunLoopGetMain(), kCFRunLoopCommonModes, ^{
+    HeliumDualWindowHost* host = weakSelf;
+    if (!host) return;
+    host->_relayoutScheduled = NO;
+    [host relayout];
+  });
+  CFRunLoopWakeUp(CFRunLoopGetMain());
+}
+
+- (void)relayout {
+  if (_closing) return;
+  if (_layingOut) {
+    // SetBounds can pump native events. Keep a newer ratio/size request.
+    _layoutPending = YES;
+    return;
+  }
+  // Whatever asked for this layout changed what staged frames were for. Lay
+  // out directly, at the ratio the gesture had reached.
+  if (_staging || _desiredRatio != _splitRatio) {
+    [self abandonStagedResize];
+    _splitRatio = _desiredRatio;
+    [self notifySplitRatioChanged];
+  }
+  _layingOut = YES;
+  _layoutPending = NO;
+  const NSRect content = _window.contentView.bounds;
+  const CGFloat edge = [self edgeInset];
+  const NSRect area = [self paneAreaForEdge:edge];
+  const BOOL bothPanes = _leftWindow && _rightWindow;
+  HeliumDualPaneSide railEdge = HeliumDualPaneSideRight;
+  const BOOL autoHideRail = [self hideableRailEdge:&railEdge];
+  if (!autoHideRail) {
+    [self cancelRailHide];
+    _railRevealed = NO;
+  }
+  // A lone pane extends under the host rail by its extra edge padding so the
+  // strips on both sides of its content look equally wide.
+  const CGFloat hostRailWidth = std::max<CGFloat>(
+      0, _railStyle.width - std::clamp<CGFloat>(_railStyle.paneEdgeInset, 0,
+                                                _railStyle.width / 2));
+  NSRect leftRect = NSZeroRect;
+  NSRect rightRect = NSZeroRect;
+  BOOL showDivider = NO;
+  if (bothPanes && !_paneHidden[0] && !_paneHidden[1]) {
+    [self twoPaneRectsInArea:area
+                       ratio:_splitRatio
+                        left:&leftRect
+                       right:&rightRect];
+    showDivider = YES;
+  } else if (bothPanes) {
+    // One pane collapsed to its tab strip at its outer edge. With Zen mode
+    // rails, the strip overlaps its sibling, which keeps the whole width.
+    const size_t hidden = _paneHidden[0] ? 0 : 1;
+    const CGFloat railWidth =
+        std::min(_hiddenRailWidth[hidden], NSWidth(area) / 2);
+    const NSRect railRect =
+        autoHideRail ? [self floatingRailRect:area
+                                        width:railWidth
+                                        right:hidden == 1]
+                     : NSMakeRect(hidden == 0 ? NSMinX(area)
+                                              : NSMaxX(area) - railWidth,
+                                  NSMinY(area), railWidth, NSHeight(area));
+    NSRect paneRect = area;
+    if (!autoHideRail) {
+      paneRect.size.width -= railWidth;
+      if (hidden == 0) paneRect.origin.x += railWidth;
+    }
+    leftRect = hidden == 0 ? railRect : paneRect;
+    rightRect = hidden == 0 ? paneRect : railRect;
+  } else if (_leftWindow || _rightWindow) {
+    // A lone pane, with the launch rail for the other side beyond it.
+    const CGFloat rail = autoHideRail ? edge : hostRailWidth + edge;
+    const NSRect paneRect = NSMakeRect(
+        _leftWindow ? edge : rail, NSMinY(area),
+        std::max<CGFloat>(0, NSWidth(content) - rail - edge), NSHeight(area));
+    leftRect = _leftWindow ? paneRect : NSZeroRect;
+    rightRect = _rightWindow ? paneRect : NSZeroRect;
+  }
+  _divider.hidden = !showDivider;
+  _divider.frame = NSMakeRect(NSMaxX(leftRect), NSMinY(area), kDividerWidth,
+                              NSHeight(area));
+  // Launch buttons mirror the pane tab strips' own button insets.
+  const CGFloat buttonY =
+      content.size.height - _railStyle.buttonTop - _railStyle.buttonHeight;
+  const CGFloat buttonWidth =
+      _railStyle.width - 2 * _railStyle.horizontalPadding;
+  _launchButton.hidden = _rightWindow != nil || autoHideRail;
+  _launchButton.frame = NSMakeRect(
+      NSWidth(content) - edge - _railStyle.width + _railStyle.horizontalPadding,
+      buttonY, buttonWidth, _railStyle.buttonHeight);
+  _leftLaunchButton.hidden = _leftWindow != nil || autoHideRail;
+  _leftLaunchButton.frame =
+      NSMakeRect(edge + _railStyle.horizontalPadding, buttonY, buttonWidth,
+                 _railStyle.buttonHeight);
+  // The overlay holding the launch rail above a lone pane in Zen mode.
+  if (autoHideRail && !bothPanes) {
+    if (!_railOverlay) {
+      _railOverlay = [[NSWindow alloc]
+          initWithContentRect:NSMakeRect(0, 0, 1, 1)
+                    styleMask:NSWindowStyleMaskBorderless
+                      backing:NSBackingStoreBuffered
+                        defer:NO];
+      _railOverlay.releasedWhenClosed = NO;
+      _railOverlay.opaque = NO;
+      _railOverlay.backgroundColor = NSColor.clearColor;
+      _railOverlay.hasShadow = NO;
+      _railOverlay.alphaValue = 0;
+      _railOverlay.ignoresMouseEvents = YES;
+      _railOverlay.excludedFromWindowsMenu = YES;
+      _railOverlay.collectionBehavior =
+          NSWindowCollectionBehaviorTransient |
+          NSWindowCollectionBehaviorIgnoresCycle |
+          NSWindowCollectionBehaviorFullScreenAuxiliary;
+      _railOverlayView =
+          [[HeliumDualRailOverlayView alloc] initWithFrame:NSZeroRect];
+      _railOverlayView.wantsLayer = YES;
+      _railOverlay.contentView = _railOverlayView;
+      _railPanel = [[HeliumDualRailPanelView alloc] initWithFrame:NSZeroRect];
+      _railPanel.railStyle = _railStyle;
+      _railPanel.wantsLayer = YES;
+      [_railOverlayView addSubview:_railPanel];
+      _overlayLaunchButton = [HeliumDualLaunchButton
+          buttonWithTitle:@""
+                   target:self
+                   action:@selector(requestMissingPane:)];
+      _overlayLaunchButton.bezelStyle = NSBezelStyleRegularSquare;
+      _overlayLaunchButton.bordered = NO;
+      _overlayLaunchButton.railStyle = _railStyle;
+      [_railPanel addSubview:_overlayLaunchButton];
+    }
+    if (_railOverlay.parentWindow != _window) {
+      [_window addChildWindow:_railOverlay ordered:NSWindowAbove];
+    }
+    const BOOL right = railEdge == HeliumDualPaneSideRight;
+    NSString* label = LaunchLabel(right);
+    _overlayLaunchButton.toolTip = label;
+    _overlayLaunchButton.accessibilityLabel = label;
+    // A floating panel as wide as the visible pane's strip when shown, inside
+    // the resize band like the panes, so the edge still resizes.
+    const CGFloat panelWidth = std::min<CGFloat>(
+        _railStyle.floatingWidth > 0 ? _railStyle.floatingWidth
+                                     : _railStyle.width,
+        NSWidth(area) / 2);
+    const NSRect panelRect =
+        [self floatingRailRect:area width:panelWidth right:right];
+    // The overlay also covers the gap to the window edge: the panel slides
+    // in from there, clipped by the overlay like Helium's strip by its pane.
+    const NSRect overlayRect =
+        right ? NSMakeRect(NSMinX(panelRect), NSMinY(panelRect),
+                           NSMaxX(area) - NSMinX(panelRect),
+                           NSHeight(panelRect))
+              : NSMakeRect(NSMinX(area), NSMinY(panelRect),
+                           NSMaxX(panelRect) - NSMinX(area),
+                           NSHeight(panelRect));
+    [_railOverlay setFrame:[_window convertRectToScreen:
+                               [_window.contentView convertRect:overlayRect
+                                                         toView:nil]]
+                   display:NO];
+    _railPanelShownFrame = NSMakeRect(NSMinX(panelRect) - NSMinX(overlayRect),
+                                      0, panelWidth, NSHeight(panelRect));
+    _railPanelHiddenFrame = NSOffsetRect(
+        _railPanelShownFrame,
+        right ? NSWidth(overlayRect) - NSMinX(_railPanelShownFrame)
+              : -NSMaxX(_railPanelShownFrame),
+        0);
+    const CGFloat panelButtonWidth = std::max<CGFloat>(
+        0, panelWidth - 2 * _railStyle.horizontalPadding);
+    _overlayLaunchButton.frame = NSMakeRect(
+        _railStyle.horizontalPadding,
+        NSHeight(panelRect) - _railStyle.floatingRowTop -
+            _railStyle.buttonHeight,
+        panelButtonWidth, _railStyle.buttonHeight);
+    _overlayLaunchButton.showsTitle = panelWidth >= kLaunchTitleMinWidth;
+  }
+  NSView* view = _window.contentView;
+  // Record both targets before resizing either window: the adapter can pump
+  // compositor work while it waits to present the two new sizes together.
+  _expectedPaneFrames[0] = [_window convertRectToScreen:
+      [view convertRect:leftRect toView:nil]];
+  _expectedPaneFrames[1] = [_window convertRectToScreen:
+      [view convertRect:rightRect toView:nil]];
+  // A pane that gains or loses the window controls must lay out its caption
+  // area at its new size, so settle the owner before resizing.
+  [self updateWindowControlsOwner];
+  if ([self.delegate respondsToSelector:
+          @selector(heliumDualWindowHost:setLeftPaneFrame:rightPaneFrame:)]) {
+    [self.delegate heliumDualWindowHost:self
+                      setLeftPaneFrame:_expectedPaneFrames[0]
+                        rightPaneFrame:_expectedPaneFrames[1]];
+  } else {
+    [_leftWindow setFrame:_expectedPaneFrames[0] display:YES];
+    [_rightWindow setFrame:_expectedPaneFrames[1] display:YES];
+  }
+  [_window invalidateCursorRectsForView:_divider];
+  [self updatePaneCorners];
+  [self updateWindowControls];
+  [self applyRailVisibilityAnimated:NO];
+  _layingOut = NO;
+  if (_layoutPending) [self scheduleRelayout];
+}
+
+// Panes leave the host's resize band uncovered on the sides and bottom. The
+// top stays flush: the pane toolbars replace the hidden titlebar.
+- (NSRect)paneAreaForEdge:(CGFloat)edge {
+  const NSRect content = _window.contentView.bounds;
+  return NSMakeRect(edge, edge,
+                    std::max<CGFloat>(0, NSWidth(content) - 2 * edge),
+                    std::max<CGFloat>(0, NSHeight(content) - edge));
+}
+
+// Both panes side by side with the divider between them.
+- (void)twoPaneRectsInArea:(NSRect)area
+                     ratio:(double)ratio
+                      left:(NSRect*)leftRect
+                     right:(NSRect*)rightRect {
+  const CGFloat available =
+      std::max<CGFloat>(0, NSWidth(area) - kDividerWidth);
+  const CGFloat minimum =
+      std::min<CGFloat>(kHeliumDualMinimumPaneWidth, available / 2);
+  const CGFloat leftWidth = std::clamp<CGFloat>(
+      std::round(available * ratio), minimum, available - minimum);
+  *leftRect =
+      NSMakeRect(NSMinX(area), NSMinY(area), leftWidth, NSHeight(area));
+  const CGFloat rightX = NSMaxX(*leftRect) + kDividerWidth;
+  *rightRect = NSMakeRect(rightX, NSMinY(area),
+                          std::max<CGFloat>(0, NSMaxX(area) - rightX),
+                          NSHeight(area));
+}
+
+- (NSWindow*)windowControlsPane {
+  return _windowControlsPane;
+}
+
+- (CGFloat)windowCornerRadius {
+  // AppKit's own radius for this window; it differs across macOS versions.
+  SEL selector = NSSelectorFromString(@"_cornerRadius");
+  if ([_window respondsToSelector:selector]) {
+    using Getter = CGFloat (*)(id, SEL);
+    const CGFloat radius = reinterpret_cast<Getter>(
+        [_window methodForSelector:selector])(_window, selector);
+    if (radius > 0 && radius < 64) return radius;
+  }
+  return 16;
+}
+
+// Panes are square borderless children. Clip the corners that meet the host's
+// rounded corners so the shared window keeps its shape.
+- (void)updatePaneCorners {
+  const BOOL fullscreen = (_window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+  const CGFloat radius = fullscreen ? 0 : [self windowCornerRadius];
+  const NSRect host = _window.frame;
+  // Panes stop at the resize band; a corner within it still meets the host's
+  // rounded corner. Matching the host radius keeps it inside that curve.
+  const CGFloat reach = [self edgeInset] + 1;
+  // A collapsed pane's Zen rail floats free of the window edges, rounded on
+  // every corner like Helium's floating strip.
+  NSWindow* floatingRail =
+      _leftWindow && _rightWindow ? [self railRevealWindow] : nil;
+  NSWindow* panes[] = {_leftWindow, _rightWindow};
+  for (size_t side = 0; side < 2; ++side) {
+    NSWindow* pane = panes[side];
+    if (!pane) continue;
+    const NSRect frame = _expectedPaneFrames[side];
+    const BOOL floating = pane == floatingRail;
+    const BOOL left =
+        floating || std::abs(NSMinX(frame) - NSMinX(host)) < reach;
+    const BOOL right =
+        floating || std::abs(NSMaxX(frame) - NSMaxX(host)) < reach;
+    const BOOL top = floating || std::abs(NSMaxY(frame) - NSMaxY(host)) < reach;
+    const BOOL bottom =
+        floating || std::abs(NSMinY(frame) - NSMinY(host)) < reach;
+    const CGFloat paneRadius =
+        floating ? _railStyle.floatingCornerRadius : radius;
+    NSView* view = pane.contentView;
+    view.wantsLayer = YES;
+    CALayer* layer = view.layer;
+    // CALayer corners follow the layer's own y direction.
+    const BOOL yDown = layer.geometryFlipped;
+    const CACornerMask topLeft = yDown ? kCALayerMinXMinYCorner : kCALayerMinXMaxYCorner;
+    const CACornerMask topRight = yDown ? kCALayerMaxXMinYCorner : kCALayerMaxXMaxYCorner;
+    const CACornerMask bottomLeft = yDown ? kCALayerMinXMaxYCorner : kCALayerMinXMinYCorner;
+    const CACornerMask bottomRight = yDown ? kCALayerMaxXMaxYCorner : kCALayerMaxXMinYCorner;
+    CACornerMask corners = 0;
+    if (top && left) corners |= topLeft;
+    if (top && right) corners |= topRight;
+    if (bottom && left) corners |= bottomLeft;
+    if (bottom && right) corners |= bottomRight;
+    const CGFloat applied = corners && paneRadius > 0 ? paneRadius : 0;
+    if (layer.cornerRadius != applied || layer.maskedCorners != corners) {
+      layer.cornerRadius = applied;
+      layer.maskedCorners = corners;
+      layer.masksToBounds = applied > 0;
+    }
+    if (applied > 0 && pane.opaque) {
+      pane.opaque = NO;
+      pane.backgroundColor = NSColor.clearColor;
+    }
+  }
+}
+
+- (void)windowControlClose:(id)sender {
+  [_window performClose:sender];
+}
+- (void)windowControlMiniaturize:(id)sender {
+  [_window miniaturize:sender];
+}
+- (void)windowControlZoom:(id)sender {
+  [self toggleFullscreen];
+}
+
+// The host titlebar is hidden under the panes. Show equivalent controls in the
+// left pane, or in the right pane when the left one is absent or collapsed to
+// its rail, at the offsets AppKit uses from the host's own top-left corner.
+- (void)updateWindowControlsOwner {
+  const BOOL fullscreen = (_window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+  const BOOL useLeft = _leftWindow && !(_rightWindow && _paneHidden[0]);
+  NSWindow* target = fullscreen ? nil : (useLeft ? _leftWindow : _rightWindow);
+  const NSWindowButton types[] = {NSWindowCloseButton,
+                                  NSWindowMiniaturizeButton,
+                                  NSWindowZoomButton};
+  for (NSWindowButton type : types) {
+    [_window standardWindowButton:type].hidden = target != nil;
+  }
+  if (target == _windowControlsPane) return;
+  for (NSButton* button in _paneWindowButtons) {
+    [button removeFromSuperview];
+  }
+  _paneWindowButtons = nil;
+  _windowControlsPane = target;
+  if (target) {
+    _paneWindowButtons = [NSMutableArray array];
+    const SEL actions[] = {@selector(windowControlClose:),
+                           @selector(windowControlMiniaturize:),
+                           @selector(windowControlZoom:)};
+    for (size_t i = 0; i < 3; ++i) {
+      NSButton* button = [NSWindow standardWindowButton:types[i]
+                                           forStyleMask:_window.styleMask];
+      button.target = self;
+      button.action = actions[i];
+      [target.contentView addSubview:button];
+      [_paneWindowButtons addObject:button];
+    }
+  }
+  if ([self.delegate respondsToSelector:@selector(
+                         heliumDualWindowHostDidChangeWindowControlsPane:)]) {
+    [self.delegate heliumDualWindowHostDidChangeWindowControlsPane:self];
+  }
+}
+
+// Places the controls in their pane at its new size.
+- (void)updateWindowControls {
+  NSWindow* target = _windowControlsPane;
+  if (!target) return;
+  const size_t side = target == _rightWindow ? 1 : 0;
+  const NSWindowButton types[] = {NSWindowCloseButton,
+                                  NSWindowMiniaturizeButton,
+                                  NSWindowZoomButton};
+  // Same offsets from the pane's top-left corner as the host's controls have
+  // from the host's.
+  const NSRect hostFrame = _window.frame;
+  const NSRect paneFrame = _expectedPaneFrames[side];
+  for (size_t i = 0; i < _paneWindowButtons.count; ++i) {
+    NSButton* reference = [_window standardWindowButton:types[i]];
+    if (!reference) continue;
+    const NSRect screen = [_window convertRectToScreen:
+        [reference convertRect:reference.bounds toView:nil]];
+    const NSPoint offset = NSMakePoint(NSMinX(screen) - NSMinX(hostFrame),
+                                       NSMaxY(hostFrame) - NSMaxY(screen));
+    const NSRect inPane = NSMakeRect(
+        offset.x, NSHeight(paneFrame) - offset.y - NSHeight(screen),
+        NSWidth(screen), NSHeight(screen));
+    NSView* container = target.contentView;
+    _paneWindowButtons[i].frame = container.isFlipped
+        ? NSMakeRect(NSMinX(inPane), offset.y, NSWidth(inPane), NSHeight(inPane))
+        : inPane;
+  }
+  [self applyWindowControlsAlpha];
+}
+
+- (void)applyWindowControlsAlpha {
+  const size_t side = _windowControlsPane == _rightWindow ? 1 : 0;
+  const CGFloat alpha = _windowControlsAlpha[side];
+  for (NSButton* button in _paneWindowButtons) {
+    if (button.alphaValue != alpha) button.alphaValue = alpha;
+    // Invisible controls must not take clicks meant for the page below.
+    const BOOL hidden = alpha < 0.01;
+    if (button.hidden != hidden) button.hidden = hidden;
+  }
+}
+
+- (void)setWindowControlsAlpha:(CGFloat)alpha forPane:(NSWindow*)pane {
+  if (!pane || (pane != _leftWindow && pane != _rightWindow) ||
+      !std::isfinite(alpha)) {
+    return;
+  }
+  _windowControlsAlpha[pane == _rightWindow ? 1 : 0] =
+      std::clamp<CGFloat>(alpha, 0, 1);
+  if (pane == _windowControlsPane) [self applyWindowControlsAlpha];
+}
+
+- (void)moveDividerToScreenX:(CGFloat)x {
+  NSRect screen =
+      [_window convertRectToScreen:[_window.contentView
+                                       convertRect:_window.contentView.bounds
+                                            toView:nil]];
+  // Same geometry as -relayout: panes start after the resize band.
+  const CGFloat edge = [self edgeInset];
+  CGFloat available = screen.size.width - 2 * edge - kDividerWidth;
+  if (available > 0) {
+    [self stageSplitRatio:(x - screen.origin.x - edge - kDividerWidth / 2) /
+                          available];
+  }
+}
+
+#pragma mark - Divider gestures
+
+// A divider gesture moves the ratio through staged frames: the panes draw for
+// their new widths first and take them together afterwards, so a page that
+// is slow to draw never leaves a blank band. Only one step is staged at a
+// time; the next one starts from wherever the gesture has got to by then.
+- (void)stageSplitRatio:(double)ratio {
+  if (!std::isfinite(ratio) || _closing) {
+    return;
+  }
+  _desiredRatio =
+      std::clamp(ratio, helium_dual::kMinRatio, helium_dual::kMaxRatio);
+  if (_staging) {
+    [self updateDividerGhost];
+    return;
+  }
+  [self stageDesiredRatio];
+}
+
+- (void)stageDesiredRatio {
+  if (_desiredRatio == _splitRatio) {
+    [self updateDividerGhost];
+    return;
+  }
+  id<HeliumDualWindowHostDelegate> delegate = self.delegate;
+  const BOOL canStage =
+      _leftWindow && _rightWindow && !_paneHidden[0] && !_paneHidden[1] &&
+      !_layingOut && !_fullscreenTransition && _window.visible &&
+      !_window.miniaturized &&
+      [delegate respondsToSelector:@selector(heliumDualWindowHost:
+                                               stageLeftPaneFrame:
+                                                   rightPaneFrame:)] &&
+      [delegate respondsToSelector:
+                    @selector(heliumDualWindowHostCommitStagedPaneFrames:)];
+  if (!canStage) {
+    self.splitRatio = _desiredRatio;
+    return;
+  }
+  NSRect leftRect = NSZeroRect;
+  NSRect rightRect = NSZeroRect;
+  [self twoPaneRectsInArea:[self paneAreaForEdge:[self edgeInset]]
+                     ratio:_desiredRatio
+                      left:&leftRect
+                     right:&rightRect];
+  NSView* view = _window.contentView;
+  const NSRect leftFrame =
+      [_window convertRectToScreen:[view convertRect:leftRect toView:nil]];
+  const NSRect rightFrame =
+      [_window convertRectToScreen:[view convertRect:rightRect toView:nil]];
+  if (NSEqualRects(leftFrame, _expectedPaneFrames[0]) &&
+      NSEqualRects(rightFrame, _expectedPaneFrames[1])) {
+    // The same whole points (or a size limit): only the ratio has moved.
+    _splitRatio = _desiredRatio;
+    [self notifySplitRatioChanged];
+    [self updateDividerGhost];
+    return;
+  }
+  _staging = YES;
+  _stagedRatio = _desiredRatio;
+  _stagedPaneFrames[0] = leftFrame;
+  _stagedPaneFrames[1] = rightFrame;
+  _stagedDividerFrame = NSMakeRect(NSMaxX(leftRect), NSMinY(leftRect),
+                                   kDividerWidth, NSHeight(leftRect));
+  if (![delegate heliumDualWindowHost:self
+                   stageLeftPaneFrame:leftFrame
+                       rightPaneFrame:rightFrame]) {
+    _staging = NO;
+    self.splitRatio = _desiredRatio;
+    return;
+  }
+  if (!_staging) {
+    // The delegate had everything ready and has committed already.
+    return;
+  }
+  if (!_dividerGhost.parentWindow && !_dividerGhostTimer) {
+    __weak HeliumDualWindowHost* weakSelf = self;
+    _dividerGhostTimer =
+        [NSTimer timerWithTimeInterval:kDividerGhostDelay
+                               repeats:NO
+                                 block:^(NSTimer* timer) {
+          HeliumDualWindowHost* host = weakSelf;
+          if (!host) return;
+          host->_dividerGhostTimer = nil;
+          if (host->_staging) [host setDividerGhostShown:YES];
+        }];
+    [NSRunLoop.mainRunLoop addTimer:_dividerGhostTimer
+                            forMode:NSRunLoopCommonModes];
+  }
+}
+
+- (void)stagedPaneFramesAreReady {
+  if (!_staging || _closing) {
+    return;
+  }
+  _staging = NO;
+  [_dividerGhostTimer invalidate];
+  _dividerGhostTimer = nil;
+  _layingOut = YES;
+  _splitRatio = _stagedRatio;
+  // Before the panes move: their move and resize notifications compare with
+  // these.
+  _expectedPaneFrames[0] = _stagedPaneFrames[0];
+  _expectedPaneFrames[1] = _stagedPaneFrames[1];
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  [self.delegate heliumDualWindowHostCommitStagedPaneFrames:self];
+  _divider.frame = _stagedDividerFrame;
+  [_window invalidateCursorRectsForView:_divider];
+  [self updatePaneCorners];
+  [self updateWindowControls];
+  [CATransaction commit];
+  _layingOut = NO;
+  [_divider dividerDidMove];
+  [self notifySplitRatioChanged];
+  if (_layoutPending) {
+    // Something asked for a layout during the commit; it takes the gesture's
+    // ratio along (see -relayout).
+    [self updateDividerGhost];
+    [self scheduleRelayout];
+    return;
+  }
+  [self stageDesiredRatio];
+}
+
+- (void)abandonStagedResize {
+  [_dividerGhostTimer invalidate];
+  _dividerGhostTimer = nil;
+  [self setDividerGhostShown:NO];
+  if (!_staging) {
+    return;
+  }
+  _staging = NO;
+  id<HeliumDualWindowHostDelegate> delegate = self.delegate;
+  if ([delegate respondsToSelector:
+                    @selector(heliumDualWindowHostCancelStagedPaneFrames:)]) {
+    [delegate heliumDualWindowHostCancelStagedPaneFrames:self];
+  }
+}
+
+- (void)dividerGestureEnded {
+  // Staged frames finish on their own. Otherwise run a layout so that the
+  // pane frames are known to agree with the ratio.
+  if (!_staging) {
+    [self scheduleRelayout];
+  }
+}
+
+// The bar that shows where the divider is going while the panes catch up.
+- (void)updateDividerGhost {
+  if (!_staging && _desiredRatio == _splitRatio) {
+    [self setDividerGhostShown:NO];
+    return;
+  }
+  if (_dividerGhost.parentWindow) {
+    [self placeDividerGhost];
+  }
+}
+
+- (void)placeDividerGhost {
+  NSRect leftRect = NSZeroRect;
+  NSRect rightRect = NSZeroRect;
+  [self twoPaneRectsInArea:[self paneAreaForEdge:[self edgeInset]]
+                     ratio:_desiredRatio
+                      left:&leftRect
+                     right:&rightRect];
+  const NSRect bar = NSMakeRect(NSMaxX(leftRect), NSMinY(leftRect),
+                                kDividerWidth, NSHeight(leftRect));
+  [_dividerGhost
+      setFrame:[_window convertRectToScreen:[_window.contentView
+                                                convertRect:bar
+                                                     toView:nil]]
+       display:YES];
+}
+
+- (void)setDividerGhostShown:(BOOL)shown {
+  if (!shown) {
+    if (_dividerGhost.parentWindow) {
+      [_dividerGhost.parentWindow removeChildWindow:_dividerGhost];
+      [_dividerGhost orderOut:nil];
+    }
+    return;
+  }
+  if (_dividerGhost.parentWindow || _closing || !_window.visible) {
+    return;
+  }
+  if (!_dividerGhost) {
+    _dividerGhost =
+        [[NSWindow alloc] initWithContentRect:NSMakeRect(0, 0, kDividerWidth, 1)
+                                    styleMask:NSWindowStyleMaskBorderless
+                                      backing:NSBackingStoreBuffered
+                                        defer:NO];
+    _dividerGhost.releasedWhenClosed = NO;
+    _dividerGhost.opaque = NO;
+    _dividerGhost.hasShadow = NO;
+    _dividerGhost.ignoresMouseEvents = YES;
+    _dividerGhost.excludedFromWindowsMenu = YES;
+    _dividerGhost.collectionBehavior =
+        NSWindowCollectionBehaviorTransient |
+        NSWindowCollectionBehaviorIgnoresCycle |
+        NSWindowCollectionBehaviorFullScreenAuxiliary;
+  }
+  _dividerGhost.backgroundColor =
+      [NSColor.controlAccentColor colorWithAlphaComponent:0.9];
+  [self placeDividerGhost];
+  // Added last, so above both panes (see -bringChildToFront:).
+  [_window addChildWindow:_dividerGhost ordered:NSWindowAbove];
+}
+
+- (void)requestRightPane:(id)sender {
+  if (!_rightWindow && !_closing) {
+    [self.delegate heliumDualWindowHost:self
+                         didRequestPane:HeliumDualPaneSideRight];
+  }
+}
