+// How a pane resize waits for new-size frames. Switchable for A/B comparison:
+//   --dual-resize-mode=locked   hold both browser roots, wait for renderers,
+//                               then for the browser frames (Dual 6.2 behavior)
+//   --dual-resize-mode=unlocked same waits, without holding the browser roots
+//   --dual-resize-mode=parallel wait only for the browser frames; viz holds
+//                               them until the renderer surfaces arrive
+//   --dual-resize-mode=none     no waiting (reference for maximum smoothness)
+//   --dual-resize-mode=async    while the divider is dragged, commit native
+//                               frames without waiting (content follows a
+//                               frame later); the release is fully synchronized
+//   --dual-resize-async-wait-ms=N  in async drags, still wait up to N ms for
+//                               the new-size frames (default 16)
+//   --dual-resize-deadline-ms=N bound on all waiting (default 50)
+//   --dual-resize-trace         log per-resize phase timings to stderr
+enum class ResizeMode { kLocked, kUnlocked, kParallel, kNone, kAsync };
+
+// Default: async drags that still wait up to 16 ms (one 60 Hz frame) for the
+// new-size frames. Measured on a heavy page this kept every step matched
+// while raising divider updates from ~21/s (locked) to ~29/s.
+struct ResizeConfig {
+  ResizeMode mode = ResizeMode::kAsync;
+  base::TimeDelta deadline = base::Milliseconds(50);
+  bool trace = false;
+  base::TimeDelta async_wait = base::Milliseconds(16);
+};
+
+const ResizeConfig& GetResizeConfig() {
+  static const ResizeConfig config = [] {
+    ResizeConfig c;
+    const auto* command_line = base::CommandLine::ForCurrentProcess();
+    const std::string mode =
+        command_line->GetSwitchValueASCII("dual-resize-mode");
+    if (mode == "locked") {
+      c.mode = ResizeMode::kLocked;
+    } else if (mode == "unlocked") {
+      c.mode = ResizeMode::kUnlocked;
+    } else if (mode == "parallel") {
+      c.mode = ResizeMode::kParallel;
+    } else if (mode == "none") {
+      c.mode = ResizeMode::kNone;
+    } else if (mode == "async") {
+      c.mode = ResizeMode::kAsync;
+    }
+    int ms = 0;
+    if (base::StringToInt(
+            command_line->GetSwitchValueASCII("dual-resize-deadline-ms"),
+            &ms) &&
+        ms >= 0 && ms <= 500) {
+      c.deadline = base::Milliseconds(ms);
+    }
+    c.trace = command_line->HasSwitch("dual-resize-trace");
+    if (base::StringToInt(
+            command_line->GetSwitchValueASCII("dual-resize-async-wait-ms"),
+            &ms) &&
+        ms >= 0 && ms <= 100) {
+      c.async_wait = base::Milliseconds(ms);
+    }
+    return c;
+  }();
+  return config;
+}
