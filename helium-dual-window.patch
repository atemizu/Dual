+TEST(HeliumDualAppMenuControlTest,
+     ServicesNotificationKeepsNativeTextAndClears) {
+  testing::NiceMock<MockWebUIToolbarControlDelegate> delegate;
+  WebUIAppMenuControl control(delegate);
+  toolbar_ui_api::mojom::AppMenuControlStatePtr published;
+  EXPECT_CALL(delegate, OnAppMenuControlStateChanged(testing::_))
+      .Times(2)
+      .WillRepeatedly([&](toolbar_ui_api::mojom::AppMenuControlStatePtr state) {
+        published = std::move(state);
+      });
+  EXPECT_CALL(delegate, OnPreferredSizeChanged()).Times(2);
+
+  control.SetTypeAndSeverity(
+      {AppMenuIconController::IconType::kHeliumServicesUpdate,
+       AppMenuIconController::Severity::kLow});
+  ASSERT_TRUE(published);
+  EXPECT_EQ(toolbar_ui_api::mojom::AppMenuIconType::kUpgradeNotification,
+            published->icon_type);
+  EXPECT_EQ(toolbar_ui_api::mojom::AppMenuSeverity::kLow, published->severity);
+  ASSERT_TRUE(published->label_text.has_value());
+  EXPECT_EQ(
+      l10n_util::GetStringUTF16(IDS_APP_MENU_BUTTON_HELIUM_SERVICES_UPDATE),
+      *published->label_text);
+  EXPECT_EQ(*published->label_text, published->accessibility_text);
+  EXPECT_EQ(
+      l10n_util::GetStringUTF16(IDS_APPMENU_TOOLTIP_HELIUM_SERVICES_UPDATE),
+      published->tooltip);
+  EXPECT_FALSE(published->is_context_menu_visible);
+
+  // The public snapshot and emitted state must agree, and an unchanged
+  // notification must not emit another event or invalidate the layout.
+  EXPECT_TRUE(control.GetState()->Equals(*published));
+  control.SetTypeAndSeverity(
+      {AppMenuIconController::IconType::kHeliumServicesUpdate,
+       AppMenuIconController::Severity::kLow});
+
+  control.SetTypeAndSeverity({AppMenuIconController::IconType::kNone,
+                              AppMenuIconController::Severity::kNone});
+  ASSERT_TRUE(published);
+  EXPECT_EQ(toolbar_ui_api::mojom::AppMenuIconType::kNone,
+            published->icon_type);
+  EXPECT_EQ(toolbar_ui_api::mojom::AppMenuSeverity::kNone, published->severity);
+  EXPECT_FALSE(published->label_text.has_value());
+  EXPECT_EQ(AppMenuIconController::GetIconAccessibleName(
+                AppMenuIconController::IconType::kNone),
+            published->accessibility_text);
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_APPMENU_TOOLTIP), published->tooltip);
+  EXPECT_TRUE(control.GetState()->Equals(*published));
+}
