+
+bool SessionService::PrepareForWindowCloseGroup(
+    const std::vector<SessionID>& window_ids) {
+  if (window_ids.empty()) {
+    return false;
+  }
+  // Rebuild before inserting pending IDs: pending closes deliberately inhibit
+  // rebuilding because their Browser objects may already have disappeared.
+  RebuildCommandsIfRequired();
+  const std::set<SessionID> group_ids(window_ids.begin(), window_ids.end());
+  for (SessionID id : group_ids) {
+    if (!ShouldTrackChangesToWindow(id) ||
+        pending_window_close_ids_.contains(id) ||
+        window_closing_ids_.contains(id)) {
+      return false;
+    }
+  }
+  // The tracking set also covers windows still being restored. Treat them as
+  // other open windows until explicitly closed, rather than risking their loss.
+  for (SessionID id : *windows_tracking()) {
+    if (!group_ids.contains(id) && !window_closing_ids_.contains(id)) {
+      return false;
+    }
+  }
+
+  LogExitEvent();
+  for (SessionID id : group_ids) {
+    pending_window_close_ids_.insert(id);
+    prepared_window_closes_.try_emplace(id);
+  }
+  has_open_trackable_browsers_ = false;
+  return true;
+}
+
+void SessionService::CancelWindowCloseGroup(
+    const std::vector<SessionID>& window_ids) {
+  bool cancelled = false;
+  for (SessionID id : window_ids) {
+    auto found = prepared_window_closes_.find(id);
+    if (found == prepared_window_closes_.end()) {
+      continue;
+    }
+    cancelled = true;
+    PreparedWindowClose prepared = std::move(found->second);
+    prepared_window_closes_.erase(found);
+    pending_window_close_ids_.erase(id);
+    for (SessionID tab_id : prepared.tabs) {
+      pending_tab_close_ids_.erase(tab_id);
+      ScheduleCommand(sessions::CreateTabClosedCommand(tab_id));
+    }
+    if (!ShouldTrackChangesToWindow(id)) {
+      // A sibling may already have finished closing when another pane is
+      // denied. Commit only that closed window, never a surviving window.
+      ScheduleCommand(sessions::CreateWindowClosedCommand(id));
+    } else if (prepared.started) {
+      // This pane passed WindowClosing and is finishing normal async teardown.
+      // The denied pane never reached WindowClosing and remains fully tracked.
+      window_closing_ids_.insert(id);
+    }
+  }
+  if (!cancelled) {
+    return;
+  }
+  has_open_trackable_browsers_ = false;
+  for (SessionID id : *windows_tracking()) {
+    if (!window_closing_ids_.contains(id) &&
+        !pending_window_close_ids_.contains(id)) {
+      has_open_trackable_browsers_ = true;
+      break;
+    }
+  }
+  if (pending_window_close_ids_.empty()) {
+    RemoveExitEvent();
+  }
 }
 
