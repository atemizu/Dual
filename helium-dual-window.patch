+// The same limits as on macOS (helium_dual_window_host_mac.mm), in DIPs.
+constexpr int kMinimumPaneWidth = 280;
+constexpr int kMinimumPaneHeight = 360;
+constexpr int kDividerWidth = 6;
+// Panes leave a band along the window's sides and bottom free, where the
+// window is resized from (the top is the panes' toolbars, as a title bar).
+constexpr int kResizeEdgeInset = 4;
+// Frameless mode (Zen mode in the source): the outer rails hide like
+// Helium's floating side chrome, and come out at the window's edge.
+constexpr int kFloatingRailInset = 8;
+constexpr int kRailRevealLeeway = 8;
+constexpr int kRailRevealFullscreenTrigger = 2;
+constexpr base::TimeDelta kRailHoverExitGrace = base::Milliseconds(150);
+constexpr base::TimeDelta kRailCursorExitGrace = base::Seconds(3);
+constexpr base::TimeDelta kRailPollInterval = base::Milliseconds(100);
+constexpr base::TimeDelta kRailRevealDuration = base::Milliseconds(200);
