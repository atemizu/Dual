+// Setting an unchanged NSCursor still synchronously talks to WindowServer.
+// During live resize AppKit can change it between callbacks, so consult the
+// current cursor instead of caching our last requested cursor.
+void SetCursorIfNeeded(NSCursor* cursor) {
+  if (NSCursor.currentCursor != cursor) {
