+// Copyright 2026 Dual contributors.
+// Created on 2026-10-10. Licensed under GPL-3.0; see the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_dual_tab_auto_close.h"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "chrome/browser/media/webrtc/media_capture_devices_dispatcher.h"
+#include "chrome/browser/media/webrtc/media_stream_capture_indicator.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/recently_audible_helper.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/tabs/dragging/tab_drag_controller.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/blink/public/mojom/frame/sudden_termination_disabler_type.mojom.h"
+
+namespace helium_dual {
+
+namespace {
+
+// When closing was last found switched on in a profile. A tab last used
+// before that is timed from here, so switching on closes nothing at once.
+constexpr char kTabAutoCloseSincePref[] = "helium.dual.tab_auto_close.since";
+
+// How often the tabs are looked at.
+constexpr base::TimeDelta kLookInterval = base::Minutes(5);
+// After the browser starts or the Mac wakes, nothing is closed for this
+// long: tabs that came due meanwhile can still be brought to the front.
+constexpr base::TimeDelta kQuietTime = base::Minutes(10);
+
+// For the tests: --dual-tab-auto-close-test-speed=N makes the time this
+// feature goes by pass N times as fast (an hour of the setting lasts 3600/N
+// seconds; so do the look interval and the quiet time, in proportion).
+double TestSpeed() {
+  static const double speed = [] {
+    double value = 1;
+    const std::string given =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "dual-tab-auto-close-test-speed");
+    if (!base::StringToDouble(given, &value) || !(value >= 1 && value <= 3600)) {
+      value = 1;
+    }
+    return value;
+  }();
+  return speed;
+}
+
+// When a tab was last found in use, where that is later than when it was
+// last brought to the front.
+class LastFoundInUse : public content::WebContentsUserData<LastFoundInUse> {
+ public:
+  ~LastFoundInUse() override = default;
+
+  base::Time time;
+
+ private:
+  friend class content::WebContentsUserData<LastFoundInUse>;
+
+  explicit LastFoundInUse(content::WebContents* contents)
+      : content::WebContentsUserData<LastFoundInUse>(*contents) {}
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(LastFoundInUse);
+
+bool IsPlayingSound(content::WebContents* contents) {
+  // As the tab's sound icon: still counted for a moment after a pause.
+  const RecentlyAudibleHelper* helper =
+      RecentlyAudibleHelper::FromWebContents(contents);
+  return helper ? helper->WasRecentlyAudible() : contents->IsCurrentlyAudible();
+}
+
+// On screen (also beside the tab in front, in a split view), or at work
+// without being looked at: taking part in a call or a recording, shown to
+// another tab or device, or playing in a floating window.
+bool IsAtWork(content::WebContents* contents) {
+  if (contents->GetVisibility() == content::Visibility::VISIBLE ||
+      contents->IsBeingCaptured() || contents->HasPictureInPictureVideo() ||
+      contents->HasPictureInPictureDocument()) {
+    return true;
+  }
+  const scoped_refptr<MediaStreamCaptureIndicator> capture =
+      MediaCaptureDevicesDispatcher::GetInstance()
+          ->GetMediaStreamCaptureIndicator();
+  return capture && (capture->IsCapturingUserMedia(contents) ||
+                     capture->IsBeingMirrored(contents) ||
+                     capture->IsCapturingTab(contents) ||
+                     capture->IsCapturingWindow(contents) ||
+                     capture->IsCapturingDisplay(contents));
+}
+
+// The page asks before it is left (it may hold something unsaved). Closing
+// it would put that question on screen with nobody having asked to close.
+bool AsksBeforeLeaving(content::WebContents* contents) {
+  content::RenderFrameHost* frame = contents->GetPrimaryMainFrame();
+  return frame && frame->GetSuddenTerminationDisablerState(
+                      blink::mojom::SuddenTerminationDisablerType::
+                          kBeforeUnloadHandler);
+}
+
+class TabAutoCloser {
+ public:
+  void Start() {
+    if (timer_.IsRunning()) {
+      return;
+    }
+    last_look_ = base::Time::Now();
+    quiet_until_ = last_look_ + kQuietTime / TestSpeed();
+    timer_.Start(FROM_HERE, kLookInterval / TestSpeed(),
+                 base::BindRepeating(&TabAutoCloser::Look,
+                                     base::Unretained(this)));
+  }
+
+ private:
+  void Look() {
+    if (browser_shutdown::HasShutdownStarted()) {
+      timer_.Stop();
+      return;
+    }
+    const base::Time now = base::Time::Now();
+    // The timer does not run while the Mac sleeps: a long gap means it has
+    // just woken.
+    if (now - last_look_ > 3 * kLookInterval / TestSpeed()) {
+      quiet_until_ = now + kQuietTime / TestSpeed();
+    }
+    last_look_ = now;
+    if (TabDragController::IsActive()) {
+      return;
+    }
+
+    std::vector<base::WeakPtr<content::WebContents>> unused;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          LookAt(browser, now, unused);
+          return true;
+        });
+    for (const auto& contents : unused) {
+      // Closing one tab can take others with it.
+      if (!contents) {
+        continue;
+      }
+      BrowserWindowInterface* browser =
+          GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+              contents.get());
+      TabStripModel* model = browser ? browser->GetTabStripModel() : nullptr;
+      const int index = model ? model->GetIndexOfWebContents(contents.get())
+                              : TabStripModel::kNoTab;
+      if (index != TabStripModel::kNoTab && index != model->active_index()) {
+        // Into History's recently closed tabs, like a tab closed by hand.
+        model->CloseWebContentsAt(index,
+                                  TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+      }
+    }
+  }
+
+  // Notes which of a window's tabs are in use, and collects those that have
+  // gone unused for the time set.
+  void LookAt(BrowserWindowInterface* browser,
+              base::Time now,
+              std::vector<base::WeakPtr<content::WebContents>>& unused) {
+    Profile* profile = browser->GetProfile();
+    // Private windows are left alone: a tab closed there cannot be reopened.
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        profile->IsOffTheRecord()) {
+      return;
+    }
+    PrefService* prefs = profile->GetPrefs();
+    base::Time since = prefs->GetTime(kTabAutoCloseSincePref);
+    if (!prefs->GetBoolean(kTabAutoCloseEnabledPref)) {
+      if (!since.is_null()) {
+        prefs->ClearPref(kTabAutoCloseSincePref);
+      }
+      return;
+    }
+    if (since.is_null() || since > now) {
+      since = now;
+      prefs->SetTime(kTabAutoCloseSincePref, since);
+    }
+    const base::TimeDelta limit =
+        base::Hours(std::clamp(prefs->GetInteger(kTabAutoCloseHoursPref),
+                               kTabAutoCloseMinHours, kTabAutoCloseMaxHours)) /
+        TestSpeed();
+    const bool keep_audible = prefs->GetBoolean(kTabAutoCloseKeepAudiblePref);
+
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      content::WebContents* contents = model->GetWebContentsAt(index);
+      if (index == model->active_index() || model->IsTabPinned(index) ||
+          IsAtWork(contents) || (keep_audible && IsPlayingSound(contents))) {
+        NoteInUse(profile, contents, now);
+      } else if (now >= quiet_until_ &&
+                 now - std::max(TabLastUsed(contents), since) >= limit &&
+                 !AsksBeforeLeaving(contents)) {
+        unused.push_back(contents->GetWeakPtr());
+      }
+    }
+  }
+
+  void NoteInUse(Profile* profile, content::WebContents* contents,
+                 base::Time now) {
+    LastFoundInUse::CreateForWebContents(contents);
+    LastFoundInUse::FromWebContents(contents)->time = now;
+    // For the next start of the browser (see TabLastUsed()).
+    SessionService* service =
+        SessionServiceFactory::GetForProfileIfExisting(profile);
+    const SessionID window_id =
+        sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+    const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+    if (service && window_id.is_valid() && tab_id.is_valid()) {
+      service->SetLastActiveTime(window_id, tab_id, now);
+    }
+  }
+
+  base::RepeatingTimer timer_;
+  base::Time last_look_;
+  base::Time quiet_until_;
+};
+
+}  // namespace
+
+void RegisterTabAutoClosePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kTabAutoCloseEnabledPref, false);
+  registry->RegisterIntegerPref(kTabAutoCloseHoursPref,
+                                kTabAutoCloseDefaultHours);
+  registry->RegisterBooleanPref(kTabAutoCloseKeepAudiblePref, true);
+  registry->RegisterTimePref(kTabAutoCloseSincePref, base::Time());
+}
+
+void StartTabAutoClose() {
+  static base::NoDestructor<TabAutoCloser> closer;
+  closer->Start();
+}
+
+base::Time TabLastUsed(content::WebContents* contents) {
+  const LastFoundInUse* found = LastFoundInUse::FromWebContents(contents);
+  return std::max(contents->GetLastActiveTime(),
+                  found ? found->time : base::Time());
+}
+
+}  // namespace helium_dual
