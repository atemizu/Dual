+// Keep native window-management menu actions on the shared outer window.
+// Close Window and other browser commands retain the pane's dispatcher.
+@interface HeliumDualPaneNSWindow : NativeWidgetMacNSWindow
+- (NSMenuItem*)heliumCloseWindowCommand;
+@end
+
+@implementation HeliumDualPaneNSWindow
+- (void)performMiniaturize:(id)sender {
+  if (NSWindow* host = self.parentWindow) {
+    [host performMiniaturize:sender];
+  } else {
+    [super performMiniaturize:sender];
+  }
+}
+
+- (void)performZoom:(id)sender {
+  if (NSWindow* host = self.parentWindow) {
+    [host performZoom:sender];
+  } else {
+    [super performZoom:sender];
+  }
+}
+
+- (void)toggleFullScreen:(id)sender {
+  if (NSWindow* host = self.parentWindow) {
+    [host toggleFullScreen:sender];
+  } else {
+    [super toggleFullScreen:sender];
+  }
+}
+
+- (NSMenuItem*)heliumCloseWindowCommand {
+  // The macOS Close Window menu uses performClose:, but the inherited
+  // implementation sends that action from a borderless pane to its parent.
+  // Adapt it to the existing browser command without changing the main menu.
+  NSMenuItem* command =
+      [[NSMenuItem alloc] initWithTitle:@""
+                                 action:@selector(commandDispatch:)
+                          keyEquivalent:@""];
+  command.tag = IDC_CLOSE_WINDOW;
+  return command;
+}
+
+- (void)performClose:(id)sender {
+  NSMenuItem* command = [self heliumCloseWindowCommand];
+  if ([self validateUserInterfaceItem:command]) {
+    [self commandDispatch:command];
+  }
+}
+
+- (BOOL)defaultValidateUserInterfaceItem:
+    (id<NSValidatedUserInterfaceItem>)item {
+  const SEL action = item.action;
+  if (action == @selector(performClose:)) {
+    // Validation must take the same browser-command path as execution.
+    // The proxy action is commandDispatch:, so it cannot reenter this branch.
+    return [self validateUserInterfaceItem:[self heliumCloseWindowCommand]];
+  }
+  if (self.parentWindow && (action == @selector(performMiniaturize:) ||
+                            action == @selector(performZoom:) ||
+                            action == @selector(toggleFullScreen:))) {
+    return [self.parentWindow validateUserInterfaceItem:item];
+  }
+  return [super defaultValidateUserInterfaceItem:item];
+}
