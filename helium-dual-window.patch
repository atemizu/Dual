+  ReadWindows(&windows, nullptr, nullptr, nullptr);
+  ASSERT_EQ(1U, windows.size());
+  EXPECT_EQ(right_id, windows[0]->window_id);
+  ASSERT_EQ(2U, windows[0]->tabs.size());
+  EXPECT_EQ(new_tab, windows[0]->tabs[1]->tab_id);
+}
