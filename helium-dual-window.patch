+// The window's parts ---------------------------------------------------------
+
+bool DividerView::OnMousePressed(const ui::MouseEvent& event) {
+  if (!event.IsOnlyLeftMouseButton()) {
+    return false;
+  }
+  press_offset_ = event.x();
+  pair_->DividerPressed();
+  return true;
+}
+
+bool DividerView::OnMouseDragged(const ui::MouseEvent& event) {
+  // Where the divider's left edge would be, in the window's coordinates.
+  pair_->DividerDragged(x() + event.x() - press_offset_);
+  return true;
+}
+
+void DividerView::OnMouseReleased(const ui::MouseEvent& event) {
+  pair_->DividerReleased();
+}
+
+void HostContents::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  pair_->ScheduleRelayout();
+}
+
+gfx::Size HostContents::GetMinimumSize() const {
+  return pair_->MinimumSize();
+}
+
+void HostContents::OnMouseMoved(const ui::MouseEvent& event) {}
+void HostContents::OnMouseExited(const ui::MouseEvent& event) {}
+
+int HostFrameView::NonClientHitTest(const gfx::Point& point) {
+  if (!widget_->IsMaximized() && !widget_->IsFullscreen()) {
+    constexpr int kEdge = kResizeEdgeInset;
+    const bool left = point.x() < kEdge;
+    const bool right = point.x() >= width() - kEdge;
+    const bool top = point.y() < kEdge;
+    const bool bottom = point.y() >= height() - kEdge;
+    if (top && left) return HTTOPLEFT;
+    if (top && right) return HTTOPRIGHT;
+    if (bottom && left) return HTBOTTOMLEFT;
+    if (bottom && right) return HTBOTTOMRIGHT;
+    if (left) return HTLEFT;
+    if (right) return HTRIGHT;
+    if (bottom) return HTBOTTOM;
+    // The top edge is the panes' toolbars; their own resize band there is
+    // the window's.
+    if (top) return HTTOP;
+  }
+  return pair_->PaneHitTest(point);
+}
+
+HostDelegate::HostDelegate(BrowserPair* pair) : pair_(pair) {
+  SetCanResize(true);
+  SetCanMaximize(true);
+  SetCanMinimize(true);
+  SetCanFullscreen(true);
+  SetTitle(u"Dual");
+}
+
+// The desktop asks the window to close (its own close button, a keyboard
+// shortcut of the window manager): as the window's close button.
+bool HostDelegate::OnCloseRequested(views::Widget::ClosedReason close_reason) {
+  if (pair_->retired()) {
+    return true;
+  }
+  pair_->RequestClose();
+  return false;
+}
