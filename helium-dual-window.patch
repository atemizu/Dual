+// Copyright 2026 Dual contributors.
+// Created on 2026-10-05. Licensed under GPL-3.0; see the LICENSE file.
+
+#include "chrome/browser/extensions/helium_dual_bundled_extensions.h"
+
+#import <Foundation/Foundation.h>
+
+#include <algorithm>
+#include <optional>
+#include <string>
+
+#include "base/apple/bundle_locations.h"
+#include "base/apple/foundation_util.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "chrome/browser/extensions/profile_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/crx_file/id_util.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "extensions/browser/extension_prefs.h"
+#include "extensions/browser/unpacked_installer.h"
+
+namespace helium_dual {
+
+namespace {
+
+// The bundled extensions this profile has been given, by id: true while the
+// extension is installed, false once the user has removed it.
+constexpr char kBundledExtensionsPref[] = "helium.dual.bundled_extensions";
+
+// Gives back the bundled extensions the user has removed.
+constexpr char kRestoreBundledExtensionsSwitch[] =
+    "dual-restore-bundled-extensions";
+
+// Holds one directory per extension, named by the extension's id.
+NSString* BundledExtensionsDirectory() {
+  return [base::apple::OuterBundle().resourcePath
+      stringByAppendingPathComponent:@"Dual Extensions"];
+}
+
+}  // namespace
+
+void RegisterBundledExtensionsPrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterDictionaryPref(kBundledExtensionsPref);
+}
+
+void LoadBundledExtensions(Profile* profile) {
+  if (!extensions::profile_util::ProfileCanUseNonComponentExtensions(profile)) {
+    return;
+  }
+
+  ScopedDictPrefUpdate given(profile->GetPrefs(), kBundledExtensionsPref);
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kRestoreBundledExtensionsSwitch)) {
+    given->clear();
+  }
+
+  // Like --load-extension, this reads the manifests before the first page
+  // loads.
+  extensions::ExtensionPrefs* extension_prefs =
+      extensions::ExtensionPrefs::Get(profile);
+  NSString* directory = BundledExtensionsDirectory();
+  for (NSString* name in [NSFileManager.defaultManager
+           contentsOfDirectoryAtPath:directory
+                               error:nil]) {
+    const base::FilePath path = base::apple::NSStringToFilePath(
+        [directory stringByAppendingPathComponent:name]);
+    const std::string id = path.BaseName().value();
+    if (!crx_file::id_util::IdIsValid(id)) {
+      continue;
+    }
+
+    // An extension loaded this way is not kept between launches, but its
+    // record is, until the user removes the extension. A missing record for
+    // one given before therefore means it was removed.
+    const std::optional<bool> installed = given->FindBool(id);
+    if (installed.has_value() &&
+        (!*installed || !extension_prefs->GetInstalledExtensionInfo(id))) {
+      given->Set(id, false);
+      continue;
+    }
+
+    std::string loaded_id;
+    if (!extensions::UnpackedInstaller::Create(profile)->LoadFromCommandLine(
+            path, &loaded_id, /*only_allow_apps=*/false) ||
+        loaded_id != id) {
+      continue;
+    }
+    if (!installed.has_value()) {
+      // New to this profile: its button starts out pinned to the toolbar. If
+      // the user unpins it, it stays unpinned.
+      extensions::ExtensionIdList pinned =
+          extension_prefs->GetPinnedExtensions();
+      if (!std::ranges::contains(pinned, id)) {
+        pinned.push_back(id);
+        extension_prefs->SetPinnedExtensions(pinned);
+      }
+    }
+    given->Set(id, true);
+  }
+}
+
+}  // namespace helium_dual
