+gfx::NativeView ReservePaneHost(BrowserView* view) {
+  BrowserWindowInterface* browser = view->browser();
+  CHECK(IsPane(RoleOf(browser)));
+  PairMap& map = Pairs()[browser->GetProfile()];
+  const std::string original_id = HeliumDualPaneState::From(browser)->group_id();
+  // A pane asked for by its window (the "+"), or one of a restored window.
+  if (auto original = map.find(original_id); original != map.end()) {
+    BrowserPair* owner = original->second.get();
+    BrowserWindowInterface* occupant =
+        owner->browser_at(SideIndex(RoleOf(browser)));
+    if (!owner->retired() && !occupant) {
+      owner->Reserve(view);
+      return owner->native_view();
+    }
+  }
+  // Restoring can bring back a window whose group is still open, or two
+  // windows that claim the same place: the second goes to a window of its
+  // own, and the other pane of its group follows it there.
+  auto& remaps = RestoreRemaps()[browser->GetProfile()];
+  for (auto it = remaps.begin(); it != remaps.end();) {
+    if (it->second.expires < base::TimeTicks::Now() ||
+        !map.contains(it->second.replacement) ||
+        map.at(it->second.replacement)->retired()) {
+      it = remaps.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  if (auto remap = remaps.find(original_id); remap != remaps.end()) {
+    BrowserPair* target = map.at(remap->second.replacement).get();
+    if (!target->browser_at(SideIndex(RoleOf(browser)))) {
+      HeliumDualPaneState::From(browser)->set_group_id(
+          remap->second.replacement);
+      target->Reserve(view);
+      return target->native_view();
+    }
+  }
+  if (auto existing = map.find(original_id); existing != map.end()) {
+    const std::string replacement =
+        base::Uuid::GenerateRandomV4().AsLowercaseString();
+    HeliumDualPaneState::From(browser)->set_group_id(replacement);
+    remaps[original_id] = {replacement,
+                           base::TimeTicks::Now() + base::Seconds(30)};
+  }
+  const std::string group = HeliumDualPaneState::From(browser)->group_id();
+  auto& pair = map[group];
+  CHECK(!pair);
+  pair = std::make_unique<BrowserPair>(browser->GetProfile(), group, view);
+  pair->Reserve(view);
+  return pair->native_view();
+}
