+namespace {
+// A press has been handed out in this app, and its release has not been yet.
+bool g_press_in_flight = false;
+// When every button was first found up with that release still to come.
+NSTimeInterval g_buttons_up_since = 0;
+
+bool IsPressEvent(NSEvent* event) {
+  return event.type == NSEventTypeLeftMouseDown ||
+         event.type == NSEventTypeRightMouseDown ||
+         event.type == NSEventTypeOtherMouseDown;
+}
+
+void WatchPresses() {
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    // (The press that brings this here for the first time is the event in
+    // hand.)
+    g_press_in_flight = IsPressEvent(NSApp.currentEvent);
+    [NSEvent
+        addLocalMonitorForEventsMatchingMask:NSEventMaskLeftMouseDown |
+                                             NSEventMaskRightMouseDown |
+                                             NSEventMaskOtherMouseDown |
+                                             NSEventMaskLeftMouseUp |
+                                             NSEventMaskRightMouseUp |
+                                             NSEventMaskOtherMouseUp
+                                     handler:^NSEvent*(NSEvent* event) {
+          g_press_in_flight =
+              IsPressEvent(event) || NSEvent.pressedMouseButtons != 0;
+          g_buttons_up_since = 0;
+          return event;
+        }];
+  });
+}
+}  // namespace
+
+bool IsPointerPressed() {
+  WatchPresses();
+  if (NSEvent.pressedMouseButtons != 0) {
+    g_buttons_up_since = 0;
+    return true;
+  }
+  if (!g_press_in_flight) {
+    return false;
+  }
+  // The button is up, but what it was pressed on has still to be told. Not
+  // for ever: a release that a window drag or a menu took for itself never
+  // comes by here.
+  const NSTimeInterval now = NSProcessInfo.processInfo.systemUptime;
+  if (g_buttons_up_since == 0) {
+    g_buttons_up_since = now;
+  }
+  if (now - g_buttons_up_since < 0.5) {
+    return true;
+  }
+  g_press_in_flight = false;
+  g_buttons_up_since = 0;
+  return false;
+}
+
+bool IsPaneHidden(BrowserWindowInterface* browser) {
+  const BrowserView* view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  return view && IsPaneHidden(view);
+}
+
+bool IsClosingBothPanes(Profile* profile, const TabStripModel* tab_strip_model) {
+  auto pairs = Pairs().find(profile);
+  if (pairs == Pairs().end()) {
+    return false;
+  }
+  for (const auto& entry : pairs->second) {
+    const BrowserPair* pair = entry.second.get();
+    BrowserWindowInterface* left = pair->browser_at(0);
+    BrowserWindowInterface* right = pair->browser_at(1);
+    if (left && right && pair->closing() &&
+        (left->GetTabStripModel() == tab_strip_model ||
+         right->GetTabStripModel() == tab_strip_model)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool OpenPaneWithPinnedTabs(BrowserWindowInterface* browser,
+                            const std::vector<GURL>& urls,
+                            bool hidden) {
+  const BrowserView* view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  BrowserPair* pair = view ? Find(view) : nullptr;
+  return pair && RoleOf(browser) == HeliumDualRole::kLeft &&
+         pair->OpenPaneWithPinnedTabs(HeliumDualPaneSideRight, urls, hidden);
+}
+
+void EnsureHost(BrowserView* view, bool completing_tab_drag) {
+  WatchPresses();
+  // A new drag browser has to remain a real free native window until the
+  // standard move loop and tab-model commit/revert have both finished.
+  if (!completing_tab_drag &&
+      view->browser_widget()->tab_drag_kind() != TabDragKind::kNone) {
+    return;
+  }
+  BrowserWindowInterface* browser = view->browser();
+  if (!IsPane(RoleOf(browser)) || !view->GetNativeWindow()) {
+    return;
+  }
+  PairMap& map = Pairs()[browser->GetProfile()];
+  const std::string original_id = HeliumDualPaneState::From(browser)->group_id();
+  if (auto original_pair = map.find(original_id); original_pair != map.end()) {
+    BrowserPair* owner = original_pair->second.get();
+    BrowserWindowInterface* occupant =
+        owner->browser_at(SideIndex(RoleOf(browser)));
+    // An explicit launch-rail request belongs to its live host. Preserve that
+    // ownership on subsequent Show calls and leave restore-peer remaps intact.
+    if (occupant == browser || (!occupant && owner->creating_pane())) {
+      owner->Attach(view);
+      return;
+    }
+  }
+  auto& remaps = RestoreRemaps()[browser->GetProfile()];
+  for (auto it = remaps.begin(); it != remaps.end();) {
+    if (it->second.expires < base::TimeTicks::Now() ||
+        !map.contains(it->second.replacement) ||
+        map.at(it->second.replacement)->retired()) {
+      it = remaps.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  if (auto remap = remaps.find(original_id); remap != remaps.end()) {
+    BrowserPair* target = map.at(remap->second.replacement).get();
+    if (!target->browser_at(SideIndex(RoleOf(browser)))) {
+      HeliumDualPaneState::From(browser)->set_group_id(remap->second.replacement);
+    }
+  }
+  auto existing = map.find(HeliumDualPaneState::From(browser)->group_id());
+  if (existing != map.end()) {
+    BrowserWindowInterface* occupant =
+        existing->second->browser_at(SideIndex(RoleOf(browser)));
+    if (existing->second->retired() || (occupant && occupant != browser)) {
+      const std::string replacement =
+          base::Uuid::GenerateRandomV4().AsLowercaseString();
+      HeliumDualPaneState::From(browser)->set_group_id(replacement);
+      remaps[original_id] = {replacement,
+                             base::TimeTicks::Now() + base::Seconds(30)};
+    }
+  }
+  auto& pair = map[HeliumDualPaneState::From(browser)->group_id()];
+  if (!pair) {
+    pair = std::make_unique<BrowserPair>(browser->GetProfile(),
+                                         HeliumDualPaneState::From(browser)->group_id(), view);
+  }
+  pair->Attach(view);
+  if (pair->browser_at(0) && pair->browser_at(1)) {
+    remaps.erase(original_id);
+  }
+}
+
+void ShowHost(BrowserView* view, bool activate) {
+  if (BrowserPair* pair = Find(view)) {
+    pair->Show(view, activate);
+  }
+}
+
+gfx::NativeWindow BrowserWindowForHost(gfx::NativeWindow window) {
+  if (!window) {
+    return {};
+  }
+  for (const auto& profile : Pairs()) {
+    for (const auto& entry : profile.second) {
+      HeliumDualWindowHost* host = entry.second->host();
+      if (window.GetNativeNSWindow() != host.window) {
+        continue;
+      }
+      NSWindow* pane = [host browserWindowForSide:host.activePane];
+      if (!pane) {
+        pane = [host browserWindowForSide:HeliumDualPaneSideLeft] ?:
+               [host browserWindowForSide:HeliumDualPaneSideRight];
+      }
+      return gfx::NativeWindow(pane);
+    }
+  }
+  return {};
+}
+
+bool BeginTabWindowDrag(BrowserView* view) {
+  if (BrowserPair* pair = Find(view, true)) {
+    return pair->SuspendPaneForDrag(view);
+  }
+  return true;
+}
+
+void EndTabWindowDrag(base::WeakPtr<BrowserView> view, bool canceled) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+          [](base::WeakPtr<BrowserView> view, bool canceled) {
+            if (!view || view->GetWidget()->IsClosed() ||
+                view->browser()->GetTabStripModel()->empty()) {
+              return;
+            }
+            BrowserWindowInterface* browser = view->browser();
+            if (BrowserPair* pair = Find(view.get(), true)) {
+              if (!pair->IsPaneSuspended(view.get()) ||
+                  pair->ResumePaneAfterDrag(view.get(), canceled)) {
+                return;
+              }
+              pair->Detach(view.get());
+              HeliumDualPaneState::From(browser)->set_group_id(
+                  base::Uuid::GenerateRandomV4().AsLowercaseString());
+              HeliumDualPaneState::From(browser)->set_ratio(kDefaultRatio);
+              HeliumDualPaneState::From(browser)->set_host_bounds({});
+            }
+            EnsureHost(view.get(), true);
+            ShowHost(view.get(), true);
+          }, std::move(view), canceled));
+}
+
+void DetachFromHost(BrowserView* view) {
+  if (BrowserPair* pair = Find(view, true)) {
+    pair->Detach(view);
+  }
+}
+
+bool MinimizeHost(BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    [pair->host().window miniaturize:nil];
+    return true;
+  }
+  return false;
+}
+
+bool RestoreHost(BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    pair->Restore();
+    return true;
+  }
+  return false;
+}
+
+bool ZoomHost(BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    if (!pair->host().window.zoomed) {
+      [pair->host().window zoom:nil];
+    }
+    return true;
+  }
+  return false;
+}
+
+bool RequestHostFullscreen(BrowserView* view,
+                           bool fullscreen,
+                           int64_t display_id) {
+  if (BrowserPair* pair = Find(view)) {
+    auto* screen = display::Screen::Get();
+    auto* controller =
+        ExclusiveAccessManager::From(view->browser())->fullscreen_controller();
+    auto* contents = view->browser()->GetTabStripModel()->GetActiveWebContents();
+    int64_t target_display = display_id;
+    if (target_display == display::kInvalidDisplayId && contents &&
+        controller->IsWindowFullscreenForTabOrPending()) {
+      target_display = FullscreenController::GetDisplayId(*contents);
+    }
+    if (fullscreen && target_display != display::kInvalidDisplayId && screen &&
+        screen->GetDisplayNearestWindow(gfx::NativeWindow(pair->host().window))
+                .id() != target_display) {
+      // Retargeting the shared host to another fullscreen Space needs a
+      // separate native transition. Cancel this unsupported content request
+      // through the normal controller, then report the unchanged window state.
+      // In particular, never report success on the wrong target display.
+      // A pane can also start on another screen when the host spans displays.
+      if (contents) {
+        controller->ExitFullscreenModeForTab(contents);
+      }
+      view->FullscreenStateChanged();
+      return true;
+    }
+    if (pair->host().fullscreen != fullscreen ||
+        pair->host().fullscreenTransition) {
+      [pair->host() requestFullscreen:fullscreen];
+    } else {
+      // Content fullscreen may change while the shared outer window is
+      // already fullscreen. Complete the browser controller's transition.
+      [pair->host() requestFullscreen:fullscreen];
+      view->PrepareForHeliumDualFullscreen(fullscreen);
+      view->FullscreenStateChanged();
+    }
+    return true;
+  }
+  return false;
+}
