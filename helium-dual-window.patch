+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_DUAL_STATE_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_DUAL_STATE_H_
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <map>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/uuid.h"
+
+enum class HeliumDualRole { kNone, kLeft, kRight };
+
+struct HeliumDualState {
+  std::string group_id;
+  HeliumDualRole role = HeliumDualRole::kNone;
+  double ratio = 0.5;
+  // NSStringFromRect representation, validated by the macOS coordinator.
+  std::string host_bounds;
+};
+
+namespace helium_dual {
+
+// Window extra data keeps Chromium's own per-window tab/navigation storage.
+inline constexpr char kGroupIdKey[] = "helium.dual.group_id";
+inline constexpr char kRoleKey[] = "helium.dual.role";
+inline constexpr char kRatioKey[] = "helium.dual.ratio";
+inline constexpr char kHostBoundsKey[] = "helium.dual.host_bounds";
+inline constexpr size_t kMaxHostBoundsBytes = 256;
+inline constexpr double kDefaultRatio = 0.5;
+inline constexpr double kMinRatio = 0.15;
+inline constexpr double kMaxRatio = 0.85;
+
+inline constexpr bool IsPane(HeliumDualRole role) {
+  return role == HeliumDualRole::kLeft || role == HeliumDualRole::kRight;
+}
+
+inline double ClampRatio(double ratio) {
+  return std::isfinite(ratio) ? std::clamp(ratio, kMinRatio, kMaxRatio)
+                              : kDefaultRatio;
+}
+
+inline std::string RoleName(HeliumDualRole role) {
+  switch (role) {
+    case HeliumDualRole::kLeft:
+      return "left";
+    case HeliumDualRole::kRight:
+      return "right";
+    case HeliumDualRole::kNone:
+      return {};
+  }
+  return {};
+}
+
+inline HeliumDualState ReadExtraData(
+    const std::map<std::string, std::string>& data) {
+  HeliumDualState state;
+  const auto group = data.find(kGroupIdKey);
+  const auto role = data.find(kRoleKey);
+  if (group == data.end() || role == data.end()) {
+    return state;
+  }
+  const base::Uuid group_uuid = base::Uuid::ParseCaseInsensitive(group->second);
+  if (!group_uuid.is_valid()) {
+    return state;
+  }
+  if (role->second == "left") {
+    state.role = HeliumDualRole::kLeft;
+  } else if (role->second == "right") {
+    state.role = HeliumDualRole::kRight;
+  } else {
+    return state;
+  }
+  state.group_id = group_uuid.AsLowercaseString();
+  const auto ratio = data.find(kRatioKey);
+  double parsed_ratio = kDefaultRatio;
+  if (ratio != data.end() &&
+      base::StringToDouble(ratio->second, &parsed_ratio)) {
+    state.ratio = ClampRatio(parsed_ratio);
+  }
+  const auto bounds = data.find(kHostBoundsKey);
+  if (bounds != data.end() && bounds->second.size() <= kMaxHostBoundsBytes) {
+    state.host_bounds = bounds->second;
+  }
+  return state;
+}
+
+inline std::map<std::string, std::string> MakeExtraData(
+    std::string_view group_id,
+    HeliumDualRole role,
+    double ratio,
+    std::string_view host_bounds = {}) {
+  const base::Uuid group_uuid = base::Uuid::ParseCaseInsensitive(group_id);
+  if (!IsPane(role) || !group_uuid.is_valid()) {
+    return {};
+  }
+  std::map<std::string, std::string> data = {
+      {kGroupIdKey, group_uuid.AsLowercaseString()},
+      {kRoleKey, RoleName(role)},
+      {kRatioKey, base::NumberToString(ClampRatio(ratio))}};
+  if (!host_bounds.empty() && host_bounds.size() <= kMaxHostBoundsBytes) {
+    data[kHostBoundsKey] = host_bounds;
+  }
+  return data;
+}
+
+inline std::map<std::string, std::string> MakeExtraData(
+    const HeliumDualState& state) {
+  return MakeExtraData(state.group_id, state.role, state.ratio,
+                       state.host_bounds);
+}
+
+}  // namespace helium_dual
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_DUAL_STATE_H_
Index: b/chrome/browser/ui/helium/helium_dual_state_smoke.cc
===================================================================
--- a/chrome/browser/ui/helium/helium_dual_state_smoke.cc
+++ b/chrome/browser/ui/helium/helium_dual_state_smoke.cc
@@ -0,0 +1,90 @@
+// Copyright 2026 Helium Dual contributors.
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+// Modified: 2026-09-08; publication notices: 2026-09-09.
+// Original imported notices below remain applicable to imported portions.
+
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include <iostream>
+#include <limits>
+
+#include "chrome/browser/ui/helium/helium_dual_state.h"
+
+namespace {
+
+constexpr char kGroup[] = "12345678-90ab-4cde-8fab-123456789abc";
+constexpr char kBounds[] = "{{20, 40}, {1440, 900}}";
+int failures = 0;
+
+void Expect(bool condition, const char* label) {
+  if (!condition) {
+    std::cerr << "FAIL: " << label << '\n';
+    ++failures;
+  }
+}
+
+}  // namespace
+
+int main() {
+  for (const auto role : {HeliumDualRole::kLeft, HeliumDualRole::kRight}) {
+    const auto restored = helium_dual::ReadExtraData(
+        helium_dual::MakeExtraData(kGroup, role, 0.625, kBounds));
+    Expect(restored.group_id == kGroup, "pair identity survives roundtrip");
+    Expect(restored.role == role, "pane side survives roundtrip");
+    Expect(restored.ratio == 0.625, "latest ratio survives roundtrip");
+    Expect(restored.host_bounds == kBounds,
+           "outer geometry survives instead of pane geometry");
+  }
+
+  Expect(helium_dual::ReadExtraData({}).role == HeliumDualRole::kNone,
+         "legacy windows remain ordinary");
+  auto data = helium_dual::MakeExtraData(kGroup, HeliumDualRole::kRight, 0.5);
+  data[helium_dual::kGroupIdKey] = "12345678-90AB-4CDE-8FAB-123456789ABC";
+  Expect(helium_dual::ReadExtraData(data).group_id == kGroup,
+         "restored pair UUID is canonical");
+  data[helium_dual::kGroupIdKey] = "not-a-pair-uuid";
+  Expect(helium_dual::ReadExtraData(data).role == HeliumDualRole::kNone,
+         "damaged pair identity cannot attach to a host");
+  data[helium_dual::kGroupIdKey] = kGroup;
+  data[helium_dual::kRoleKey] = "future-role";
+  Expect(helium_dual::ReadExtraData(data).role == HeliumDualRole::kNone,
+         "unknown role remains an ordinary browser");
+  data.erase(helium_dual::kRoleKey);
+  Expect(helium_dual::ReadExtraData(data).role == HeliumDualRole::kNone,
+         "incomplete metadata does not create a pane");
+
+  data = helium_dual::MakeExtraData(kGroup, HeliumDualRole::kLeft, 0.5);
+  data[helium_dual::kRatioKey] = "broken";
+  Expect(helium_dual::ReadExtraData(data).ratio == 0.5,
+         "malformed ratio uses a usable equal split");
+  data[helium_dual::kRatioKey] = "999";
+  Expect(helium_dual::ReadExtraData(data).ratio == helium_dual::kMaxRatio,
+         "oversized restored ratio preserves both panes");
+  data[helium_dual::kRatioKey] = "-1";
+  Expect(helium_dual::ReadExtraData(data).ratio == helium_dual::kMinRatio,
+         "negative restored ratio preserves both panes");
+  data[helium_dual::kRatioKey] = "NaN";
+  Expect(helium_dual::ReadExtraData(data).ratio == 0.5,
+         "nonfinite persisted ratio cannot reach AppKit geometry");
+  Expect(
+      helium_dual::ClampRatio(std::numeric_limits<double>::infinity()) == 0.5,
+      "nonfinite live ratio cannot reach session state");
+  data[helium_dual::kHostBoundsKey] = std::string(257, 'x');
+  Expect(helium_dual::ReadExtraData(data).host_bounds.empty(),
+         "oversized host geometry is discarded");
+  data[helium_dual::kHostBoundsKey] = kBounds;
+  Expect(helium_dual::ReadExtraData(data).host_bounds == kBounds,
+         "native geometry encoding is retained without generic parsing");
+  Expect(helium_dual::MakeExtraData(kGroup, HeliumDualRole::kNone, 0.5).empty(),
+         "ordinary browsers emit no dual metadata");
+  Expect(helium_dual::MakeExtraData("", HeliumDualRole::kLeft, 0.5).empty(),
+         "unassigned identity is not persisted");
+
+  if (failures == 0) {
+    std::cout << "Helium dual state smoke checks passed\n";
+  }
+  return failures == 0 ? 0 : 1;
+}
