+      browser ? BrowserInitState::From(browser) : nullptr;
+  const bool is_dual_pane =
+      state && helium_dual::IsPane(state->create_params().helium_dual_role);
+  ResolveJavascriptCallback(args[0], base::Value(is_dual_pane));
