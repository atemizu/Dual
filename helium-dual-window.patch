+@implementation HeliumDualWindowHost {
+  NSWindow* _window;
+  __weak NSWindow* _leftWindow;
+  __weak NSWindow* _rightWindow;
+  HeliumDualDividerView* _divider;
+  HeliumDualLaunchButton* _launchButton;
+  HeliumDualLaunchButton* _leftLaunchButton;
+  HeliumDualRailStyle* _railStyle;
+  double _splitRatio;
+  HeliumDualPaneSide _activePane;
+  NSMutableArray<id>* _notificationTokens;
+  BOOL _paneHidden[2];
+  CGFloat _hiddenRailWidth[2];
+  BOOL _closing;
+  BOOL _layingOut;
+  BOOL _layoutPending;
+  BOOL _relayoutScheduled;
+  NSRect _expectedPaneFrames[2];
+  BOOL _fullscreenTransition;
+  BOOL _fullscreenTarget;
+  BOOL _hasPendingFullscreenRequest;
+  BOOL _pendingFullscreenRequest;
+  NSRect _normalFrame;
+  // Window controls shown inside the pane that covers the hidden titlebar.
+  NSMutableArray<NSButton*>* _paneWindowButtons;
+  // Moves the shared window from a pane's draggable background.
+  id _paneDragMonitor;
+  __weak NSWindow* _windowControlsPane;
+}
+
+@synthesize delegate = _delegate;
+@synthesize interactiveResize = _interactiveResize;
+
+- (instancetype)initWithContentRect:(NSRect)contentRect title:(NSString*)title {
+  self = [super init];
+  if (!self) {
+    return nil;
+  }
+  _splitRatio = 0.5;
+  _hiddenRailWidth[0] = _hiddenRailWidth[1] = kDefaultLaunchRailWidth;
+  _railStyle = [[HeliumDualRailStyle alloc] init];
+  _activePane = HeliumDualPaneSideLeft;
+  _notificationTokens = [[NSMutableArray alloc] init];
+  const NSWindowStyleMask style =
+      NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+      NSWindowStyleMaskMiniaturizable | NSWindowStyleMaskResizable;
+  _window = [[NSWindow alloc] initWithContentRect:contentRect
+                                        styleMask:style
+                                          backing:NSBackingStoreBuffered
+                                            defer:NO];
+  _window.releasedWhenClosed = NO;
+  _window.delegate = self;
+  _window.title = title;
+  _window.tabbingMode = NSWindowTabbingModeDisallowed;
+  _window.collectionBehavior = NSWindowCollectionBehaviorFullScreenPrimary;
+  // No visible titlebar: the panes extend to the top edge like a normal
+  // Helium window, and the pane at the top-left shows the window controls.
+  _window.styleMask |= NSWindowStyleMaskFullSizeContentView;
+  _window.titlebarAppearsTransparent = YES;
+  _window.titleVisibility = NSWindowTitleHidden;
+  _window.contentView = [[HeliumDualBackgroundView alloc]
+      initWithFrame:NSMakeRect(0, 0, contentRect.size.width,
+                               contentRect.size.height)];
+  _window.contentMinSize =
+      NSMakeSize([self minimumContentWidth], kMinimumContentHeight);
+  _normalFrame = _window.frame;
+
+  _divider = [[HeliumDualDividerView alloc] initWithFrame:NSZeroRect];
+  _divider.host = self;
+  _divider.hidden = YES;
+  _divider.accessibilityRole = NSAccessibilitySplitterRole;
+  _divider.accessibilityLabel = @"左右のブラウザの幅";
+  [_window.contentView addSubview:_divider];
+
+  _launchButton =
+      [HeliumDualLaunchButton buttonWithTitle:@""
+                                       target:self
+                                       action:@selector(requestRightPane:)];
+  _launchButton.bezelStyle = NSBezelStyleRegularSquare;
+  _launchButton.bordered = NO;
+  _launchButton.toolTip = @"右のブラウザで新しいタブを開く";
+  _launchButton.accessibilityLabel = @"右のブラウザで新しいタブを開く";
+  [_window.contentView addSubview:_launchButton];
+  _leftLaunchButton =
+      [HeliumDualLaunchButton buttonWithTitle:@""
+                                       target:self
+                                       action:@selector(requestLeftPane:)];
+  _leftLaunchButton.bezelStyle = NSBezelStyleRegularSquare;
+  _leftLaunchButton.bordered = NO;
+  _leftLaunchButton.toolTip = @"左のブラウザで新しいタブを開く";
+  _leftLaunchButton.accessibilityLabel = @"左のブラウザで新しいタブを開く";
+  [_window.contentView addSubview:_leftLaunchButton];
+
+  __weak HeliumDualWindowHost* weakSelf = self;
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  [_notificationTokens
+      addObject:[center addObserverForName:NSWindowDidBecomeKeyNotification
+                                    object:nil
+                                     queue:nil
+                                usingBlock:^(NSNotification* notification) {
+                                  HeliumDualWindowHost* host = weakSelf;
+                                  if (!host) {
+                                    return;
+                                  }
+                                  NSWindow* pane = notification.object;
+                                  if (pane == host->_leftWindow ||
+                                      pane == host->_rightWindow) {
+                                    host->_activePane =
+                                        pane == host->_rightWindow
+                                            ? HeliumDualPaneSideRight
+                                            : HeliumDualPaneSideLeft;
+                                    id<HeliumDualWindowHostDelegate> delegate =
+                                        host.delegate;
+                                    if ([delegate
+                                            respondsToSelector:
+                                                @selector(heliumDualWindowHost:
+                                                          didActivatePane:)]) {
+                                      [delegate
+                                          heliumDualWindowHost:host
+                                               didActivatePane:host->
+                                                               _activePane];
+                                    }
+                                  }
+                                }]];
+  [_notificationTokens
+      addObject:[center addObserverForName:NSWindowWillCloseNotification
+                                    object:nil
+                                     queue:nil
+                                usingBlock:^(NSNotification* notification) {
+                                  HeliumDualWindowHost* host = weakSelf;
+                                  if (!host || host->_closing) {
+                                    return;
+                                  }
+                                  NSWindow* pane = notification.object;
+                                  if (pane == host->_leftWindow ||
+                                      pane == host->_rightWindow) {
+                                    [host detachBrowserWindow:pane];
+                                  }
+                                }]];
+  // AppKit or Chromium can complete a pane move after a host layout. Only
+  // reconcile a real frame mismatch, so our own resize notifications cannot
+  // start a layout loop.
+  for (NSNotificationName name in @[NSWindowDidResizeNotification,
+                                     NSWindowDidMoveNotification]) {
+    [_notificationTokens addObject:
+        [center addObserverForName:name object:nil queue:nil
+                        usingBlock:^(NSNotification* notification) {
+      HeliumDualWindowHost* host = weakSelf;
+      if (!host || host->_closing || host->_layingOut) return;
+      NSWindow* pane = notification.object;
+      if (pane == host->_leftWindow || pane == host->_rightWindow) {
+        NSUInteger side = pane == host->_leftWindow ? 0 : 1;
+        if (!NSEqualRects(pane.frame, host->_expectedPaneFrames[side]))
+          [host scheduleRelayout];
+      }
+    }]];
+  }
+  // Panes are not movable on their own. A press on a pane's draggable
+  // background (which its content view does not claim) moves the host, and a
+  // double-click there follows the system titlebar double-click setting.
+  _paneDragMonitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:NSEventMaskLeftMouseDown
+                                   handler:^NSEvent*(NSEvent* event) {
+    HeliumDualWindowHost* host = weakSelf;
+    NSWindow* pane = event.window;
+    if (!host || host->_closing ||
+        (pane != host->_leftWindow && pane != host->_rightWindow)) {
+      return event;
+    }
+    NSView* content = pane.contentView;
+    const NSPoint point =
+        [content.superview convertPoint:event.locationInWindow fromView:nil];
+    if ([content hitTest:point]) {
+      return event;
+    }
+    if (event.clickCount == 2) {
+      NSString* action = [NSUserDefaults.standardUserDefaults
+          stringForKey:@"AppleActionOnDoubleClick"];
+      if ([action isEqualToString:@"Minimize"]) {
+        [host->_window miniaturize:nil];
+      } else if (![action isEqualToString:@"None"]) {
+        [host->_window zoom:nil];
+      }
+      return nil;
+    }
+    [host->_window performWindowDragWithEvent:event];
+    return nil;
+  }];
+  [self applyRailStyle:_railStyle];
+  [self relayout];
+  return self;
+}
+
+- (void)dealloc {
+  if (_paneDragMonitor) {
+    [NSEvent removeMonitor:_paneDragMonitor];
+  }
+  for (id token in _notificationTokens) {
+    [NSNotificationCenter.defaultCenter removeObserver:token];
+  }
+  _window.delegate = nil;
+  _divider.host = nil;
+  _launchButton.target = nil;
+  _leftLaunchButton.target = nil;
+  // Never close browser windows here: their BrowserWidgets own their teardown.
+  if (_leftWindow.parentWindow == _window) {
+    [_window removeChildWindow:_leftWindow];
+  }
+  if (_rightWindow.parentWindow == _window) {
+    [_window removeChildWindow:_rightWindow];
+  }
+  [_window orderOut:nil];
+}
+
+- (NSWindow*)window {
+  return _window;
+}
+- (NSRect)normalFrame {
+  return _normalFrame;
+}
+- (double)splitRatio {
+  return _splitRatio;
+}
+- (CGFloat)minimumContentWidth {
+  return (_leftWindow && _rightWindow) ? 2 * kMinimumPaneWidth + kDividerWidth
+                                       : kMinimumPaneWidth + _railStyle.width;
+}
+- (BOOL)hasRightPane {
+  return _rightWindow != nil;
+}
+- (HeliumDualPaneSide)activePane {
+  return _activePane;
+}
+- (void)setSplitRatio:(double)ratio {
+  if (!std::isfinite(ratio)) {
+    return;
+  }
+  const double clamped = std::clamp(ratio, 0.15, 0.85);
+  // A reentrant setter still needs relayout to mark _layoutPending.
+  if (clamped == _splitRatio && !_layingOut) return;
+  _splitRatio = clamped;
+  [self relayout];
+  if ([self.delegate
+          respondsToSelector:@selector(
+                                 heliumDualWindowHost:didChangeSplitRatio:)]) {
+    [self.delegate heliumDualWindowHost:self didChangeSplitRatio:_splitRatio];
+  }
+}
+
+- (NSWindow*)browserWindowForSide:(HeliumDualPaneSide)side {
+  return side == HeliumDualPaneSideRight ? _rightWindow : _leftWindow;
+}
+
+- (void)attachBrowserWindow:(NSWindow*)pane side:(HeliumDualPaneSide)side {
+  NSAssert(NSThread.isMainThread, @"Window operations require the main thread");
+  NSAssert(pane != _window, @"A host cannot be its own pane");
+  NSWindow* previous = [self browserWindowForSide:side];
+  NSAssert(!previous || previous == pane, @"Detach the old pane first");
+  if (previous == pane) {
+    return;
+  }
+  if (side == HeliumDualPaneSideRight) {
+    _rightWindow = pane;
+  } else {
+    _leftWindow = pane;
+  }
+  if (pane.parentWindow) {
+    [pane.parentWindow removeChildWindow:pane];
+  }
+  // Keep the native browser window object and delegate. In production this
+  // style is also selected before window construction so layout is consistent.
+  pane.styleMask = NSWindowStyleMaskBorderless;
+  pane.hasShadow = NO;
+  pane.movable = NO;
+  pane.movableByWindowBackground = NO;
+  pane.tabbingMode = NSWindowTabbingModeDisallowed;
+  pane.collectionBehavior = NSWindowCollectionBehaviorTransient |
+                            NSWindowCollectionBehaviorIgnoresCycle |
+                            NSWindowCollectionBehaviorFullScreenAuxiliary;
+  pane.excludedFromWindowsMenu = YES;
+  [_window addChildWindow:pane ordered:NSWindowAbove];
+
+  const CGFloat minimumWidth = [self minimumContentWidth];
+  _window.contentMinSize = NSMakeSize(minimumWidth, kMinimumContentHeight);
+  NSSize size = _window.contentView.bounds.size;
+  if (size.width < minimumWidth && !_window.miniaturized) {
+    [_window setContentSize:NSMakeSize(minimumWidth, size.height)];
+  }
+  [self relayout];
+  if (_window.visible && !_window.miniaturized) {
+    [pane orderFront:nil];
+  }
+}
+
+- (void)detachBrowserWindow:(NSWindow*)pane {
+  NSAssert(NSThread.isMainThread, @"Window operations require the main thread");
+  const BOOL wasRight = pane == _rightWindow;
+  if (!wasRight && pane != _leftWindow) {
+    return;
+  }
+  if (pane.parentWindow == _window) {
+    [_window removeChildWindow:pane];
+  }
+  _paneHidden[0] = _paneHidden[1] = NO;
+  if (wasRight) {
+    _rightWindow = nil;
+    _activePane = HeliumDualPaneSideLeft;
+  } else {
+    _leftWindow = nil;
+    _activePane = HeliumDualPaneSideRight;
+  }
+  _window.contentMinSize =
+      NSMakeSize([self minimumContentWidth], kMinimumContentHeight);
+  [self relayout];
+}
+
+- (void)showAndActivate:(BOOL)activate {
+  if (_closing) {
+    return;
+  }
+  if (_window.miniaturized) {
+    [_window deminiaturize:nil];
+  }
+  [self relayout];
+  if (activate) {
+    [_window makeKeyAndOrderFront:nil];
+    [self restoreLastActivePane];
+  } else {
+    [_window orderFront:nil];
+  }
+  [_leftWindow orderFront:nil];
+  [_rightWindow orderFront:nil];
+}
+
+- (void)activatePane:(HeliumDualPaneSide)side {
+  NSWindow* pane = [self browserWindowForSide:side];
+  if (!pane || _closing || _window.miniaturized) {
+    return;
+  }
+  _activePane = side;
+  [pane makeKeyAndOrderFront:nil];
+}
+
+- (void)restoreLastActivePane {
+  NSWindow* pane = [self browserWindowForSide:_activePane];
+  if (!pane) {
+    _activePane =
+        _leftWindow ? HeliumDualPaneSideLeft : HeliumDualPaneSideRight;
+  }
+  [self activatePane:_activePane];
+}
+
+- (void)applyRailStyle:(HeliumDualRailStyle*)style {
+  NSAssert(style.width > 0 && style.buttonHeight > 0,
+           @"Rail metrics must be positive");
+  const BOOL metricsChanged =
+      _railStyle.width != style.width ||
+      _railStyle.buttonHeight != style.buttonHeight ||
+      _railStyle.horizontalPadding != style.horizontalPadding ||
+      _railStyle.buttonTop != style.buttonTop ||
+      _railStyle.paneEdgeInset != style.paneEdgeInset;
+  _railStyle = style;
+  HeliumDualBackgroundView* background =
+      (HeliumDualBackgroundView*)_window.contentView;
+  background.railStyle = style;
+  background.needsDisplay = YES;
+  _window.backgroundColor = style.backgroundColor;
+  _divider.fillColor = style.separatorColor;
+  _divider.needsDisplay = YES;
+  for (HeliumDualLaunchButton* button in
+       @[ _launchButton, _leftLaunchButton ]) {
+    button.railStyle = style;
+    button.needsDisplay = YES;
+  }
+  _window.contentMinSize =
+      NSMakeSize([self minimumContentWidth], kMinimumContentHeight);
+  // Palette/background updates must not feed native bounds notifications back
+  // into another layout; only changed geometry needs to move the panes.
+  if (metricsChanged) {
+    [self relayout];
+  }
+}
+
+- (void)setHiddenRailWidth:(CGFloat)width side:(HeliumDualPaneSide)side {
+  _hiddenRailWidth[side] = std::max<CGFloat>(kDefaultLaunchRailWidth, width);
+}
+- (BOOL)isPaneHidden:(HeliumDualPaneSide)side {
+  return _paneHidden[side];
+}
+- (void)setPaneHidden:(BOOL)hidden side:(HeliumDualPaneSide)side {
+  if (hidden && (!_leftWindow || !_rightWindow || _paneHidden[1 - side])) {
+    return;
+  }
+  _paneHidden[side] = hidden;
+  [self relayout];
+  if (hidden) {
+    [self activatePane:side == HeliumDualPaneSideLeft
+                           ? HeliumDualPaneSideRight : HeliumDualPaneSideLeft];
+  }
+}
+
+- (void)scheduleRelayout {
+  if (_relayoutScheduled || _closing) return;
+  _relayoutScheduled = YES;
+  __weak HeliumDualWindowHost* weakSelf = self;
+  CFRunLoopPerformBlock(CFRunLoopGetMain(), kCFRunLoopCommonModes, ^{
+    HeliumDualWindowHost* host = weakSelf;
+    if (!host) return;
+    host->_relayoutScheduled = NO;
+    [host relayout];
+  });
+  CFRunLoopWakeUp(CFRunLoopGetMain());
+}
+
+- (void)relayout {
+  if (_closing) return;
+  if (_layingOut) {
+    // SetBounds can pump native events. Keep a newer ratio/size request.
+    _layoutPending = YES;
+    return;
+  }
+  _layingOut = YES;
+  _layoutPending = NO;
+  NSRect content = _window.contentView.bounds;
+  const BOOL bothPanes = _leftWindow && _rightWindow;
+  // A lone pane extends under the host rail by its extra edge padding so the
+  // strips on both sides of its content look equally wide.
+  const CGFloat hostRailWidth = std::max<CGFloat>(
+      0, _railStyle.width - std::clamp<CGFloat>(_railStyle.paneEdgeInset, 0,
+                                                _railStyle.width / 2));
+  CGFloat leftWidth =
+      std::max<CGFloat>(0, content.size.width - hostRailWidth);
+  if (bothPanes) {
+    CGFloat available =
+        std::max<CGFloat>(0, content.size.width - kDividerWidth);
+    CGFloat minimum = std::min<CGFloat>(kMinimumPaneWidth, available / 2);
+    leftWidth = std::clamp<CGFloat>(std::round(available * _splitRatio),
+                                    minimum, available - minimum);
+  }
+  const BOOL collapsed = bothPanes && (_paneHidden[0] || _paneHidden[1]);
+  if (collapsed) {
+    leftWidth = _paneHidden[0] ? std::min(_hiddenRailWidth[0], content.size.width / 2)
+                              : content.size.width - std::min(_hiddenRailWidth[1], content.size.width / 2);
+  }
+  const CGFloat dividerWidth = collapsed ? 0 : kDividerWidth;
+  _divider.hidden = !bothPanes || collapsed;
+  _divider.frame = NSMakeRect(leftWidth, 0, kDividerWidth, content.size.height);
+  _launchButton.hidden = _rightWindow != nil;
+  const CGFloat buttonY =
+      content.size.height - _railStyle.buttonTop - _railStyle.buttonHeight;
+  const CGFloat buttonWidth =
+      _railStyle.width - 2 * _railStyle.horizontalPadding;
+  _launchButton.frame = NSMakeRect(
+      content.size.width - _railStyle.width + _railStyle.horizontalPadding,
+      buttonY, buttonWidth, _railStyle.buttonHeight);
+  _leftLaunchButton.hidden = _leftWindow != nil;
+  _leftLaunchButton.frame = NSMakeRect(_railStyle.horizontalPadding, buttonY,
+                                       buttonWidth, _railStyle.buttonHeight);
+  NSRect leftRect = NSMakeRect(0, 0, leftWidth, content.size.height);
+  NSRect rightRect = NSMakeRect(
+      leftWidth + dividerWidth, 0,
+      std::max<CGFloat>(0, content.size.width - leftWidth - dividerWidth),
+      content.size.height);
+  if (_rightWindow && !_leftWindow) {
+    rightRect =
+        NSMakeRect(hostRailWidth, 0,
+                   std::max<CGFloat>(0, content.size.width - hostRailWidth),
+                   content.size.height);
+  }
+  NSView* view = _window.contentView;
+  // Record both targets before resizing either window: the adapter can pump
+  // compositor work while it waits to present the two new sizes together.
+  _expectedPaneFrames[0] = [_window convertRectToScreen:
+      [view convertRect:leftRect toView:nil]];
+  _expectedPaneFrames[1] = [_window convertRectToScreen:
+      [view convertRect:rightRect toView:nil]];
+  if ([self.delegate respondsToSelector:
+          @selector(heliumDualWindowHost:setLeftPaneFrame:rightPaneFrame:)]) {
+    [self.delegate heliumDualWindowHost:self
+                      setLeftPaneFrame:_expectedPaneFrames[0]
+                        rightPaneFrame:_expectedPaneFrames[1]];
+  } else {
+    [_leftWindow setFrame:_expectedPaneFrames[0] display:YES];
+    [_rightWindow setFrame:_expectedPaneFrames[1] display:YES];
+  }
+  [_window invalidateCursorRectsForView:_divider];
+  [self updatePaneCorners];
+  [self updateWindowControls];
+  _layingOut = NO;
+  if (_layoutPending) [self scheduleRelayout];
+}
+
+- (NSWindow*)windowControlsPane {
+  return _windowControlsPane;
+}
+
+- (CGFloat)windowCornerRadius {
+  // AppKit's own radius for this window; it differs across macOS versions.
+  SEL selector = NSSelectorFromString(@"_cornerRadius");
+  if ([_window respondsToSelector:selector]) {
+    using Getter = CGFloat (*)(id, SEL);
+    const CGFloat radius = reinterpret_cast<Getter>(
+        [_window methodForSelector:selector])(_window, selector);
+    if (radius > 0 && radius < 64) return radius;
+  }
+  return 16;
+}
+
+// Panes are square borderless children. Clip the corners that meet the host's
+// rounded corners so the shared window keeps its shape.
+- (void)updatePaneCorners {
+  const BOOL fullscreen = (_window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+  const CGFloat radius = fullscreen ? 0 : [self windowCornerRadius];
+  const NSRect host = _window.frame;
+  NSWindow* panes[] = {_leftWindow, _rightWindow};
+  for (size_t side = 0; side < 2; ++side) {
+    NSWindow* pane = panes[side];
+    if (!pane) continue;
+    const NSRect frame = _expectedPaneFrames[side];
+    const BOOL left = std::abs(NSMinX(frame) - NSMinX(host)) < 1;
+    const BOOL right = std::abs(NSMaxX(frame) - NSMaxX(host)) < 1;
+    const BOOL top = std::abs(NSMaxY(frame) - NSMaxY(host)) < 1;
+    const BOOL bottom = std::abs(NSMinY(frame) - NSMinY(host)) < 1;
+    NSView* view = pane.contentView;
+    view.wantsLayer = YES;
+    CALayer* layer = view.layer;
+    // CALayer corners follow the layer's own y direction.
+    const BOOL yDown = layer.geometryFlipped;
+    const CACornerMask topLeft = yDown ? kCALayerMinXMinYCorner : kCALayerMinXMaxYCorner;
+    const CACornerMask topRight = yDown ? kCALayerMaxXMinYCorner : kCALayerMaxXMaxYCorner;
+    const CACornerMask bottomLeft = yDown ? kCALayerMinXMaxYCorner : kCALayerMinXMinYCorner;
+    const CACornerMask bottomRight = yDown ? kCALayerMaxXMaxYCorner : kCALayerMaxXMinYCorner;
+    CACornerMask corners = 0;
+    if (top && left) corners |= topLeft;
+    if (top && right) corners |= topRight;
+    if (bottom && left) corners |= bottomLeft;
+    if (bottom && right) corners |= bottomRight;
+    const CGFloat applied = corners && radius > 0 ? radius : 0;
+    if (layer.cornerRadius != applied || layer.maskedCorners != corners) {
+      layer.cornerRadius = applied;
+      layer.maskedCorners = corners;
+      layer.masksToBounds = applied > 0;
+    }
+    if (applied > 0 && pane.opaque) {
+      pane.opaque = NO;
+      pane.backgroundColor = NSColor.clearColor;
+    }
+  }
+}
+
+- (void)windowControlClose:(id)sender {
+  [_window performClose:sender];
+}
+- (void)windowControlMiniaturize:(id)sender {
+  [_window miniaturize:sender];
+}
+- (void)windowControlZoom:(id)sender {
+  [self toggleFullscreen];
+}
+
+// The host titlebar is hidden under the panes. Show equivalent controls in the
+// left pane, or in the right pane when the left one is absent or collapsed to
+// its rail, at the offsets AppKit uses from the host's own top-left corner.
+- (void)updateWindowControls {
+  const BOOL fullscreen = (_window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+  const BOOL useLeft = _leftWindow && !(_rightWindow && _paneHidden[0]);
+  const size_t side = useLeft ? 0 : 1;
+  NSWindow* target = fullscreen ? nil : (useLeft ? _leftWindow : _rightWindow);
+  const NSWindowButton types[] = {NSWindowCloseButton,
+                                  NSWindowMiniaturizeButton,
+                                  NSWindowZoomButton};
+  for (NSWindowButton type : types) {
+    [_window standardWindowButton:type].hidden = target != nil;
+  }
+  if (target != _windowControlsPane) {
+    for (NSButton* button in _paneWindowButtons) {
+      [button removeFromSuperview];
+    }
+    _paneWindowButtons = nil;
+    _windowControlsPane = target;
+    if (target) {
+      _paneWindowButtons = [NSMutableArray array];
+      const SEL actions[] = {@selector(windowControlClose:),
+                             @selector(windowControlMiniaturize:),
+                             @selector(windowControlZoom:)};
+      for (size_t i = 0; i < 3; ++i) {
+        NSButton* button = [NSWindow standardWindowButton:types[i]
+                                             forStyleMask:_window.styleMask];
+        button.target = self;
+        button.action = actions[i];
+        [target.contentView addSubview:button];
+        [_paneWindowButtons addObject:button];
+      }
+    }
+  }
+  if (!target) return;
+  // Same offsets from the pane's top-left corner as the host's controls have
+  // from the host's.
+  const NSRect hostFrame = _window.frame;
+  const NSRect paneFrame = _expectedPaneFrames[side];
+  for (size_t i = 0; i < _paneWindowButtons.count; ++i) {
+    NSButton* reference = [_window standardWindowButton:types[i]];
+    if (!reference) continue;
+    const NSRect screen = [_window convertRectToScreen:
+        [reference convertRect:reference.bounds toView:nil]];
+    const NSPoint offset = NSMakePoint(NSMinX(screen) - NSMinX(hostFrame),
+                                       NSMaxY(hostFrame) - NSMaxY(screen));
+    const NSRect inPane = NSMakeRect(
+        offset.x, NSHeight(paneFrame) - offset.y - NSHeight(screen),
+        NSWidth(screen), NSHeight(screen));
+    NSView* container = target.contentView;
+    _paneWindowButtons[i].frame = container.isFlipped
+        ? NSMakeRect(NSMinX(inPane), offset.y, NSWidth(inPane), NSHeight(inPane))
+        : inPane;
+  }
+}
+
+- (void)moveDividerToScreenX:(CGFloat)x {
+  NSRect screen =
+      [_window convertRectToScreen:[_window.contentView
+                                       convertRect:_window.contentView.bounds
+                                            toView:nil]];
+  CGFloat available = screen.size.width - kDividerWidth;
+  if (available > 0) {
+    self.splitRatio = (x - screen.origin.x - kDividerWidth / 2) / available;
+  }
+}
+
+- (void)requestRightPane:(id)sender {
+  if (!_rightWindow && !_closing) {
+    if ([self.delegate
+            respondsToSelector:@selector(
+                                   heliumDualWindowHost:didRequestPane:)]) {
+      [self.delegate heliumDualWindowHost:self
+                           didRequestPane:HeliumDualPaneSideRight];
+    } else {
+      [self.delegate heliumDualWindowHostDidRequestRightPane:self];
+    }
+  }
+}
+
+- (void)requestLeftPane:(id)sender {
+  if (!_leftWindow && !_closing &&
+      [self.delegate
+          respondsToSelector:@selector(heliumDualWindowHost:didRequestPane:)]) {
+    [self.delegate heliumDualWindowHost:self
+                         didRequestPane:HeliumDualPaneSideLeft];
+  }
+}
+
+- (void)toggleFullscreen {
+  [self requestFullscreen:!self.fullscreen];
+}
+
+- (BOOL)isFullscreen {
+  return _fullscreenTransition
+             ? _fullscreenTarget
+             : (_window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+}
+
+- (BOOL)fullscreenTransition {
+  return _fullscreenTransition;
+}
+
+- (void)requestFullscreen:(BOOL)fullscreen {
+  if (_closing) {
+    return;
+  }
+  if (_fullscreenTransition) {
+    _hasPendingFullscreenRequest = YES;
+    _pendingFullscreenRequest = fullscreen;
+    return;
+  }
+  _hasPendingFullscreenRequest = NO;
+  if (self.fullscreen != fullscreen) {
+    _fullscreenTransition = YES;
+    _fullscreenTarget = fullscreen;
+    [_window toggleFullScreen:nil];
+  }
+}
+
+- (void)closeAfterBrowserShutdown {
+  NSAssert(!_leftWindow && !_rightWindow,
+           @"Detach both browsers after normal shutdown before closing host");
+  _closing = YES;
+  [_window close];
+}
+
+- (BOOL)windowShouldClose:(NSWindow*)sender {
+  if (_closing) {
+    return YES;
+  }
+  [self.delegate heliumDualWindowHostDidRequestClose:self];
+  return NO;
+}
+
+- (void)captureNormalFrameIfNeeded {
+  if (!_fullscreenTransition && !_window.miniaturized &&
+      (_window.styleMask & NSWindowStyleMaskFullScreen) == 0) {
+    _normalFrame = _window.frame;
+  }
+}
+
+- (void)windowDidResize:(NSNotification*)notification {
+  [self captureNormalFrameIfNeeded];
+  [self relayout];
+  if ([self.delegate
+          respondsToSelector:@selector(heliumDualWindowHostDidChangeFrame:)]) {
+    [self.delegate heliumDualWindowHostDidChangeFrame:self];
+  }
+}
+- (void)windowDidMove:(NSNotification*)notification {
+  [self captureNormalFrameIfNeeded];
+  [self relayout];
+  if ([self.delegate
+          respondsToSelector:@selector(heliumDualWindowHostDidChangeFrame:)]) {
+    [self.delegate heliumDualWindowHostDidChangeFrame:self];
+  }
+}
+- (void)windowDidChangeScreen:(NSNotification*)notification {
+  [self relayout];
+}
+- (void)windowDidBecomeKey:(NSNotification*)notification {
+  // The outer shell has no browser command dispatcher. Window-menu and
+  // titlebar activation must restore focus to this host's last active pane.
+  if (!_closing && !_fullscreenTransition) {
+    [self restoreLastActivePane];
+  }
+}
+
+- (void)windowDidDeminiaturize:(NSNotification*)notification {
+  [self relayout];
+  [self restoreLastActivePane];
+}
+- (void)windowWillEnterFullScreen:(NSNotification*)notification {
+  _normalFrame = _window.frame;
+  [self beginFullscreenTransition:YES];
+}
+- (void)windowWillExitFullScreen:(NSNotification*)notification {
+  [self beginFullscreenTransition:NO];
+}
+
+- (void)beginFullscreenTransition:(BOOL)fullscreen {
+  _fullscreenTransition = YES;
+  _fullscreenTarget = fullscreen;
+  if ([self.delegate
+          respondsToSelector:@selector(
+                                 heliumDualWindowHost:willChangeFullscreen:)]) {
+    [self.delegate heliumDualWindowHost:self willChangeFullscreen:fullscreen];
+  }
+}
+
+- (void)completeFullscreenTransition:(BOOL)fullscreen {
+  // A failed native transition must restore the UI and complete the browser
+  // controllers too, just like NativeWidgetMacNSWindowHost does.
+  if (_fullscreenTarget != fullscreen &&
+      [self.delegate
+          respondsToSelector:@selector(
+                                 heliumDualWindowHost:willChangeFullscreen:)]) {
+    _fullscreenTarget = fullscreen;
+    [self.delegate heliumDualWindowHost:self willChangeFullscreen:fullscreen];
+  }
+  _fullscreenTransition = NO;
+  _fullscreenTarget = fullscreen;
+  [self captureNormalFrameIfNeeded];
+  [self relayout];
+  [self restoreLastActivePane];
+  if ([self.delegate
+          respondsToSelector:@selector(
+                                 heliumDualWindowHost:didChangeFullscreen:)]) {
+    [self.delegate heliumDualWindowHost:self didChangeFullscreen:fullscreen];
+  }
+  if (_hasPendingFullscreenRequest) {
+    __weak HeliumDualWindowHost* weakSelf = self;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      HeliumDualWindowHost* host = weakSelf;
+      if (host && host->_hasPendingFullscreenRequest) {
+        const BOOL pending = host->_pendingFullscreenRequest;
+        host->_hasPendingFullscreenRequest = NO;
+        [host requestFullscreen:pending];
+      }
+    });
+  }
+}
+
+- (void)windowDidEnterFullScreen:(NSNotification*)notification {
+  [self completeFullscreenTransition:YES];
+}
+- (void)windowDidExitFullScreen:(NSNotification*)notification {
+  [self completeFullscreenTransition:NO];
+}
+
+- (void)windowDidFailToEnterFullScreen:(NSWindow*)window {
+  [self completeFullscreenTransition:NO];
+}
+
+- (void)windowDidFailToExitFullScreen:(NSWindow*)window {
+  [self completeFullscreenTransition:YES];
+}
