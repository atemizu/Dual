+}
+- (void)mouseEntered:(NSEvent*)event {
+  _hovered = YES;
+  [self applyCursor];
+  // The key pane can reset the cursor after this enter event while it handles
+  // its own exit. Reassert once after that event has been processed.
+  __weak HeliumDualDividerView* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    HeliumDualDividerView* divider = weakSelf;
+    if (divider && divider->_hovered && !divider.hidden) {
+      [divider applyCursor];
+    }
+  });
+}
+- (void)mouseMoved:(NSEvent*)event {
+  if (_hovered && !self.hidden) {
+    [self applyCursor];
+  }
+}
+- (void)mouseExited:(NSEvent*)event {
+  _hovered = NO;
+  SetCursorIfNeeded(_mousePressed ? NSCursor.closedHandCursor
+                                  : NSCursor.arrowCursor);
+}
+- (void)cancelPendingDrag {
+  [_dragUpdateTimer invalidate];
+  _dragUpdateTimer = nil;
+}
+- (void)dividerDidMove {
+  // No event tells a view that it has moved under the pointer.
+  if (_mousePressed || self.hidden || !self.window || !NSApp.active) return;
+  const NSPoint point =
+      [self convertPoint:[self.window
+                             convertPointFromScreen:NSEvent.mouseLocation]
+                fromView:nil];
+  if (NSPointInRect(point, self.bounds)) {
+    _hovered = YES;
+    [self applyCursor];
+  }
+}
+- (void)dealloc {
+  [NSNotificationCenter.defaultCenter removeObserver:self];
+  [_dragUpdateTimer invalidate];
+  if (_cursorUpdateObserver) {
+    CFRunLoopObserverInvalidate(_cursorUpdateObserver);
+    CFRelease(_cursorUpdateObserver);
+  }
+  if (_mousePressed) {
+    SetCursorIfNeeded(NSCursor.arrowCursor);
+  }
+}
+- (void)endMouseInteraction:(NSEvent*)event {
+  [self cancelPendingDrag];
+  const BOOL wasPressed = _mousePressed;
+  _mousePressed = NO;
+  // A drag may end without a final move (e.g. the app resigns active).
+  if (wasPressed) {
+    [self.host dividerGestureEnded];
+  }
+  _dragging = NO;
+  _doubleClickReset = NO;
+  _timeBasesAgree = NO;
+  if (_cursorUpdateObserver) {
+    CFRunLoopObserverInvalidate(_cursorUpdateObserver);
+    CFRelease(_cursorUpdateObserver);
+    _cursorUpdateObserver = nullptr;
+  }
+  if (wasPressed) {
+    const BOOL overDivider = self.window && !self.hidden && event &&
+        NSPointInRect([self convertPoint:event.locationInWindow fromView:nil],
+                      self.bounds);
+    [self.window invalidateCursorRectsForView:self];
+    SetCursorIfNeeded(overDivider ? NSCursor.resizeLeftRightCursor
+                                   : NSCursor.arrowCursor);
+  }
+}
+- (void)applicationWillResignActive:(NSNotification*)notification {
+  [self endMouseInteraction:nil];
+}
+- (void)windowWillClose:(NSNotification*)notification {
+  if (notification.object == self.window ||
+      notification.object ==
+          [self.host browserWindowForSide:HeliumDualPaneSideLeft] ||
+      notification.object ==
+          [self.host browserWindowForSide:HeliumDualPaneSideRight]) {
+    [self endMouseInteraction:nil];
+  }
+}
+- (void)setHidden:(BOOL)hidden {
+  if (hidden) {
+    _hovered = NO;
+    [self endMouseInteraction:nil];
+  }
+  [super setHidden:hidden];
+}
+- (void)viewWillMoveToWindow:(NSWindow*)newWindow {
+  if (newWindow != self.window) {
+    _hovered = NO;
+    [self endMouseInteraction:nil];
+  }
+  [super viewWillMoveToWindow:newWindow];
+}
+- (BOOL)wasReleasedBeforeDelivery:(NSEvent*)event {
+  // Under a busy main thread, the first down can be dispatched after its up
+  // and a second down. A counter sampled inside mouseDown then already includes
+  // the first up. Compare the original event with the current session's last
+  // up before accepting this gesture. This runs only once per press.
+  CGEventRef cgEvent = event.CGEvent;
+  if (!cgEvent) return NO;
+  const CGEventTimestamp eventTimestamp = CGEventGetTimestamp(cgEvent);
+  if (!eventTimestamp) return NO;
+  const NSTimeInterval eventTime = eventTimestamp / 1e9;
+  if (!std::isfinite(eventTime) ||
+      std::abs(eventTime - event.timestamp) > 0.002) {
+    return NO;
+  }
+  const CFTimeInterval before = CACurrentMediaTime();
+  const CFTimeInterval sinceLastUp = CGEventSourceSecondsSinceLastEventType(
+      kCGEventSourceStateCombinedSessionState, kCGEventLeftMouseUp);
+  const CFTimeInterval sinceLastDown = CGEventSourceSecondsSinceLastEventType(
+      kCGEventSourceStateCombinedSessionState, kCGEventLeftMouseDown);
+  const CFTimeInterval after = CACurrentMediaTime();
+  // Apple's event times and CACurrentMediaTime() share the host time base.
+  // Limit this comparison to recent events and a tightly bracketed query;
+  // fall back to the normal event path if a source supplies odd timestamps.
+  if (!std::isfinite(sinceLastUp) || sinceLastUp < 0 ||
+      !std::isfinite(sinceLastDown) || sinceLastDown < 0 ||
+      after - before > 0.002 || before - eventTime < -0.002 ||
+      after - eventTime > 1.0) {
+    return NO;
+  }
+  // Do not discard a delayed but otherwise ordinary down/drag/up sequence:
+  // its release still needs the mouseUp commit. Retire the old gesture only
+  // when an up and then a newer down both followed this event.
+  return before - sinceLastUp > eventTime + 0.003 &&
+      before - sinceLastDown > eventTime + 0.003 &&
+      before - sinceLastDown > after - sinceLastUp + 0.0001;
+}
+- (void)mouseDown:(NSEvent*)event {
+  [self endMouseInteraction:nil];
+  if (!self.window || self.hidden) return;
+  if ([self wasReleasedBeforeDelivery:event]) return;
+  _downEventTime = event.timestamp;
+  _upCountAtDown = CGEventSourceCounterForEventType(
+      kCGEventSourceStateCombinedSessionState, kCGEventLeftMouseUp);
+  // NSEvent and Quartz timestamps have the same observed clock on supported
+  // macOS systems. Verify it for this press before using their difference to
+  // catch a mouseDown that was dispatched after the physical release.
+  const CFTimeInterval beforeDownQuery = CACurrentMediaTime();
+  const CFTimeInterval sinceLastDown = CGEventSourceSecondsSinceLastEventType(
+      kCGEventSourceStateCombinedSessionState, kCGEventLeftMouseDown);
+  const CFTimeInterval afterDownQuery = CACurrentMediaTime();
+  _timeBasesAgree = std::isfinite(sinceLastDown) && sinceLastDown >= 0 &&
+      afterDownQuery - beforeDownQuery < 0.001 &&
+      std::abs(afterDownQuery - sinceLastDown - _downEventTime) < 0.0005;
+  NSPoint mouse = [self.window convertPointToScreen:event.locationInWindow];
+  _mouseDownScreenX = mouse.x;
+  _doubleClickReset = event.clickCount == 2;
+  // Pressing without moving must already look different from hover. Avoid a
+  // global cursor-stack push that could remain unbalanced if the pane closes.
+  _mousePressed = YES;
+  _lastDragUpdate = 0;
+  // Resizing the hosted windows lets AppKit refresh tracking regions after
+  // mouseDragged: and the layout timer have returned. Reconcile the cursor
+  // after display-cycle work and at busy-loop boundaries, only for this press.
+  // A busy drag may process another batch of timers without going to sleep.
+  // This observer does
+  // not wake the run loop or resize a page, and is removed on every exit path.
+  __weak HeliumDualDividerView* weakSelf = self;
+  _cursorUpdateObserver = CFRunLoopObserverCreateWithHandler(
+      kCFAllocatorDefault,
+      kCFRunLoopBeforeTimers | kCFRunLoopBeforeSources | kCFRunLoopBeforeWaiting,
+      true,
+      std::numeric_limits<CFIndex>::max(),
+      ^(CFRunLoopObserverRef observer, CFRunLoopActivity activity) {
+    HeliumDualDividerView* divider = weakSelf;
+    if (divider && divider->_mousePressed && divider.window && NSApp.active &&
+        NSCursor.currentCursor != NSCursor.closedHandCursor) {
+      SetCursorIfNeeded(NSCursor.closedHandCursor);
+    }
+  });
+  CFRunLoopAddObserver(CFRunLoopGetMain(), _cursorUpdateObserver,
+                       kCFRunLoopCommonModes);
+  [self.window invalidateCursorRectsForView:self];
+  if (_doubleClickReset) {
+    [self.host stageSplitRatio:helium_dual::kDefaultRatio];
+  }
+  // Chromium and Zen splitters measure movement from the initial grab rather
+  // than the resized view. Preserve where within our six-point bar it began.
+  NSPoint center = [self convertPoint:NSMakePoint(NSMidX(self.bounds),
+                                                 NSMidY(self.bounds))
+                               toView:nil];
+  _grabOffsetX = mouse.x - [self.window convertPointToScreen:center].x;
+  SetCursorIfNeeded(NSCursor.closedHandCursor);
+}
+- (void)mouseDragged:(NSEvent*)event {
+  if (!_mousePressed || !self.window) return;
+  _dragging = YES;
+  SetCursorIfNeeded(NSCursor.closedHandCursor);
+  if (_dragUpdateTimer) return;
+
+  // Apply the first movement immediately. Throttle only the remainder of the
+  // display interval, rather than adding a full interval after every event.
+  const NSInteger fps = std::clamp<NSInteger>(
+      self.window.screen.maximumFramesPerSecond ?: 60, 30, 120);
+  const CFTimeInterval delay =
+      std::max(0.0, _lastDragUpdate + 1.0 / fps - CACurrentMediaTime());
+  if (delay == 0) {
+    [self applyPendingDrag];
+    return;
+  }
+  __weak HeliumDualDividerView* weakSelf = self;
+  _dragUpdateTimer = [NSTimer timerWithTimeInterval:delay repeats:NO
+      block:^(NSTimer* timer) {
+    HeliumDualDividerView* divider = weakSelf;
+    if (!divider) return;
+    divider->_dragUpdateTimer = nil;
+    [divider applyPendingDrag];
+  }];
+  [NSRunLoop.mainRunLoop addTimer:_dragUpdateTimer forMode:NSRunLoopCommonModes];
+}
+- (void)applyPendingDrag {
+  if (!_dragging || !self.window) return;
+  // A queued drag can run after the physical release but before mouseUp is
+  // dispatched. Do not apply the cursor's post-release position as a drag.
+  // mouseUp still commits the release event's exact position below.
+  if ((NSEvent.pressedMouseButtons & 1) == 0) return;
+  // A newer press can make the global button bit true again before this
+  // press's mouseUp is dispatched. Session-wide release counts identify that
+  // boundary without relying on current button state or event delivery order.
+  if (CGEventSourceCounterForEventType(
+          kCGEventSourceStateCombinedSessionState, kCGEventLeftMouseUp) !=
+      _upCountAtDown) {
+    return;
+  }
+  // If mouseDown itself arrived after the release, its counter snapshot was
+  // already advanced. Use the calibrated event clock as a secondary guard.
+  if (_timeBasesAgree) {
+    const CFTimeInterval beforeQuery = CACurrentMediaTime();
+    const CFTimeInterval sinceLastUp = CGEventSourceSecondsSinceLastEventType(
+        kCGEventSourceStateCombinedSessionState, kCGEventLeftMouseUp);
+    if (std::isfinite(sinceLastUp) && sinceLastUp >= 0 &&
+        beforeQuery - sinceLastUp > _downEventTime + 0.001) {
+      return;
+    }
+  }
+  // Sample the current screen position only when this update actually
+  // begins, so queued drag events do not replay stale coordinates after a
+  // busy main thread catches up.
+  _lastDragUpdate = CACurrentMediaTime();
+  [self.host moveDividerToScreenX:NSEvent.mouseLocation.x - _grabOffsetX];
+  if (_mousePressed && self.window) SetCursorIfNeeded(NSCursor.closedHandCursor);
+}
+- (void)mouseUp:(NSEvent*)event {
+  [self cancelPendingDrag];
+  if (!self.window) {
+    [self endMouseInteraction:event];
+    return;
+  }
+  NSPoint screen = [self.window convertPointToScreen:event.locationInWindow];
+  // A very fast second drag may be coalesced into the first gesture before
+  // its down callback arrives. Commit the release even without a delivered
+  // mouseDragged:, but retain the no-drag double-click recentering behavior.
+  const BOOL movedWithoutDrag = !_doubleClickReset &&
+      std::abs(screen.x - _mouseDownScreenX) > 2;
+  if (_mousePressed && (_dragging || movedWithoutDrag)) {
+    _dragging = NO;
+    [self.host moveDividerToScreenX:screen.x - _grabOffsetX];
+  }
+  [self endMouseInteraction:event];
+}
+- (BOOL)acceptsFirstMouse:(NSEvent*)event {
+  return YES;
+}
+@end
