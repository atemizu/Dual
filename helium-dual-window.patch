+
+namespace {
+
+// Exercise the real database lifecycle with a manually delayed test encryptor.
+// This never requests a platform key or changes the production encryption path.
+class DelayedTestOSCryptAsync : public os_crypt_async::OSCryptAsync {
+ public:
+  DelayedTestOSCryptAsync() : OSCryptAsync({}) {}
+
+  void GetInstance(InitCallback callback) override {
+    callbacks_.push_back(std::move(callback));
+  }
+
+  size_t pending_callbacks() const { return callbacks_.size(); }
+
+  void Release() {
+    auto encryptor = os_crypt_async::GetTestEncryptorForTesting();
+    auto callbacks = std::move(callbacks_);
+    for (auto& callback : callbacks) {
+      std::move(callback).Run(encryptor);
+    }
+  }
+
+ private:
+  std::vector<InitCallback> callbacks_;
+};
+
+class KeywordsConsumer : public WebDataServiceConsumer {
+ public:
+  void OnWebDataServiceRequestDone(
+      WebDataServiceBase::Handle,
+      std::unique_ptr<WDTypedResult> result) override {
+    result_ = std::move(result);
+  }
+
+  std::unique_ptr<WDTypedResult> result_;
+};
+
+class HeliumDualWebDataShutdownTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  scoped_refptr<WebDatabaseService> CreateDatabase() {
+    auto runner = base::SequencedTaskRunner::GetCurrentDefault();
+    auto database = base::MakeRefCounted<WebDatabaseService>(
+        base::FilePath(WebDatabase::kInMemoryPath), runner, runner);
+    database->AddTable(std::make_unique<KeywordTable>());
+    return database;
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::MainThreadType::UI};
+  base::ScopedTempDir temp_dir_;
+};
+
+TEST_F(HeliumDualWebDataShutdownTest,
+       ShutdownDoesNotOvertakePendingInitializationAndCleanup) {
+  DelayedTestOSCryptAsync os_crypt;
+  auto database = CreateDatabase();
+  database->LoadDatabase(&os_crypt);
+  std::vector<int> events;
+  database->GetDbSequence()->PostTask(
+      FROM_HERE, base::BindLambdaForTesting([&] {
+        ASSERT_NE(nullptr, database->GetDatabaseOnDB());
+        events.push_back(1);
+      }));
+  // Match the sync-bridge cleanup posted before the wrapper closes its DB.
+  database->GetDbSequence()->PostTask(
+      FROM_HERE, base::BindLambdaForTesting([&] {
+        ASSERT_NE(nullptr, database->GetDatabaseOnDB());
+        events.push_back(2);
+      }));
+  database->ShutdownDatabase();
+
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1u, os_crypt.pending_callbacks());
+  EXPECT_TRUE(events.empty());
+  EXPECT_EQ(nullptr, database->GetDatabaseOnDB());
+
+  os_crypt.Release();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ((std::vector<int>{1, 2}), events);
+  EXPECT_EQ(nullptr, database->GetDatabaseOnDB());
+  // No later task reopens a DB after the actual shutdown has run.
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(nullptr, database->GetDatabaseOnDB());
+}
+
+TEST_F(HeliumDualWebDataShutdownTest,
+       WrapperShutdownWhileEncryptorPendingFlushesAcceptedWrite) {
+  DelayedTestOSCryptAsync os_crypt;
+  auto wrapper = std::make_unique<WebDataServiceWrapper>(
+      temp_dir_.GetPath(), "en_US", task_environment_.GetMainThreadTaskRunner(),
+      base::DoNothing(), &os_crypt);
+  TemplateURLData keyword;
+  keyword.SetShortName(u"Pending shutdown regression");
+  keyword.SetKeyword(u"helium-dual-regression");
+  keyword.SetURL("https://example.invalid/?q={searchTerms}");
+  keyword.id = 1234;
+  wrapper->GetKeywordWebData()->AddKeyword(keyword);
+  wrapper->Shutdown();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(2u, os_crypt.pending_callbacks());
+
+  os_crypt.Release();
+  task_environment_.RunUntilIdle();
+  wrapper.reset();
+  task_environment_.RunUntilIdle();
+
+  // Reopen the real temporary SQLite DB and verify the queued write survived.
+  auto ready_crypt = os_crypt_async::GetTestOSCryptAsyncForTesting(true);
+  wrapper = std::make_unique<WebDataServiceWrapper>(
+      temp_dir_.GetPath(), "en_US", task_environment_.GetMainThreadTaskRunner(),
+      base::DoNothing(), ready_crypt.get());
+  KeywordsConsumer consumer;
+  wrapper->GetKeywordWebData()->GetKeywords(&consumer);
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(consumer.result_);
+  ASSERT_EQ(KEYWORDS_RESULT, consumer.result_->GetType());
+  const auto& result =
+      static_cast<const WDResult<WDKeywordsResult>*>(consumer.result_.get())
+          ->GetValue();
+  ASSERT_EQ(1u, result.keywords.size());
+  EXPECT_EQ(keyword.id, result.keywords[0].id);
+  EXPECT_EQ(keyword.keyword(), result.keywords[0].keyword());
+  wrapper->Shutdown();
+  task_environment_.RunUntilIdle();
+}
+
+TEST_F(HeliumDualWebDataShutdownTest,
+       MissingDatabaseReportsWalletUsageModelError) {
+  auto os_crypt = os_crypt_async::GetTestOSCryptAsyncForTesting(true);
+  auto database = CreateDatabase();
+  database->LoadDatabase(os_crypt.get());
+  auto autofill = base::MakeRefCounted<autofill::AutofillWebDataService>(
+      database, task_environment_.GetMainThreadTaskRunner());
+  task_environment_.RunUntilIdle();
+  autofill->ShutdownOnUISequence();
+  database->ShutdownDatabase();
+  task_environment_.RunUntilIdle();
+  ASSERT_EQ(nullptr, database->GetDatabaseOnDB());
+
+  bool reported_error = false;
+  // Construct only the bridge under test with an actual closed backend. This
+  // verifies its existing ModelError path without weakening the table CHECK.
+  autofill->GetAutofillBackend(base::BindLambdaForTesting(
+      [&](autofill::AutofillWebDataBackend* backend) {
+        auto processor =
+            std::make_unique<syncer::ClientTagBasedDataTypeProcessor>(
+                syncer::AUTOFILL_WALLET_USAGE, base::DoNothing());
+        auto* processor_ptr = processor.get();
+        autofill::AutofillWalletUsageDataSyncBridge bridge(std::move(processor),
+                                                           backend);
+        auto error = processor_ptr->GetError();
+        ASSERT_TRUE(error.has_value());
+        EXPECT_EQ(syncer::ModelError::Type::
+                      kAutofillWalletUsageFailedToLoadAutofillTable,
+                  error->type());
+        EXPECT_FALSE(processor_ptr->IsTrackingMetadata());
+        reported_error = true;
+      }));
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(reported_error);
+}
+
+}  // namespace
