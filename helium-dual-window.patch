+// Copyright 2026 Dual contributors.
+// Created for Dual 6.2.2 (2026-09-08 to 2026-09-25). Licensed under GPL-3.0;
+// see the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_DUAL_STATE_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_DUAL_STATE_H_
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <map>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/uuid.h"
+#include "chrome/browser/ui/helium/helium_dual_limits.h"
+
+enum class HeliumDualRole { kNone, kLeft, kRight };
+
+struct HeliumDualState {
+  std::string group_id;
+  HeliumDualRole role = HeliumDualRole::kNone;
+  double ratio = 0.5;
+  // NSStringFromRect representation, validated by the macOS coordinator.
+  std::string host_bounds;
+};
+
+namespace helium_dual {
+
+// Window extra data keeps Chromium's own per-window tab/navigation storage.
+inline constexpr char kGroupIdKey[] = "helium.dual.group_id";
+inline constexpr char kRoleKey[] = "helium.dual.role";
+inline constexpr char kRatioKey[] = "helium.dual.ratio";
+inline constexpr char kHostBoundsKey[] = "helium.dual.host_bounds";
+inline constexpr size_t kMaxHostBoundsBytes = 256;
+
+inline constexpr bool IsPane(HeliumDualRole role) {
+  return role == HeliumDualRole::kLeft || role == HeliumDualRole::kRight;
+}
+
+inline double ClampRatio(double ratio) {
+  return std::isfinite(ratio) ? std::clamp(ratio, kMinRatio, kMaxRatio)
+                              : kDefaultRatio;
+}
+
+inline std::string RoleName(HeliumDualRole role) {
+  switch (role) {
+    case HeliumDualRole::kLeft:
+      return "left";
+    case HeliumDualRole::kRight:
+      return "right";
+    case HeliumDualRole::kNone:
+      return {};
+  }
+  return {};
+}
+
+inline HeliumDualState ReadExtraData(
+    const std::map<std::string, std::string>& data) {
+  HeliumDualState state;
+  const auto group = data.find(kGroupIdKey);
+  const auto role = data.find(kRoleKey);
+  if (group == data.end() || role == data.end()) {
+    return state;
+  }
+  const base::Uuid group_uuid = base::Uuid::ParseCaseInsensitive(group->second);
+  if (!group_uuid.is_valid()) {
+    return state;
+  }
+  if (role->second == "left") {
+    state.role = HeliumDualRole::kLeft;
+  } else if (role->second == "right") {
+    state.role = HeliumDualRole::kRight;
+  } else {
+    return state;
+  }
+  state.group_id = group_uuid.AsLowercaseString();
+  const auto ratio = data.find(kRatioKey);
+  double parsed_ratio = kDefaultRatio;
+  if (ratio != data.end() &&
+      base::StringToDouble(ratio->second, &parsed_ratio)) {
+    state.ratio = ClampRatio(parsed_ratio);
+  }
+  const auto bounds = data.find(kHostBoundsKey);
+  if (bounds != data.end() && bounds->second.size() <= kMaxHostBoundsBytes) {
+    state.host_bounds = bounds->second;
+  }
+  return state;
+}
+
+inline std::map<std::string, std::string> MakeExtraData(
+    std::string_view group_id,
+    HeliumDualRole role,
+    double ratio,
+    std::string_view host_bounds = {}) {
+  const base::Uuid group_uuid = base::Uuid::ParseCaseInsensitive(group_id);
+  if (!IsPane(role) || !group_uuid.is_valid()) {
+    return {};
+  }
+  std::map<std::string, std::string> data = {
+      {kGroupIdKey, group_uuid.AsLowercaseString()},
+      {kRoleKey, RoleName(role)},
+      {kRatioKey, base::NumberToString(ClampRatio(ratio))}};
+  if (!host_bounds.empty() && host_bounds.size() <= kMaxHostBoundsBytes) {
+    data[kHostBoundsKey] = host_bounds;
+  }
+  return data;
+}
+
+inline std::map<std::string, std::string> MakeExtraData(
+    const HeliumDualState& state) {
+  return MakeExtraData(state.group_id, state.role, state.ratio,
+                       state.host_bounds);
+}
+
+}  // namespace helium_dual
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_DUAL_STATE_H_
