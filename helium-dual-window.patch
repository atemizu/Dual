+ProfileMap& Pairs() {
+  static base::NoDestructor<ProfileMap> pairs;
+  return *pairs;
+}
+
+struct RestoreRemap {
+  std::string replacement;
+  base::TimeTicks expires;
+};
+
+std::map<Profile*, std::map<std::string, RestoreRemap>>& RestoreRemaps() {
+  static base::NoDestructor<
+      std::map<Profile*, std::map<std::string, RestoreRemap>>>
+      remaps;
+  return *remaps;
+}
+
+size_t SideIndex(HeliumDualRole role) {
+  return role == HeliumDualRole::kRight ? 1 : 0;
+}
+
+HeliumDualPaneSide NativeSide(HeliumDualRole role) {
+  return role == HeliumDualRole::kRight ? HeliumDualPaneSideRight
+                                        : HeliumDualPaneSideLeft;
+}
+
+// BrowserView deliberately rejects whole-window GetViewByElementId calls.
+// A Browser can register both horizontal and vertical regions with this ID;
+// select the vertical region in this Browser's context even before it is shown.
+VerticalTabStripRegionView* GetPaneRail(Browser* browser) {
+  auto* elements = BrowserElementsViews::From(browser);
+  if (!elements || !elements->GetContext()) {
+    return nullptr;
+  }
+  for (auto* view : elements->GetAllViews(kTabStripRegionElementId,
+                                          /*require_visible=*/false)) {
+    if (auto* rail = views::AsViewClass<VerticalTabStripRegionView>(view)) {
+      return rail;
+    }
+  }
+  return nullptr;
+}
+
+bool ValidFrame(NSRect frame) {
+  return std::isfinite(frame.origin.x) && std::isfinite(frame.origin.y) &&
+         std::isfinite(frame.size.width) && std::isfinite(frame.size.height) &&
+         frame.size.width >= 406 && frame.size.width <= 20000 &&
+         frame.size.height >= 360 && frame.size.height <= 20000;
+}
+}  // namespace
+
+// Owns the common surrounding window; BrowserManagerService retains ownership
+// of each Browser and each BrowserView retains its normal BrowserWidget.
+class BrowserPair : public views::WidgetObserver, public views::ViewObserver {
+ public:
+  BrowserPair(Profile* profile, std::string group_id, BrowserView* first)
+      : profile_(profile), group_id_(std::move(group_id)) {
+    NSWindow* pane = first->GetNativeWindow().GetNativeNSWindow();
+    NSRect frame = pane.frame;
+    const std::string& saved = first->browser()->helium_dual_host_bounds();
+    if (!saved.empty()) {
+      NSRect restored = NSRectFromString(base::SysUTF8ToNSString(saved));
+      if (ValidFrame(restored)) {
+        frame = restored;
+      }
+    }
+    NSScreen* screen = pane.screen ?: NSScreen.mainScreen;
+    NSRect visible = screen.visibleFrame;
+    if (!ValidFrame(frame)) {
+      frame = NSMakeRect(visible.origin.x + 30, visible.origin.y + 30,
+                         std::min<CGFloat>(1440, visible.size.width - 60),
+                         std::min<CGFloat>(900, visible.size.height - 60));
+    }
+    // Keep restored hosts reachable if an external display was disconnected.
+    bool on_screen = false;
+    for (NSScreen* candidate in NSScreen.screens) {
+      if (NSIntersectsRect(frame, candidate.visibleFrame)) {
+        on_screen = true;
+        break;
+      }
+    }
+    if (!on_screen) {
+      frame.origin = NSMakePoint(visible.origin.x + 20, visible.origin.y + 20);
+    }
+    host_ = [[HeliumDualWindowHost alloc] initWithContentRect:frame
+                                                        title:@"Helium Dual"];
+    // Saved data is the outer frame, whereas initialization takes content.
+    [host_.window setFrame:frame display:NO];
+    host_.splitRatio = first->browser()->helium_dual_ratio();
+    delegate_ = [[HeliumDualBrowserDelegate alloc] init];
+    delegate_.pair = this;
+    host_.delegate = delegate_;
+  }
+
+  ~BrowserPair() override {
+    widget_observations_.RemoveAllObservations();
+    rail_observations_.RemoveAllObservations();
+    delegate_.pair = nullptr;
+    host_.delegate = nil;
+  }
+
+  void Attach(BrowserView* view) {
+    Browser* browser = view->browser();
+    const size_t side = SideIndex(browser->helium_dual_role());
+    if (browsers_[side] == browser) {
+      return;
+    }
+    // Restoration can create a window with stale grouping information while
+    // the old one is still open. Never replace or destroy an occupied pane.
+    CHECK(!browsers_[side]);
+    browsers_[side] = browser;
+    close_subscriptions_[side] =
+        browser->RegisterBrowserCloseCancelled(base::BindRepeating(
+            &BrowserPair::OnCloseCancelled, base::Unretained(this)));
+    [host_ attachBrowserWindow:view->GetNativeWindow().GetNativeNSWindow()
+                          side:NativeSide(browser->helium_dual_role())];
+    widget_observations_.AddObservation(view->GetWidget());
+    paint_subscriptions_[side] =
+        view->GetWidget()->RegisterPaintAsActiveChangedCallback(
+            base::BindRepeating(&BrowserPair::ScheduleRailStyle,
+                                base::Unretained(this)));
+    if (auto* rail = GetPaneRail(browser)) {
+      rail_observations_.AddObservation(rail);
+    }
+    UpdateRailStyle();
+    ScheduleSave();
+  }
+
+  // Use the actual pane's resolved theme, including explicit light/dark mode
+  // and custom theme colors. NSColor's system defaults cannot represent them.
+  void UpdateRailStyle() {
+    Browser* browser = browsers_[host_.activePane == HeliumDualPaneSideRight];
+    if (!browser) {
+      browser = browsers_[0] ? browsers_[0].get() : browsers_[1].get();
+    }
+    if (!browser) {
+      return;
+    }
+    BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser);
+    if (!view || !view->GetWidget() || !view->GetColorProvider()) {
+      return;
+    }
+    const ui::ColorProvider* colors = view->GetColorProvider();
+    auto color = [colors](ui::ColorId id) {
+      const SkColor value = colors->GetColor(id);
+      return [NSColor colorWithSRGBRed:SkColorGetR(value) / 255.0
+                                 green:SkColorGetG(value) / 255.0
+                                  blue:SkColorGetB(value) / 255.0
+                                 alpha:SkColorGetA(value) / 255.0];
+    };
+    HeliumDualRailStyle* style = [[HeliumDualRailStyle alloc] init];
+    style.width = VerticalTabStripRegionView::kCollapsedWidth;
+    style.buttonHeight = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+    style.horizontalPadding =
+        GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+    style.cornerRadius =
+        GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius);
+    // An empty strip has no tab rows; its new-tab button follows the same
+    // two-DIP bottom-container gap below the start of the real tab region.
+    if (auto* rail = GetPaneRail(browser);
+        rail && rail->GetVisible()) {
+      const gfx::Rect pane = gfx::ScreenRectFromNSRect(
+          view->GetNativeWindow().GetNativeNSWindow().frame);
+      style.buttonTop =
+          std::max(0, rail->GetBoundsInScreen().y() - pane.y()) + 2;
+    }
+    style.backgroundColor = color(kColorToolbar);
+    style.buttonColor = color(view->GetWidget()->ShouldPaintAsActive()
+                                  ? kColorTabBackgroundInactiveFrameActive
+                                  : kColorTabBackgroundInactiveFrameInactive);
+    style.hoverColor = color(kColorTabBackgroundInactiveHoverFrameActive);
+    style.pressedColor = color(kColorTabBackgroundActiveFrameActive);
+    style.separatorColor = color(kColorToolbarContentAreaSeparator);
+    // These are the same icon selection and size as BrowserActions and
+    // VerticalNewTabButton; avoid a font-dependent full-width plus glyph.
+    style.icon = gfx::NSImageFromImageSkia(gfx::CreateVectorIcon(
+        features::IsRoundedIconsEnabled() ? vector_icons::kAddWeight500Icon
+                                          : vector_icons::kAddOldIcon,
+        16, colors->GetColor(kColorToolbarButtonIconDisabled)));
+    const ui::ThemeProvider* theme = view->GetThemeProvider();
+    if (theme && theme->HasCustomImage(IDR_THEME_TOOLBAR)) {
+      // Helium's FrameTheme uses the toolbar image with repeat-X/mirror-Y.
+      // Rasterize only the narrow rail, at the native backing scale.
+      const float scale = host_.window.backingScaleFactor;
+      const gfx::Size size(style.width,
+                           NSHeight(host_.window.contentView.bounds));
+      gfx::Canvas canvas(size, scale, false);
+      canvas.DrawColor(colors->GetColor(kColorToolbar));
+      canvas.TileImageInt(*theme->GetImageSkiaNamed(IDR_THEME_TOOLBAR), 0,
+                          ThemeProperties::kFrameHeightAboveTabs +
+                              view->theme_background_y_offset().value_or(0),
+                          0, 0, size.width(), size.height(), 1.0f,
+                          SkTileMode::kRepeat, SkTileMode::kMirror);
+      style.backgroundImage = gfx::NSImageFromImageSkia(
+          gfx::ImageSkia(gfx::ImageSkiaRep(canvas.GetBitmap(), scale)));
+    }
+    [host_ applyRailStyle:style];
+  }
+
+  void ScheduleRailStyle() {
+    if (!rail_style_timer_.IsRunning()) {
+      rail_style_timer_.Start(FROM_HERE, base::TimeDelta(), this,
+                              &BrowserPair::UpdateRailStyle);
+    }
+  }
+
+  void OnWidgetThemeChanged(views::Widget* widget) override {
+    ScheduleRailStyle();
+  }
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& bounds) override {
+    ScheduleRailStyle();
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    widget_observations_.RemoveObservation(widget);
+  }
+  void OnViewBoundsChanged(views::View* view) override { ScheduleRailStyle(); }
+  void OnViewIsDeleting(views::View* view) override {
+    rail_observations_.RemoveObservation(view);
+  }
+
+  void Show(BrowserView* view, bool activate) {
+    [host_ showAndActivate:NO];
+    if (activate) {
+      [host_ activatePane:NativeSide(view->browser()->helium_dual_role())];
+    }
+  }
+
+  void Detach(BrowserView* view) {
+    Save();
+    Browser* browser = view->browser();
+    size_t side = SideIndex(browser->helium_dual_role());
+    if (browsers_[side] != browser) {
+      return;
+    }
+    if (widget_observations_.IsObservingSource(view->GetWidget())) {
+      widget_observations_.RemoveObservation(view->GetWidget());
+    }
+    if (auto* rail = GetPaneRail(browser);
+        rail && rail_observations_.IsObservingSource(rail)) {
+      rail_observations_.RemoveObservation(rail);
+    }
+    paint_subscriptions_[side] = {};
+    [host_ detachBrowserWindow:view->GetNativeWindow().GetNativeNSWindow()];
+    close_subscriptions_[side] = {};
+    browsers_[side] = nullptr;
+    drag_suspended_[side] = false;
+    ScheduleRailStyle();
+    if (closing_ && !committing_close_ &&
+        (!waiting_side_ || *waiting_side_ == side)) {
+      CancelClose();
+    }
+    if (!browsers_[0] && !browsers_[1]) {
+      retired_ = true;
+      save_timer_.Stop();
+      [host_ closeAfterBrowserShutdown];
+      // Avoid destruction during a native delegate callback or Widget event.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](Profile* profile, std::string id) {
+                auto p = Pairs().find(profile);
+                if (p == Pairs().end()) {
+                  return;
+                }
+                auto pair = p->second.find(id);
+                if (pair != p->second.end() && pair->second->empty()) {
+                  p->second.erase(pair);
+                }
+                if (p->second.empty()) {
+                  RestoreRemaps().erase(profile);
+                  Pairs().erase(p);
+                }
+              },
+              profile_.get(), group_id_));
+    } else {
+      ScheduleSave();
+    }
+  }
+
+  bool IsPaneSuspended(const BrowserView* view) const {
+    return drag_suspended_[SideIndex(view->browser()->helium_dual_role())];
+  }
+
+  bool SuspendPaneForDrag(BrowserView* view) {
+    const size_t side = SideIndex(view->browser()->helium_dual_role());
+    if (drag_suspended_[side]) {
+      return true;
+    }
+    if (closing_) {
+      return false;
+    }
+    Save();
+    NSWindow* pane = view->GetNativeWindow().GetNativeNSWindow();
+    drag_pane_frames_[side] = pane.frame;
+    drag_suspended_[side] = true;
+    [host_ detachBrowserWindow:pane];
+    // An empty host is retained for Esc, but must not cover drop targets.
+    if (![host_ browserWindowForSide:HeliumDualPaneSideLeft] &&
+        ![host_ browserWindowForSide:HeliumDualPaneSideRight]) {
+      [host_.window orderOut:nil];
+    }
+    return true;
+  }
+
+  // Returns true when the pane remains in this pair. A completed tear-off
+  // from a pair with another live pane instead receives a fresh host below.
+  bool ResumePaneAfterDrag(BrowserView* view, bool canceled) {
+    const size_t side = SideIndex(view->browser()->helium_dual_role());
+    if (!drag_suspended_[side]) {
+      return true;
+    }
+    drag_suspended_[side] = false;
+    if (!canceled && browsers_[1 - side]) {
+      return false;
+    }
+    NSWindow* pane = view->GetNativeWindow().GetNativeNSWindow();
+    if (!canceled) {
+      const NSRect original = drag_pane_frames_[side];
+      const NSRect current = pane.frame;
+      const NSPoint origin = host_.window.frame.origin;
+      [host_.window setFrameOrigin:
+          NSMakePoint(origin.x + current.origin.x - original.origin.x,
+                      origin.y + current.origin.y - original.origin.y)];
+    }
+    [host_ attachBrowserWindow:pane
+                          side:NativeSide(view->browser()->helium_dual_role())];
+    [host_ showAndActivate:NO];
+    [host_ activatePane:NativeSide(view->browser()->helium_dual_role())];
+    ScheduleRailStyle();
+    ScheduleSave();
+    return true;
+  }
+
+  bool empty() const { return !browsers_[0] && !browsers_[1]; }
+  bool retired() const { return retired_; }
+  bool creating_pane() const { return creating_pane_; }
+  Browser* browser_at(size_t side) const { return browsers_[side]; }
+  HeliumDualWindowHost* host() const { return host_; }
+
+  void RequestPane(HeliumDualPaneSide side) {
+    const size_t index = side == HeliumDualPaneSideRight ? 1 : 0;
+    if (closing_ || browsers_[index] || creating_pane_) {
+      return;
+    }
+    // Both profiles remain shared, exactly as two ordinary browser windows.
+    // The Browser/tab model/navigation controller are independent.
+    if (Browser::GetCreationStatusForProfile(profile_) !=
+        BrowserWindowInterface::CreationStatus::kOk) {
+      return;
+    }
+    creating_pane_ = true;
+    Browser::CreateParams params(Browser::TYPE_NORMAL, profile_, true);
+    params.should_trigger_session_restore = false;
+    params.helium_dual_group_id = group_id_;
+    params.helium_dual_role =
+        index ? HeliumDualRole::kRight : HeliumDualRole::kLeft;
+    params.helium_dual_ratio = host_.splitRatio;
+    params.helium_dual_host_bounds =
+        base::SysNSStringToUTF8(NSStringFromRect(host_.normalFrame));
+    params.vertical_tab_strip_collapsed = true;
+    Browser* created = Browser::Create(params);
+    chrome::AddAndReturnTabAt(created, GURL(), -1, true);
+    created->GetWindow()->Show();
+    if (auto* view = BrowserView::GetBrowserViewForBrowser(created)) {
+      view->SetFocusToLocationBar(true);
+    }
+    creating_pane_ = false;
+  }
+
+  void Activated(HeliumDualPaneSide side) {
+    Browser* browser = browsers_[side == HeliumDualPaneSideRight ? 1 : 0];
+    if (browser) {
+      browser->DidBecomeActive();
+    }
+  }
+
+  void FullscreenChanging(bool fullscreen) {
+    for (Browser* browser : browsers_) {
+      if (browser) {
+        if (auto* view = BrowserView::GetBrowserViewForBrowser(browser)) {
+          view->PrepareForHeliumDualFullscreen(fullscreen);
+        }
+      }
+    }
+  }
+
+  void SetBounds(const gfx::Rect& bounds) {
+    if (host_.fullscreen || host_.fullscreenTransition) {
+      pending_bounds_ = bounds;
+      [host_ requestFullscreen:NO];
+      return;
+    }
+    NSRect frame = gfx::ScreenRectToNSRect(bounds);
+    const NSSize minimum =
+        [host_.window
+            frameRectForContentRect:NSMakeRect(
+                                        0, 0, host_.window.contentMinSize.width,
+                                        host_.window.contentMinSize.height)]
+            .size;
+    frame.size.width = std::max(frame.size.width, minimum.width);
+    frame.size.height = std::max(frame.size.height, minimum.height);
+    [host_.window setFrame:frame display:YES];
+    [host_ relayout];
+    ScheduleSave();
+  }
+
+  void Restore() {
+    if (host_.fullscreen || host_.fullscreenTransition) {
+      pending_restore_ = true;
+      [host_ requestFullscreen:NO];
+    } else if (host_.window.zoomed) {
+      [host_.window zoom:nil];
+    }
+    [host_ showAndActivate:YES];
+  }
+
+  void FullscreenChanged() {
+    if (!host_.fullscreen && pending_restore_) {
+      pending_restore_ = false;
+      if (host_.window.zoomed) {
+        [host_.window zoom:nil];
+      }
+    }
+    if (!host_.fullscreen && pending_bounds_) {
+      const gfx::Rect bounds = *pending_bounds_;
+      pending_bounds_.reset();
+      SetBounds(bounds);
+    }
+    for (Browser* browser : browsers_) {
+      if (browser) {
+        if (auto* view = BrowserView::GetBrowserViewForBrowser(browser)) {
+          view->FullscreenStateChanged();
+        }
+      }
+    }
+    ScheduleSave();
+  }
+
+  void ScheduleSave() {
+    UpdateLiveGeometry();
+    save_timer_.Start(FROM_HERE, base::Milliseconds(200), this,
+                      &BrowserPair::Save);
+  }
+
+  void UpdateLiveGeometry() {
+    std::string bounds =
+        base::SysNSStringToUTF8(NSStringFromRect(host_.normalFrame));
+    for (Browser* browser : browsers_) {
+      if (browser) {
+        browser->set_helium_dual_ratio(host_.splitRatio);
+        browser->set_helium_dual_host_bounds(bounds);
+      }
+    }
+  }
+
+  void Save() {
+    UpdateLiveGeometry();
+    for (Browser* browser : browsers_) {
+      if (!browser) {
+        continue;
+      }
+      if (SessionService* service =
+              SessionServiceFactory::GetForProfile(browser->GetProfile())) {
+        const auto data = MakeExtraData(group_id_, browser->helium_dual_role(),
+                                        browser->helium_dual_ratio(),
+                                        browser->helium_dual_host_bounds());
+        for (const auto& [key, value] : data) {
+          service->AddWindowExtraData(browser->session_id(), key.c_str(),
+                                      value);
+        }
+      }
+    }
+  }
+
+  void RequestClose() {
+    if (closing_) {
+      return;
+    }
+    Save();
+    closing_ = true;
+    PreflightWarnings(0);
+  }
+
+ private:
+  void OnCloseCancelled(BrowserWindowInterface*,
+                        BrowserWindowInterface::ClosingStatus status) {
+    // Chromium also emits this notification while accepted unload handlers
+    // finish asynchronously. That is progress, not a rejected close.
+    if (committing_close_ &&
+        (status == BrowserWindowInterface::ClosingStatus::kDeniedByUser ||
+         status == BrowserWindowInterface::ClosingStatus::kDeniedByPolicy)) {
+      CancelClose();
+    }
+  }
+
+  void CancelClose() {
+    if (!prepared_session_ids_.empty()) {
+      if (SessionService* service =
+              SessionServiceFactory::GetForProfile(profile_)) {
+        service->CancelWindowCloseGroup(prepared_session_ids_);
+      }
+      prepared_session_ids_.clear();
+    }
+    closing_ = false;
+    committing_close_ = false;
+    waiting_side_.reset();
+    weak_factory_.InvalidateWeakPtrs();
+    for (Browser* browser : browsers_) {
+      if (browser) {
+        UnloadController::From(browser)->ResetTryToCloseWindow();
+      }
+    }
+  }
+
+  void PreflightWarnings(size_t side) {
+    if (!closing_) {
+      return;
+    }
+    if (side == browsers_.size()) {
+      PreflightBeforeUnload(0);
+      return;
+    }
+    Browser* browser = browsers_[side];
+    if (!browser) {
+      PreflightWarnings(side + 1);
+      return;
+    }
+    using Result = UnloadController::WarnBeforeClosingResult;
+    waiting_side_ = side;
+    auto callback = base::BindOnce(&BrowserPair::OnWarning,
+                                   weak_factory_.GetWeakPtr(), side);
+    bool last_occupied = true;
+    for (size_t next = side + 1; next < browsers_.size(); ++next) {
+      last_occupied = last_occupied && !browsers_[next];
+    }
+    Result result;
+    if (last_occupied) {
+      std::vector<BrowserWindowInterface*> closing_group;
+      for (Browser* member : browsers_) {
+        if (member) {
+          closing_group.push_back(member);
+        }
+      }
+      result = UnloadController::From(browser)->MaybeWarnBeforeClosingForGroup(
+          std::move(callback), closing_group);
+    } else {
+      result = UnloadController::From(browser)->MaybeWarnBeforeClosing(
+          std::move(callback));
+    }
+    if (result == Result::kOkToClose) {
+      waiting_side_.reset();
+      PreflightWarnings(side + 1);
+    }
+  }
+
+  void OnWarning(size_t side,
+                 UnloadController::WarnBeforeClosingResult result) {
+    waiting_side_.reset();
+    if (result == UnloadController::WarnBeforeClosingResult::kOkToClose) {
+      // Helium can present multiple warnings in stages (multiple tabs, then
+      // downloads). Advance only after a synchronous all-clear.
+      PreflightWarnings(side);
+    } else {
+      CancelClose();
+    }
+  }
+
+  void PreflightBeforeUnload(size_t side) {
+    if (!closing_) {
+      return;
+    }
+    if (side == browsers_.size()) {
+      Save();
+      for (Browser* browser : browsers_) {
+        if (browser) {
+          prepared_session_ids_.push_back(browser->session_id());
+        }
+      }
+      SessionService* service = SessionServiceFactory::GetForProfile(profile_);
+      if (!service ||
+          !service->PrepareForWindowCloseGroup(prepared_session_ids_)) {
+        prepared_session_ids_.clear();
+      }
+      committing_close_ = true;
+      for (Browser* browser : browsers_) {
+        // Close can synchronously notify cancellation (policy or a late
+        // download). Preserve the sibling when that happens.
+        if (!committing_close_) {
+          break;
+        }
+        if (browser) {
+          browser->GetWindow()->Close();
+        }
+      }
+      return;
+    }
+    Browser* browser = browsers_[side];
+    if (!browser) {
+      PreflightBeforeUnload(side + 1);
+      return;
+    }
+    waiting_side_ = side;
+    bool waiting = UnloadController::From(browser)->TryToCloseWindow(
+        false, base::BindRepeating(&BrowserPair::OnBeforeUnload,
+                                   weak_factory_.GetWeakPtr(), side));
+    if (!waiting) {
+      waiting_side_.reset();
+      PreflightBeforeUnload(side + 1);
+    }
+  }
+
+  void OnBeforeUnload(size_t side, bool proceed) {
+    waiting_side_.reset();
+    if (proceed) {
+      PreflightBeforeUnload(side + 1);
+    } else {
+      CancelClose();
+    }
+  }
+
+  const raw_ptr<Profile> profile_;
+  const std::string group_id_;
+  std::array<raw_ptr<Browser>, 2> browsers_{};
+  std::array<bool, 2> drag_suspended_{};
+  std::array<NSRect, 2> drag_pane_frames_{};
+  std::array<base::CallbackListSubscription, 2> close_subscriptions_;
+  std::vector<SessionID> prepared_session_ids_;
+  HeliumDualWindowHost* __strong host_;
+  HeliumDualBrowserDelegate* __strong delegate_;
+  bool retired_ = false;
+  bool creating_pane_ = false;
+  bool closing_ = false;
+  bool committing_close_ = false;
+  std::optional<size_t> waiting_side_;
+  std::optional<gfx::Rect> pending_bounds_;
+  bool pending_restore_ = false;
+  std::array<base::CallbackListSubscription, 2> paint_subscriptions_;
+  base::ScopedMultiSourceObservation<views::Widget, views::WidgetObserver>
+      widget_observations_{this};
+  base::ScopedMultiSourceObservation<views::View, views::ViewObserver>
+      rail_observations_{this};
+  base::OneShotTimer rail_style_timer_;
+  base::OneShotTimer save_timer_;
+  base::WeakPtrFactory<BrowserPair> weak_factory_{this};
+};
+
+namespace {
+BrowserPair* Find(const BrowserView* view, bool include_suspended = false) {
+  const Browser* browser = view->browser();
+  auto profile = Pairs().find(browser->GetProfile());
+  if (profile == Pairs().end()) {
+    return nullptr;
+  }
+  auto pair = profile->second.find(browser->helium_dual_group_id());
+  if (pair == profile->second.end() ||
+      (!include_suspended && pair->second->IsPaneSuspended(view))) {
+    return nullptr;
+  }
+  return pair->second.get();
+}
+}  // namespace
+
+void EnsureHost(BrowserView* view, bool completing_tab_drag) {
+  // A new drag browser has to remain a real free native window until the
+  // standard move loop and tab-model commit/revert have both finished.
+  if (!completing_tab_drag &&
+      view->browser_widget()->tab_drag_kind() != TabDragKind::kNone) {
+    return;
+  }
+  Browser* browser = view->browser();
+  if (!IsPane(browser->helium_dual_role()) || !view->GetNativeWindow()) {
+    return;
+  }
+  PairMap& map = Pairs()[browser->GetProfile()];
+  const std::string original_id = browser->helium_dual_group_id();
+  if (auto original_pair = map.find(original_id); original_pair != map.end()) {
+    BrowserPair* owner = original_pair->second.get();
+    Browser* occupant =
+        owner->browser_at(SideIndex(browser->helium_dual_role()));
+    // An explicit launch-rail request belongs to its live host. Preserve that
+    // ownership on subsequent Show calls and leave restore-peer remaps intact.
+    if (occupant == browser || (!occupant && owner->creating_pane())) {
+      owner->Attach(view);
+      return;
+    }
+  }
+  auto& remaps = RestoreRemaps()[browser->GetProfile()];
+  for (auto it = remaps.begin(); it != remaps.end();) {
+    if (it->second.expires < base::TimeTicks::Now() ||
+        !map.contains(it->second.replacement) ||
+        map.at(it->second.replacement)->retired()) {
+      it = remaps.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  if (auto remap = remaps.find(original_id); remap != remaps.end()) {
+    BrowserPair* target = map.at(remap->second.replacement).get();
+    if (!target->browser_at(SideIndex(browser->helium_dual_role()))) {
+      browser->set_helium_dual_group_id(remap->second.replacement);
+    }
+  }
+  auto existing = map.find(browser->helium_dual_group_id());
+  if (existing != map.end()) {
+    Browser* occupant =
+        existing->second->browser_at(SideIndex(browser->helium_dual_role()));
+    if (existing->second->retired() || (occupant && occupant != browser)) {
+      const std::string replacement =
+          base::Uuid::GenerateRandomV4().AsLowercaseString();
+      browser->set_helium_dual_group_id(replacement);
+      remaps[original_id] = {replacement,
+                             base::TimeTicks::Now() + base::Seconds(30)};
+    }
+  }
+  auto& pair = map[browser->helium_dual_group_id()];
+  if (!pair) {
+    pair = std::make_unique<BrowserPair>(browser->GetProfile(),
+                                         browser->helium_dual_group_id(), view);
+  }
+  pair->Attach(view);
+  if (pair->browser_at(0) && pair->browser_at(1)) {
+    remaps.erase(original_id);
+  }
+}
+
+void ShowHost(BrowserView* view, bool activate) {
+  if (BrowserPair* pair = Find(view)) {
+    pair->Show(view, activate);
+  }
+}
+
+gfx::NativeWindow BrowserWindowForHost(gfx::NativeWindow window) {
+  if (!window) {
+    return {};
+  }
+  for (const auto& profile : Pairs()) {
+    for (const auto& entry : profile.second) {
+      HeliumDualWindowHost* host = entry.second->host();
+      if (window.GetNativeNSWindow() != host.window) {
+        continue;
+      }
+      NSWindow* pane = [host browserWindowForSide:host.activePane];
+      if (!pane) {
+        pane = [host browserWindowForSide:HeliumDualPaneSideLeft] ?:
+               [host browserWindowForSide:HeliumDualPaneSideRight];
+      }
+      return gfx::NativeWindow(pane);
+    }
+  }
+  return {};
+}
+
+bool BeginTabWindowDrag(BrowserView* view) {
+  if (BrowserPair* pair = Find(view, true)) {
+    return pair->SuspendPaneForDrag(view);
+  }
+  return true;
+}
+
+void EndTabWindowDrag(base::WeakPtr<BrowserView> view, bool canceled) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+          [](base::WeakPtr<BrowserView> view, bool canceled) {
+            if (!view || view->GetWidget()->IsClosed() ||
+                view->browser()->tab_strip_model()->empty()) {
+              return;
+            }
+            Browser* browser = view->browser();
+            if (BrowserPair* pair = Find(view.get(), true)) {
+              if (!pair->IsPaneSuspended(view.get()) ||
+                  pair->ResumePaneAfterDrag(view.get(), canceled)) {
+                return;
+              }
+              pair->Detach(view.get());
+              browser->set_helium_dual_group_id(
+                  base::Uuid::GenerateRandomV4().AsLowercaseString());
+              browser->set_helium_dual_ratio(kDefaultRatio);
+              browser->set_helium_dual_host_bounds({});
+            }
+            EnsureHost(view.get(), true);
+            ShowHost(view.get(), true);
+          }, std::move(view), canceled));
+}
+
+void DetachFromHost(BrowserView* view) {
+  if (BrowserPair* pair = Find(view, true)) {
+    pair->Detach(view);
+  }
+}
+
+bool MinimizeHost(BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    [pair->host().window miniaturize:nil];
+    return true;
+  }
+  return false;
+}
+
+bool RestoreHost(BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    pair->Restore();
+    return true;
+  }
+  return false;
+}
+
+bool ZoomHost(BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    if (!pair->host().window.zoomed) {
+      [pair->host().window zoom:nil];
+    }
+    return true;
+  }
+  return false;
+}
+
+bool ToggleHostFullscreen(BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    [pair->host() toggleFullscreen];
+    return true;
+  }
+  return false;
+}
+
+bool RequestHostFullscreen(BrowserView* view,
+                           bool fullscreen,
+                           int64_t display_id) {
+  if (BrowserPair* pair = Find(view)) {
+    auto* screen = display::Screen::Get();
+    auto* controller =
+        ExclusiveAccessManager::From(view->browser())->fullscreen_controller();
+    auto* contents = view->browser()->tab_strip_model()->GetActiveWebContents();
+    int64_t target_display = display_id;
+    if (target_display == display::kInvalidDisplayId && contents &&
+        controller->IsWindowFullscreenForTabOrPending()) {
+      target_display = FullscreenController::GetDisplayId(*contents);
+    }
+    if (fullscreen && target_display != display::kInvalidDisplayId && screen &&
+        screen->GetDisplayNearestWindow(gfx::NativeWindow(pair->host().window))
+                .id() != target_display) {
+      // Retargeting the shared host to another fullscreen Space needs a
+      // separate native transition. Cancel this unsupported content request
+      // through the normal controller, then report the unchanged window state.
+      // In particular, never report success on the wrong target display.
+      // A pane can also start on another screen when the host spans displays.
+      if (contents) {
+        controller->ExitFullscreenModeForTab(contents);
+      }
+      view->FullscreenStateChanged();
+      return true;
+    }
+    if (pair->host().fullscreen != fullscreen ||
+        pair->host().fullscreenTransition) {
+      [pair->host() requestFullscreen:fullscreen];
+    } else {
+      // Content fullscreen may change while the shared outer window is
+      // already fullscreen. Complete the browser controller's transition.
+      [pair->host() requestFullscreen:fullscreen];
+      view->PrepareForHeliumDualFullscreen(fullscreen);
+      view->FullscreenStateChanged();
+    }
+    return true;
+  }
+  return false;
+}
+
+bool SetHostBounds(BrowserView* view, const gfx::Rect& bounds) {
+  if (BrowserPair* pair = Find(view)) {
+    pair->SetBounds(bounds);
+    return true;
+  }
+  return false;
+}
+
+std::optional<gfx::Rect> HostBounds(const BrowserView* view, bool restored) {
+  if (BrowserPair* pair = Find(view)) {
+    return gfx::ScreenRectFromNSRect(restored ? pair->host().normalFrame
+                                              : pair->host().window.frame);
+  }
+  return std::nullopt;
+}
+
+std::optional<bool> HostIsFullscreen(const BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    return static_cast<bool>(pair->host().fullscreen);
+  }
+  return std::nullopt;
+}
+
+std::optional<bool> HostIsMinimized(const BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    return static_cast<bool>(pair->host().window.miniaturized);
+  }
+  return std::nullopt;
+}
+
+std::optional<bool> HostIsMaximized(const BrowserView* view) {
+  if (BrowserPair* pair = Find(view)) {
+    return static_cast<bool>(pair->host().window.zoomed);
+  }
+  return std::nullopt;
+}
+}  // namespace helium_dual
+
+@implementation HeliumDualBrowserDelegate
+@synthesize pair = _pair;
+- (void)heliumDualWindowHostDidRequestRightPane:(HeliumDualWindowHost*)host {
+  if (self.pair) {
+    self.pair->RequestPane(HeliumDualPaneSideRight);
+  }
+}
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+              didRequestPane:(HeliumDualPaneSide)side {
+  if (self.pair) {
+    self.pair->RequestPane(side);
+  }
+}
+- (void)heliumDualWindowHostDidRequestClose:(HeliumDualWindowHost*)host {
+  if (self.pair) {
+    self.pair->RequestClose();
+  }
+}
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+             didActivatePane:(HeliumDualPaneSide)side {
+  if (self.pair) {
+    self.pair->Activated(side);
+  }
+}
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+         didChangeSplitRatio:(double)ratio {
+  if (self.pair) {
+    self.pair->ScheduleSave();
+  }
+}
+- (void)heliumDualWindowHostDidChangeFrame:(HeliumDualWindowHost*)host {
+  if (self.pair) {
+    self.pair->ScheduleSave();
+  }
+}
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+        willChangeFullscreen:(BOOL)fullscreen {
+  if (self.pair) {
+    self.pair->FullscreenChanging(fullscreen);
+  }
+}
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+         didChangeFullscreen:(BOOL)fullscreen {
+  if (self.pair) {
+    self.pair->FullscreenChanged();
+  }
+}
