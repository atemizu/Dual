+@implementation HeliumDualLaunchButton {
+  NSTrackingArea* _trackingArea;
+  BOOL _hovered;
+}
+@synthesize railStyle = _railStyle;
+@synthesize showsTitle = _showsTitle;
+- (void)setShowsTitle:(BOOL)showsTitle {
+  if (_showsTitle == showsTitle) return;
+  _showsTitle = showsTitle;
+  self.needsDisplay = YES;
+}
+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (_trackingArea) {
+    [self removeTrackingArea:_trackingArea];
+  }
+  _trackingArea = [[NSTrackingArea alloc]
+      initWithRect:NSZeroRect
+           options:NSTrackingMouseEnteredAndExited |
+                   NSTrackingActiveInActiveApp | NSTrackingInVisibleRect
+             owner:self
+          userInfo:nil];
+  [self addTrackingArea:_trackingArea];
+}
+- (void)mouseEntered:(NSEvent*)event {
+  _hovered = YES;
+  self.needsDisplay = YES;
+}
+- (void)mouseExited:(NSEvent*)event {
+  _hovered = NO;
+  self.needsDisplay = YES;
+}
+- (BOOL)acceptsFirstMouse:(NSEvent*)event {
+  return YES;
+}
+- (void)drawRect:(NSRect)dirtyRect {
+  HeliumDualRailStyle* style = self.railStyle;
+  NSBezierPath* shape =
+      [NSBezierPath bezierPathWithRoundedRect:self.bounds
+                                      xRadius:style.cornerRadius
+                                      yRadius:style.cornerRadius];
+  [style.buttonColor setFill];
+  [shape fill];
+  if (self.cell.highlighted || _hovered) {
+    [(self.cell.highlighted ? style.pressedColor : style.hoverColor) setFill];
+    [shape fill];
+  }
+  const BOOL titled =
+      self.showsTitle && style.launchTitle.length > 0 && style.titleFont;
+  const NSSize iconSize = style.icon ? style.icon.size : NSZeroSize;
+  const CGFloat iconX = titled ? kLaunchTitleInset
+                               : (NSWidth(self.bounds) - iconSize.width) / 2;
+  if (style.icon) {
+    [style.icon drawInRect:NSMakeRect(iconX,
+                                      (NSHeight(self.bounds) - iconSize.height) / 2,
+                                      iconSize.width, iconSize.height)
+                  fromRect:NSZeroRect
+                 operation:NSCompositingOperationSourceOver
+                  fraction:1
+            respectFlipped:YES
+                     hints:nil];
+  }
+  if (titled) {
+    NSMutableParagraphStyle* paragraph = [[NSMutableParagraphStyle alloc] init];
+    paragraph.lineBreakMode = NSLineBreakByTruncatingTail;
+    NSAttributedString* title = [[NSAttributedString alloc]
+        initWithString:style.launchTitle
+            attributes:@{
+              NSFontAttributeName : style.titleFont,
+              NSForegroundColorAttributeName :
+                  style.titleColor ?: NSColor.secondaryLabelColor,
+              NSParagraphStyleAttributeName : paragraph,
+            }];
+    const CGFloat x = iconX + iconSize.width + kLaunchTitleInset;
+    const CGFloat height = std::ceil(title.size.height);
+    [title drawInRect:NSMakeRect(x, (NSHeight(self.bounds) - height) / 2,
+                                 std::max<CGFloat>(
+                                     0, NSWidth(self.bounds) - x -
+                                            kLaunchTitleInset),
+                                 height)];
+  }
+}
