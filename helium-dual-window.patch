+// How long a staged divider step waits: first for the pages to draw at their
+// new widths, then for the browser frames that contain them. Nothing is
+// blocked meanwhile, so the first wait can be generous. A page that missed it
+// gets only the short wait until it keeps up again, so that a hung page does
+// not hold every step.
+constexpr base::TimeDelta kStagedPageWait = base::Milliseconds(1500);
+constexpr base::TimeDelta kStagedSlowPageWait = base::Milliseconds(150);
+constexpr base::TimeDelta kStagedFrameWait = base::Milliseconds(250);
+constexpr base::TimeDelta kStagedPollInterval = base::Milliseconds(4);
+
+const ResizeConfig& GetResizeConfig() {
+  static const ResizeConfig config = [] {
+    ResizeConfig c;
+    const auto* command_line = base::CommandLine::ForCurrentProcess();
+    const std::string mode =
+        command_line->GetSwitchValueASCII("dual-resize-mode");
+    if (mode == "locked") {
+      c.mode = ResizeMode::kLocked;
+    } else if (mode == "unlocked") {
+      c.mode = ResizeMode::kUnlocked;
+    } else if (mode == "parallel") {
+      c.mode = ResizeMode::kParallel;
+    } else if (mode == "none") {
+      c.mode = ResizeMode::kNone;
+    }
+    int ms = 0;
+    if (base::StringToInt(
+            command_line->GetSwitchValueASCII("dual-resize-deadline-ms"),
+            &ms) &&
+        ms >= 0 && ms <= 500) {
+      c.deadline = base::Milliseconds(ms);
+    }
+    c.trace = command_line->HasSwitch("dual-resize-trace");
+    c.staged_divider = !command_line->HasSwitch("dual-divider-direct");
+    return c;
+  }();
+  return config;
+}
+
+bool ValidFrame(NSRect frame) {
+  return std::isfinite(frame.origin.x) && std::isfinite(frame.origin.y) &&
+         std::isfinite(frame.size.width) && std::isfinite(frame.size.height) &&
+         // A host can be as narrow as one pane and the collapsed launch rail.
+         frame.size.width >= kHeliumDualMinimumPaneWidth +
+                                 VerticalTabStripRegionView::kCollapsedWidth &&
+         frame.size.width <= 20000 &&
+         frame.size.height >= kHeliumDualMinimumPaneHeight &&
+         frame.size.height <= 20000;
+}
+}  // namespace
+
+// Owns the common surrounding window; BrowserManagerService retains ownership
+// of each Browser and each BrowserView retains its normal BrowserWidget.
+class BrowserPair : public views::WidgetObserver, public views::ViewObserver {
+ public:
+  BrowserPair(Profile* profile, std::string group_id, BrowserView* first)
+      : profile_(profile), group_id_(std::move(group_id)) {
+    NSWindow* pane = first->GetNativeWindow().GetNativeNSWindow();
+    NSRect frame = pane.frame;
+    const std::string& saved = HeliumDualPaneState::From(first->browser())->host_bounds();
+    if (!saved.empty()) {
+      NSRect restored = NSRectFromString(base::SysUTF8ToNSString(saved));
+      if (ValidFrame(restored)) {
+        frame = restored;
+      }
+    }
+    NSScreen* screen = pane.screen ?: NSScreen.mainScreen;
+    NSRect visible = screen.visibleFrame;
+    if (!ValidFrame(frame)) {
+      frame = NSMakeRect(visible.origin.x + 30, visible.origin.y + 30,
+                         std::min<CGFloat>(1440, visible.size.width - 60),
+                         std::min<CGFloat>(900, visible.size.height - 60));
+    }
+    // Keep restored hosts reachable if an external display was disconnected.
+    bool on_screen = false;
+    for (NSScreen* candidate in NSScreen.screens) {
+      if (NSIntersectsRect(frame, candidate.visibleFrame)) {
+        on_screen = true;
+        break;
+      }
+    }
+    if (!on_screen) {
+      frame.origin = NSMakePoint(visible.origin.x + 20, visible.origin.y + 20);
+    }
+    host_ = [[HeliumDualWindowHost alloc] initWithContentRect:frame
+                                                        title:([NSBundle.mainBundle objectForInfoDictionaryKey:@"CFBundleDisplayName"] ?: @"Dual")];
+    // Saved data is the outer frame, whereas initialization takes content.
+    [host_.window setFrame:frame display:NO];
+    host_.splitRatio = HeliumDualPaneState::From(first->browser())->ratio();
+    delegate_ = [[HeliumDualBrowserDelegate alloc] init];
+    delegate_.pair = this;
+    host_.delegate = delegate_;
+  }
+
+  ~BrowserPair() override {
+    CancelStagedResize();
+    widget_observations_.RemoveAllObservations();
+    rail_observations_.RemoveAllObservations();
+    delegate_.pair = nullptr;
+    host_.delegate = nil;
+  }
+
+  void Attach(BrowserView* view) {
+    BrowserWindowInterface* browser = view->browser();
+    const size_t side = SideIndex(RoleOf(browser));
+    if (browsers_[side] == browser) {
+      return;
+    }
+    // Restoration can create a window with stale grouping information while
+    // the old one is still open. Never replace or destroy an occupied pane.
+    CHECK(!browsers_[side]);
+    browsers_[side] = browser;
+    close_subscriptions_[side] =
+        browser->RegisterBrowserCloseCancelled(base::BindRepeating(
+            &BrowserPair::OnCloseCancelled, base::Unretained(this)));
+    [host_ attachBrowserWindow:view->GetNativeWindow().GetNativeNSWindow()
+                          side:NativeSide(RoleOf(browser))];
+    view->GetWidget()->OnSizeConstraintsChanged();
+    widget_observations_.AddObservation(view->GetWidget());
+    paint_subscriptions_[side] =
+        view->GetWidget()->RegisterPaintAsActiveChangedCallback(
+            base::BindRepeating(&BrowserPair::ScheduleRailStyle,
+                                base::Unretained(this)));
+    if (auto* rail = GetPaneRail(browser)) {
+      rail_observations_.AddObservation(rail);
+    }
+    UpdateRailStyle();
+    InvalidateRails();
+    ScheduleZenState();
+    ScheduleSave();
+  }
+
+  void ScheduleZenState() {
+    if (!zen_state_timer_.IsRunning()) {
+      zen_state_timer_.Start(FROM_HERE, base::TimeDelta(), this,
+                             &BrowserPair::UpdateZenState);
+    }
+  }
+
+  // In Zen mode the outer rails hide like Helium's side chrome, unless that
+  // chrome is pinned. Each pane's window controls follow its toolbar.
+  void UpdateZenState() {
+    bool auto_hide = false;
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      if (!view || !view->GetWidget()) continue;
+      auto_hide |= view->IsZenModeEnabledForLayout() &&
+                   !view->IsZenModeSideChromePinned();
+      [host_ setWindowControlsAlpha:view->GetTopChromeRevealRatio()
+                            forPane:view->GetNativeWindow().GetNativeNSWindow()];
+    }
+    host_.autoHideRails = auto_hide;
+  }
+
+  // Use the actual pane's resolved theme, including explicit light/dark mode
+  // and custom theme colors. NSColor's system defaults cannot represent them.
+  void UpdateRailStyle() {
+    BrowserWindowInterface* browser = browsers_[host_.activePane == HeliumDualPaneSideRight];
+    if (!browser) {
+      browser = browsers_[0] ? browsers_[0].get() : browsers_[1].get();
+    }
+    if (!browser) {
+      return;
+    }
+    BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser);
+    if (!view || !view->GetWidget() || !view->GetColorProvider()) {
+      return;
+    }
+    const ui::ColorProvider* colors = view->GetColorProvider();
+    RailStyleInputs inputs;
+    inputs.width = VerticalTabStripRegionView::kCollapsedWidth;
+    inputs.button_height = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+    inputs.horizontal_padding =
+        GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+    inputs.corner_radius =
+        GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius);
+    inputs.rounded_icons = features::IsRoundedIconsEnabled();
+    inputs.scale = host_.window.backingScaleFactor;
+    inputs.colors = {
+        colors->GetColor(kColorToolbar),
+        colors->GetColor(view->GetWidget()->ShouldPaintAsActive()
+                             ? kColorTabBackgroundInactiveFrameActive
+                             : kColorTabBackgroundInactiveFrameInactive),
+        colors->GetColor(kColorTabBackgroundInactiveHoverFrameActive),
+        colors->GetColor(kColorTabBackgroundActiveFrameActive),
+        colors->GetColor(kColorToolbarContentAreaSeparator),
+        colors->GetColor(kColorToolbarButtonIconDisabled),
+        colors->GetColor(kColorToolbar)};
+    // An empty strip has no tab rows; match the real tab region's two-DIP gap.
+    if (auto* rail = GetPaneRail(browser); rail && rail->GetVisible()) {
+      const gfx::Rect pane = gfx::ScreenRectFromNSRect(
+          view->GetNativeWindow().GetNativeNSWindow().frame);
+      inputs.button_top =
+          std::max(0, rail->GetBoundsInScreen().y() - pane.y()) + 2;
+    }
+    // With a single pane, measure how much more space its content leaves at
+    // the outer edge than next to its own tab rail; the host rail absorbs it.
+    if (!browsers_[0] != !browsers_[1]) {
+      BrowserWindowInterface* only = browsers_[0] ? browsers_[0].get() : browsers_[1].get();
+      auto* only_view = BrowserView::GetBrowserViewForBrowser(only);
+      auto* only_rail = GetPaneRail(only);
+      if (only_view && only_rail && only_rail->GetVisible()) {
+        const auto contents = only_view->GetAllVisibleContentsWebViews();
+        if (!contents.empty()) {
+          const gfx::Rect web = views::View::ConvertRectToTarget(
+              contents.front(), only_view, contents.front()->GetLocalBounds());
+          const gfx::Rect strip = views::View::ConvertRectToTarget(
+              only_rail, only_view, only_rail->GetLocalBounds());
+          const int beside_rail = browsers_[0] ? web.x() - strip.right()
+                                               : strip.x() - web.right();
+          const int outer = browsers_[0] ? only_view->width() - web.right()
+                                         : web.x();
+          inputs.pane_edge_inset =
+              std::clamp(outer - beside_rail, 0, inputs.width / 2);
+        }
+      }
+    }
+    // Zen mode rails float like the visible pane's own strip: the same
+    // vertical extent, width and first row, and its new tab button's label.
+    inputs.floating_radius = GetGenericFrameRadius();
+    std::optional<gfx::Font> title_font;
+    if (BrowserWindowInterface* source = FloatingRailSource()) {
+      auto* source_view = BrowserView::GetBrowserViewForBrowser(source);
+      auto* source_rail = GetPaneRail(source);
+      // A hidden Zen strip is still laid out; only its x slides away.
+      if (source_view && source_view->GetWidget() && source_rail &&
+          !source_rail->size().IsEmpty()) {
+        const gfx::Rect pane = gfx::ScreenRectFromNSRect(
+            source_view->GetNativeWindow().GetNativeNSWindow().frame);
+        const gfx::Rect strip = source_rail->GetBoundsInScreen();
+        // The strip moves below the toolbar while that reveals. Follow only
+        // its settled positions; a hidden rail need not track the animation.
+        const float top_ratio = source_view->GetTopChromeRevealRatio();
+        if (top_ratio <= 0.f || top_ratio >= 1.f) {
+          floating_top_ = std::clamp(strip.y() - pane.y(), 0, pane.height() / 2);
+          floating_bottom_ =
+              std::clamp(pane.bottom() - strip.bottom(), 0, pane.height() / 2);
+        }
+        inputs.floating_width = source_rail->width();
+        const int row_top = source_rail->GetDualFirstRowTop();
+        inputs.floating_row_top = row_top > 0 ? row_top : kZenFloatingPadding;
+        if (auto* label =
+                FindNewTabLabel(source_rail->GetBottomContainer())) {
+          const gfx::Font& font = label->font_list().GetPrimaryFont();
+          title_font = font;
+          inputs.new_tab_title = std::u16string(label->GetText());
+          inputs.title_font_name = font.GetFontName();
+          inputs.title_font_size = font.GetFontSize();
+          inputs.title_font_weight = static_cast<int>(font.GetWeight());
+          inputs.title_color = label->GetEnabledColor();
+        }
+      }
+    }
+    inputs.floating_top = floating_top_;
+    inputs.floating_bottom = floating_bottom_;
+    const ui::ThemeProvider* theme = view->GetThemeProvider();
+    const gfx::ImageSkia* background = nullptr;
+    if (theme && theme->HasCustomImage(IDR_THEME_TOOLBAR)) {
+      background = theme->GetImageSkiaNamed(IDR_THEME_TOOLBAR);
+      inputs.has_background_image = true;
+      inputs.background_size = gfx::Size(
+          inputs.width, NSHeight(host_.window.contentView.bounds));
+      inputs.background_y_offset = ThemeProperties::kFrameHeightAboveTabs +
+                                   view->theme_background_y_offset().value_or(0);
+      inputs.background_generation =
+          background->GetRepresentation(inputs.scale).GetBitmap().getGenerationID();
+    }
+    if (rail_style_inputs_ && *rail_style_inputs_ == inputs) {
+      return;
+    }
+    auto color = [](SkColor value) {
+      return [NSColor colorWithSRGBRed:SkColorGetR(value) / 255.0
+                                 green:SkColorGetG(value) / 255.0
+                                  blue:SkColorGetB(value) / 255.0
+                                 alpha:SkColorGetA(value) / 255.0];
+    };
+    HeliumDualRailStyle* style = [[HeliumDualRailStyle alloc] init];
+    style.width = inputs.width;
+    style.buttonHeight = inputs.button_height;
+    style.horizontalPadding = inputs.horizontal_padding;
+    style.cornerRadius = inputs.corner_radius;
+    style.buttonTop = inputs.button_top;
+    style.paneEdgeInset = inputs.pane_edge_inset;
+    style.floatingTop = inputs.floating_top;
+    style.floatingBottom = inputs.floating_bottom;
+    style.floatingWidth = inputs.floating_width;
+    style.floatingRowTop = inputs.floating_row_top;
+    style.floatingCornerRadius = inputs.floating_radius;
+    if (title_font && !inputs.new_tab_title.empty()) {
+      style.launchTitle = base::SysUTF16ToNSString(inputs.new_tab_title);
+      style.titleFont = (__bridge NSFont*)title_font->GetCTFont();
+      style.titleColor = color(inputs.title_color);
+    }
+    style.backgroundColor = color(inputs.colors[0]);
+    style.buttonColor = color(inputs.colors[1]);
+    style.hoverColor = color(inputs.colors[2]);
+    style.pressedColor = color(inputs.colors[3]);
+    style.separatorColor = color(inputs.colors[4]);
+    style.icon = gfx::NSImageFromImageSkia(gfx::CreateVectorIcon(
+        inputs.rounded_icons ? vector_icons::kAddWeight500CustomIcon
+                             : vector_icons::kAddOldIcon,
+        16, inputs.colors[5]));
+    if (background) {
+      // Rasterize again only if the theme, height, offset or scale changed.
+      gfx::Canvas canvas(inputs.background_size, inputs.scale, false);
+      canvas.DrawColor(inputs.colors[6]);
+      canvas.TileImageInt(*background, 0, inputs.background_y_offset, 0, 0,
+                          inputs.background_size.width(),
+                          inputs.background_size.height(), 1.0f,
+                          SkTileMode::kRepeat, SkTileMode::kMirror);
+      style.backgroundImage = gfx::NSImageFromImageSkia(
+          gfx::ImageSkia(gfx::ImageSkiaRep(canvas.GetBitmap(), inputs.scale)));
+    }
+    rail_style_inputs_ = inputs;
+    [host_ applyRailStyle:style];
+  }
+
+  // The visible pane whose strip a Zen mode rail mirrors: a lone pane, or
+  // the sibling of a collapsed one.
+  BrowserWindowInterface* FloatingRailSource() const {
+    if (!browsers_[0] != !browsers_[1]) {
+      return browsers_[0] ? browsers_[0].get() : browsers_[1].get();
+    }
+    for (size_t side = 0; side < 2; ++side) {
+      if (browsers_[side] &&
+          [host_ isPaneHidden:static_cast<HeliumDualPaneSide>(1 - side)]) {
+        return browsers_[side];
+      }
+    }
+    return nullptr;
+  }
+
+  // Each strip's hide button depends on its sibling (see CanHide()); lay the
+  // strips out again whenever the pair or a pane's visibility changes. Do it
+  // now: an idle pane may not draw again until the pointer reaches it, and a
+  // layout then can land in the middle of a click.
+  void InvalidateRails() {
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* rail = browser ? GetPaneRail(browser) : nullptr;
+      if (!rail) continue;
+      // The tabs too: whether a tab offers its close button depends on
+      // whether its pane is hidden.
+      InvalidateLayoutOfTree(rail);
+      if (auto* widget = rail->GetWidget()) widget->LayoutRootViewIfNecessary();
+    }
+  }
+
+  // The pane that shows the host's window controls must reserve their area in
+  // its own layout (BrowserFrameViewMac asks PaneShowsWindowControls()). The
+  // host calls this whenever the controls move, before resizing the panes.
+  void UpdateWindowControlsOwner() {
+    NSWindow* owner = host_.windowControlsPane;
+    if (owner == window_controls_owner_) return;
+    window_controls_owner_ = owner;
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (auto* view =
+              browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr) {
+        view->InvalidateLayout();
+        if (auto* frame = view->GetWidget()
+                              ? view->GetWidget()->non_client_view()
+                              : nullptr) {
+          frame->InvalidateLayout();
+        }
+      }
+    }
+  }
+
+  void ScheduleRailStyle() {
+    if (!rail_style_timer_.IsRunning()) {
+      rail_style_timer_.Start(FROM_HERE, base::TimeDelta(), this,
+                              &BrowserPair::UpdateRailStyle);
+    }
+  }
+
+  void OnWidgetThemeChanged(views::Widget* widget) override {
+    rail_style_inputs_.reset();
+    ScheduleRailStyle();
+  }
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& bounds) override {
+    ScheduleRailStyle();
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    widget_observations_.RemoveObservation(widget);
+  }
+  void OnViewBoundsChanged(views::View* view) override { ScheduleRailStyle(); }
+  void OnViewIsDeleting(views::View* view) override {
+    rail_observations_.RemoveObservation(view);
+  }
+
+  bool IsVisibilityChanging(const BrowserView* view) const {
+    return visibility_changing_[SideIndex(RoleOf(view->browser()))];
+  }
+  bool IsHidden(const BrowserView* view) const {
+    return [host_ isPaneHidden:NativeSide(RoleOf(view->browser()))];
+  }
+  // A window with two panes always shows at least one. The one showing can
+  // be hidden even while the other is: the other is shown in its place.
+  bool CanHide(const BrowserView* view) const {
+    return !drag_suspended_[0] && !drag_suspended_[1] &&
+        browsers_[0] && browsers_[1] &&
+        [host_ browserWindowForSide:HeliumDualPaneSideLeft] &&
+        [host_ browserWindowForSide:HeliumDualPaneSideRight] &&
+        !IsHidden(view);
+  }
+  void SetHidden(BrowserView* view, bool hidden) {
+    if (hidden == IsHidden(view) || (hidden && !CanHide(view))) return;
+    const size_t side = SideIndex(RoleOf(view->browser()));
+    // Hiding this pane shows the other one, if that was the hidden one.
+    const bool changing_places =
+        hidden && [host_ isPaneHidden:static_cast<HeliumDualPaneSide>(1 - side)];
+    if (hidden) {
+      auto* rail = GetPaneRail(view->browser());
+      [host_ setHiddenRailWidth:rail ? rail->width()
+                                     : VerticalTabStripRegionView::kCollapsedWidth
+                          side:NativeSide(RoleOf(view->browser()))];
+      for (views::View* child : view->children()) {
+        if (child == rail) continue;
+        auto tracker = std::make_unique<views::ViewTracker>();
+        tracker->SetView(child);
+        hidden_views_[side].emplace_back(std::move(tracker), child->GetVisible());
+      }
+    }
+    auto weak_this = lifetime_weak_factory_.GetWeakPtr();
+    {
+      // Native SetBounds can synchronously enter Chromium layout. The content
+      // container and toolbar must be restored before normal layout resumes.
+      base::AutoReset<bool> transition(&visibility_changing_[side], true);
+      base::AutoReset<bool> other_transition(
+          &visibility_changing_[1 - side],
+          changing_places || visibility_changing_[1 - side]);
+      [host_ setPaneHidden:hidden side:NativeSide(RoleOf(view->browser()))];
+      if (!hidden) RestoreHiddenViews(side);
+      if (changing_places) RestoreHiddenViews(1 - side);
+    }
+    view->InvalidateLayout();
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    if (!weak_this) return;
+    if (auto* other = changing_places && browsers_[1 - side]
+                          ? BrowserView::GetBrowserViewForBrowser(
+                                browsers_[1 - side])
+                          : nullptr) {
+      other->InvalidateLayout();
+      other->GetWidget()->LayoutRootViewIfNecessary();
+      if (!weak_this) return;
+    }
+    InvalidateRails();
+    ScheduleRailStyle();
+    if (!hidden) [host_ activatePane:NativeSide(RoleOf(view->browser()))];
+  }
+  void RestoreHiddenViews(size_t side) {
+    for (auto& [tracker, visible] : hidden_views_[side]) {
+      if (tracker->view()) tracker->view()->SetVisible(visible);
+    }
+    hidden_views_[side].clear();
+  }
+  void SetPaneFrames(NSRect left_frame, NSRect right_frame) {
+    // Detach is called from Widget destruction. Resize tasks can paint that
+    // partially destroyed frame even after it is removed from browsers_.
+    // Finish the surviving pane's resize after this destruction stack unwinds.
+    if (detaching_) return;
+    // The host withdraws staged frames before it lays out directly; make
+    // sure of it, since both would otherwise resize the same windows.
+    if (staged_) {
+      auto weak = lifetime_weak_factory_.GetWeakPtr();
+      CancelStagedResize();
+      if (!weak) return;
+    }
+    // Present both native frames and the GPU IOSurfaces in the same local
+    // transaction. Remote CAContexts cannot be synchronized reliably here:
+    // reusing one causes the trailing rail to jump, while CATransactionV2's
+    // context replacement causes resize flicker (crbug.com/519500878).
+    // IOSurface presentation retains GPU rendering and live divider resizing.
+    ScopedCAActionDisabler transaction;
+    // Chromium's normal zero-frame resize deadline permits the browser chrome
+    // to commit with an old, narrower renderer surface. Use the same bounded
+    // surface synchronization as Chromium content animations before resizing
+    // either pane; waiting only for the outer IOSurface size is insufficient.
+    NSWindow* windows[] = {
+        [host_ browserWindowForSide:HeliumDualPaneSideLeft],
+        [host_ browserWindowForSide:HeliumDualPaneSideRight]};
+    auto pane_size_changed = [&](size_t side, NSRect target) {
+      if (!windows[side]) return false;
+      if (!NSEqualSizes([windows[side] frame].size, target.size)) return true;
+      // AppKit can move a child to its target frame before the Chromium bridge
+      // receives the size notification. SetPaneFrame still sends SetBounds in
+      // that case, so it needs the same compositor synchronization as a native
+      // frame-size change.
+      BrowserWindowInterface* browser = browsers_[side];
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      auto* bridge = view ? views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+                                view->GetNativeWindow())
+                          : nullptr;
+      return bridge && bridge->GetWindowBoundsInScreen().size() !=
+                           gfx::ScreenRectFromNSRect(target).size();
+    };
+    const bool size_changed = pane_size_changed(0, left_frame) ||
+                              pane_size_changed(1, right_frame);
+    auto weak_this = lifetime_weak_factory_.GetWeakPtr();
+    // Showing/focusing an existing browser, moving its host, and divider
+    // updates at a size limit all arrive here without changing either size.
+    // Existing surfaces remain valid in those cases. Do not force two new
+    // compositor frames or enter the resize-only message pump for them.
+    if (!size_changed) {
+      if (windows[0]) SetPaneFrame(left_frame, HeliumDualPaneSideLeft);
+      if (weak_this && windows[1]) {
+        SetPaneFrame(right_frame, HeliumDualPaneSideRight);
+      }
+      return;
+    }
+    ScopedNativeContentsResize content_resize;
+    const bool fullscreen_transition = host_.fullscreenTransition;
+    const ResizeConfig& config = GetResizeConfig();
+    const base::TimeTicks start = base::TimeTicks::Now();
+    // Chromium's compositor lock is specifically intended to hold a browser
+    // commit while a renderer prepares a frame at a new size. Holding both
+    // roots prevents an early browser frame from embedding stale OOPIF
+    // content. Renderer/child surface activation continues independently.
+    std::vector<std::unique_ptr<ui::CompositorLock>> resize_locks;
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (auto* view = browser
+                           ? BrowserView::GetBrowserViewForBrowser(browser)
+                           : nullptr) {
+        for (auto* contents : view->GetAllVisibleContentsWebViews()) {
+          content_resize.Add(contents);
+        }
+        if (config.mode == ResizeMode::kLocked && !fullscreen_transition &&
+            view->GetWidget()->GetCompositor()) {
+          resize_locks.push_back(
+              view->GetWidget()->GetCompositor()->GetCompositorLock(
+                  nullptr, base::TimeDelta()));
+        }
+      }
+    }
+    if (windows[0]) SetPaneFrame(left_frame, HeliumDualPaneSideLeft);
+    if (!weak_this) return;
+    if (windows[1]) SetPaneFrame(right_frame, HeliumDualPaneSideRight);
+    if (!weak_this || fullscreen_transition) return;
+    const base::TimeTicks frames_set = base::TimeTicks::Now();
+    if (config.mode == ResizeMode::kNone) {
+      if (config.trace) {
+        LOG(ERROR) << "DualResize mode=none set_us="
+                   << (frames_set - start).InMicroseconds();
+      }
+      return;
+    }
+
+    // Pump only Chromium's resize/compositor queue, not mouse events. Bound
+    // the entire pair's wait so a slow or unavailable GPU cannot stall drag.
+    const auto deadline = base::TimeTicks::Now() + config.deadline;
+    while (config.mode != ResizeMode::kParallel && weak_this &&
+           content_resize.HasPendingFrame()) {
+      const auto remaining = deadline - base::TimeTicks::Now();
+      if (remaining <= base::TimeDelta() ||
+          !ui::WindowResizeHelperMac::Get()->WaitForSingleTaskToRun(remaining)) {
+        break;
+      }
+    }
+    // No new-size browser frame can have been committed while the roots were
+    // locked. Release them together; the matching native frames now include
+    // the activated renderer surfaces. As in Chromium's native pre-commit
+    // path, wait for those frames rather than a later presentation report.
+    resize_locks.clear();
+    const base::TimeTicks renderers_done = base::TimeTicks::Now();
+    const bool renderer_pending = weak_this && content_resize.HasPendingFrame();
+    while (weak_this) {
+      bool waiting = false;
+      for (size_t side = 0; side < 2; ++side) {
+        NSWindow* window = windows[side];
+        // Re-resolve after every pumped task; a native bridge can be destroyed
+        // during shutdown while its retained NSWindow still exists.
+        auto* bridge = window
+            ? remote_cocoa::NativeWidgetNSWindowBridge::GetFromNSWindow(window)
+            : nullptr;
+        waiting |= bridge && bridge->ShouldWaitInPreCommit();
+      }
+      const auto remaining = deadline - base::TimeTicks::Now();
+      if (!waiting || remaining <= base::TimeDelta() ||
+          !ui::WindowResizeHelperMac::Get()->WaitForSingleTaskToRun(remaining)) {
+        break;
+      }
+    }
+    if (config.trace && weak_this) {
+      const base::TimeTicks end = base::TimeTicks::Now();
+      LOG(ERROR) << "DualResize mode=" << static_cast<int>(config.mode)
+                 << " set_us=" << (frames_set - start).InMicroseconds()
+                 << " renderer_us="
+                 << (renderers_done - frames_set).InMicroseconds()
+                 << " browser_us=" << (end - renderers_done).InMicroseconds()
+                 << " total_us=" << (end - start).InMicroseconds()
+                 << " renderer_pending_after=" << renderer_pending
+                 << " stale_after=" << content_resize.HasPendingFrame();
+    }
+  }
+
+  void SetPaneFrame(NSRect frame, HeliumDualPaneSide side) {
+    BrowserWindowInterface* browser = browsers_[side];
+    auto* view = browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    if (!view) return;
+    NSWindow* window = view->GetNativeWindow().GetNativeNSWindow();
+    auto* bridge = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(view->GetNativeWindow());
+    if (!bridge) return;
+    const gfx::Rect target_bounds = gfx::ScreenRectFromNSRect(frame);
+    // AppKit can move a child before Chromium receives the notification.
+    // Skip only when the native frame and Chromium's cached bounds agree.
+    if (NSEqualRects(window.frame, frame) &&
+        bridge->GetWindowBoundsInScreen() == target_bounds) {
+      return;
+    }
+    const bool size_changed =
+        !NSEqualSizes(window.frame.size, frame.size) ||
+        bridge->GetWindowBoundsInScreen().size() != target_bounds.size();
+    // Cancel stale asynchronous native resizes and notify the Views root and
+    // compositor together. Direct NSWindow mutations bypass this pipeline.
+    bridge->GetNSWindowMojo()->SetBounds(target_bounds,
+                                        gfx::Size(1, 1), std::nullopt);
+    // Reconcile Views and compositor geometry even if Cocoa omitted the
+    // notification or had already moved the child to the requested frame.
+    if (auto* native_bridge =
+            remote_cocoa::NativeWidgetNSWindowBridge::GetFromNSWindow(
+                view->GetNativeWindow().GetNativeNSWindow())) {
+      native_bridge->UpdateWindowGeometry();
+    }
+    if (size_changed) {
+      view->InvalidateLayout();
+      view->GetWidget()->LayoutRootViewIfNecessary();
+    }
+  }
+
+  // A divider gesture resizes the panes in two steps, so that neither is
+  // ever shown wider than what it has drawn (a page that is slow to draw at
+  // its new width would otherwise leave a blank band until it catches up):
+  //  1. Both panes are told their new frames while their windows keep the
+  //     present frames and contents. The browser roots are held, so that
+  //     their first frames at the new size already contain the pages' own.
+  //  2. When the pages have drawn (or are no longer waited for), the roots
+  //     are released; when both browser frames have arrived, the host has
+  //     the windows take their frames and those contents in one transaction.
+  // Nothing blocks meanwhile: the host goes on following the pointer.
+  bool StagePaneFrames(NSRect left_frame, NSRect right_frame) {
+    if (retired_ || detaching_ || !GetResizeConfig().staged_divider) {
+      return false;
+    }
+    CancelStagedResize();
+    NSWindow* windows[2] = {nil, nil};
+    for (size_t side = 0; side < 2; ++side) {
+      BrowserWindowInterface* browser = browsers_[side];
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      NSWindow* window =
+          [host_ browserWindowForSide:static_cast<HeliumDualPaneSide>(side)];
+      if (!view || !view->GetWidget() || !window ||
+          window != view->GetNativeWindow().GetNativeNSWindow() ||
+          !remote_cocoa::NativeWidgetNSWindowBridge::GetFromNSWindow(window)) {
+        return false;
+      }
+      windows[side] = window;
+    }
+    staged_.emplace();
+    staged_->id = ++staged_resize_count_;
+    staged_->frames = {left_frame, right_frame};
+    staged_->windows[0] = windows[0];
+    staged_->windows[1] = windows[1];
+    staged_->started = base::TimeTicks::Now();
+    staged_->deadline = staged_->started +
+                        (pages_slow_ ? kStagedSlowPageWait : kStagedPageWait);
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* view = BrowserView::GetBrowserViewForBrowser(browser);
+      for (auto* contents : view->GetAllVisibleContentsWebViews()) {
+        staged_->contents.Add(contents);
+      }
+      if (auto* compositor = view->GetWidget()->GetCompositor()) {
+        staged_->locks.push_back(
+            compositor->GetCompositorLock(nullptr, base::TimeDelta()));
+      }
+    }
+    // Laying a pane out at its new size can run anything, including what
+    // ends this resize or this pair.
+    auto weak_this = lifetime_weak_factory_.GetWeakPtr();
+    const uint64_t id = staged_->id;
+    auto still_staged = [&] {
+      return weak_this && staged_ && staged_->id == id;
+    };
+    for (size_t side = 0; side < 2 && still_staged(); ++side) {
+      if (auto* bridge =
+              remote_cocoa::NativeWidgetNSWindowBridge::GetFromNSWindow(
+                  windows[side])) {
+        bridge->StageFrame(staged_->frames[side]);
+      }
+      if (!still_staged()) break;
+      // Lay out now: the page is told its new size by the layout, which
+      // would otherwise wait for the browser root that is being held.
+      BrowserWindowInterface* browser = browsers_[side];
+      if (auto* view = browser ? BrowserView::GetBrowserViewForBrowser(browser)
+                               : nullptr) {
+        view->InvalidateLayout();
+        view->GetWidget()->LayoutRootViewIfNecessary();
+      }
+    }
+    if (still_staged()) {
+      staged_timer_.Start(FROM_HERE, kStagedPollInterval, this,
+                          &BrowserPair::PollStagedResize);
+    }
+    return true;
+  }
+
+  // From the host, inside its transaction.
+  void CommitStagedPaneFrames() {
+    if (!staged_) return;
+    staged_timer_.Stop();
+    auto weak_this = lifetime_weak_factory_.GetWeakPtr();
+    const std::array<NSRect, 2> frames = staged_->frames;
+    NSWindow* windows[2] = {staged_->windows[0], staged_->windows[1]};
+    const base::TimeTicks started = staged_->started;
+    const base::TimeDelta pages_waited = staged_->pages_waited;
+    const bool pages_timed_out = pages_slow_;
+    bool frames_ready = true;
+    for (size_t side = 0; side < 2 && weak_this; ++side) {
+      const auto native_side = static_cast<HeliumDualPaneSide>(side);
+      auto* bridge = windows[side]
+          ? remote_cocoa::NativeWidgetNSWindowBridge::GetFromNSWindow(
+                windows[side])
+          : nullptr;
+      if (bridge && bridge->HasStagedFrame()) {
+        frames_ready &= bridge->HasStagedCompositorFrame();
+        bridge->CommitStagedFrame();
+      } else if (windows[side] &&
+                 windows[side] == [host_ browserWindowForSide:native_side]) {
+        // Something else has set this pane's frame meanwhile.
+        SetPaneFrame(frames[side], native_side);
+      }
+    }
+    if (!weak_this) return;
+    staged_.reset();
+    if (GetResizeConfig().trace) {
+      LOG(ERROR) << "DualResize staged pages_us="
+                 << pages_waited.InMicroseconds() << " total_us="
+                 << (base::TimeTicks::Now() - started).InMicroseconds()
+                 << " pages_timed_out=" << pages_timed_out
+                 << " frames_ready=" << frames_ready;
+    }
+  }
+
+  // |closing_side|: that pane's widget is being destroyed; its window is
+  // left alone.
+  void CancelStagedResize(std::optional<size_t> closing_side = std::nullopt) {
+    if (!staged_) return;
+    staged_timer_.Stop();
+    NSWindow* windows[2] = {staged_->windows[0], staged_->windows[1]};
+    staged_.reset();
+    auto weak_this = lifetime_weak_factory_.GetWeakPtr();
+    for (size_t side = 0; side < 2 && weak_this; ++side) {
+      if (closing_side && *closing_side == side) continue;
+      if (auto* bridge = windows[side]
+              ? remote_cocoa::NativeWidgetNSWindowBridge::GetFromNSWindow(
+                    windows[side])
+              : nullptr) {
+        bridge->CancelStagedFrame();
+      }
+    }
+  }
+
+  void Show(BrowserView* view, bool activate) {
+    if (activate && IsHidden(view)) SetHidden(view, false);
+    [host_ showAndActivate:NO];
+    if (activate) {
+      [host_ activatePane:NativeSide(RoleOf(view->browser()))];
+    }
+  }
+
+  void Detach(BrowserView* view) {
+    Save();
+    BrowserWindowInterface* browser = view->browser();
+    size_t side = SideIndex(RoleOf(browser));
+    if (browsers_[side] != browser) {
+      return;
+    }
+    CancelStagedResize(view->GetWidget()->IsClosed()
+                           ? std::optional<size_t>(side)
+                           : std::nullopt);
+    if (widget_observations_.IsObservingSource(view->GetWidget())) {
+      widget_observations_.RemoveObservation(view->GetWidget());
+    }
+    if (auto* rail = GetPaneRail(browser);
+        rail && rail_observations_.IsObservingSource(rail)) {
+      rail_observations_.RemoveObservation(rail);
+    }
+    paint_subscriptions_[side] = {};
+    // Native detachment relayouts the surviving pane and can pump compositor
+    // tasks. Remove the closing Browser before that re-entrant callback.
+    browsers_[side] = nullptr;
+    {
+      base::AutoReset<bool> detaching(&detaching_, true);
+      base::AutoReset<bool> left_transition(&visibility_changing_[0], true);
+      base::AutoReset<bool> right_transition(&visibility_changing_[1], true);
+      [host_ detachBrowserWindow:view->GetNativeWindow().GetNativeNSWindow()];
+      RestoreHiddenViews(0);
+      RestoreHiddenViews(1);
+    }
+    close_subscriptions_[side] = {};
+    drag_suspended_[side] = false;
+    if (closing_ && !committing_close_ &&
+        (!waiting_side_ || *waiting_side_ == side)) {
+      CancelClose();
+    }
+    if (!browsers_[0] && !browsers_[1]) {
+      retired_ = true;
+      save_timer_.Stop();
+      [host_ closeAfterBrowserShutdown];
+      weak_factory_.InvalidateWeakPtrs();
+      // Leave the maps while the profile is certainly alive. The last window
+      // of an off-the-record profile can take the profile with it before
+      // another task runs, so nothing deferred may look the profile up.
+      std::unique_ptr<BrowserPair> owned;
+      if (auto p = Pairs().find(profile_.get()); p != Pairs().end()) {
+        auto pair = p->second.find(group_id_);
+        if (pair != p->second.end() && pair->second.get() == this) {
+          owned = std::move(pair->second);
+          p->second.erase(pair);
+        }
+        if (p->second.empty()) {
+          RestoreRemaps().erase(profile_.get());
+          Pairs().erase(p);
+        }
+      }
+      profile_ = nullptr;
+      // Avoid destruction during a native delegate callback or Widget event.
+      if (owned) {
+        base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+            FROM_HERE, std::move(owned));
+      }
+    } else {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&BrowserPair::FinishDetach,
+                                   lifetime_weak_factory_.GetWeakPtr()));
+      ScheduleSave();
+    }
+  }
+
+  void FinishDetach() {
+    if (retired_) return;
+    auto weak_this = lifetime_weak_factory_.GetWeakPtr();
+    [host_ relayout];
+    if (!weak_this) return;
+    for (BrowserWindowInterface* remaining : browsers_) {
+      if (!remaining) continue;
+      if (auto* remaining_view = BrowserView::GetBrowserViewForBrowser(remaining)) {
+        remaining_view->InvalidateLayout();
+        if (auto* widget = remaining_view->GetWidget())
+          widget->LayoutRootViewIfNecessary();
+      }
+      if (!weak_this) return;
+    }
+    InvalidateRails();
+    ScheduleRailStyle();
+    ScheduleZenState();
+  }
+
+  bool IsPaneSuspended(const BrowserView* view) const {
+    return drag_suspended_[SideIndex(RoleOf(view->browser()))];
+  }
+
+  bool SuspendPaneForDrag(BrowserView* view) {
+    const size_t side = SideIndex(RoleOf(view->browser()));
+    auto weak_this = lifetime_weak_factory_.GetWeakPtr();
+    auto weak_view = view->GetAsWeakPtr();
+    if (drag_suspended_[side]) {
+      return true;
+    }
+    if (closing_) {
+      return false;
+    }
+    Save();
+    if (!weak_this || !weak_view) return false;
+    // Detaching any pane makes the remaining pane a single, visible browser.
+    // Restore Views hidden by a collapsed rail before the host clears its
+    // native hidden flags, and remember which side to collapse if Esc cancels
+    // the drag. Suppress the sibling's intermediate layout until both states
+    // agree, then lay it out once at the new size.
+    for (size_t index = 0; index < 2; ++index) {
+      drag_hidden_before_[index] =
+          [host_ isPaneHidden:static_cast<HeliumDualPaneSide>(index)];
+    }
+    const bool had_hidden = drag_hidden_before_[0] || drag_hidden_before_[1];
+    NSWindow* pane = view->GetNativeWindow().GetNativeNSWindow();
+    drag_pane_frames_[side] = pane.frame;
+    if (had_hidden) {
+      base::AutoReset<bool> left_transition(&visibility_changing_[0], true);
+      base::AutoReset<bool> right_transition(&visibility_changing_[1], true);
+      RestoreHiddenViews(0);
+      RestoreHiddenViews(1);
+    }
+    drag_suspended_[side] = true;
+    [host_ detachBrowserWindow:pane];
+    if (!weak_this || !weak_view) return false;
+    view->GetWidget()->OnSizeConstraintsChanged();
+    if (had_hidden && browsers_[1 - side]) {
+      if (auto* remaining =
+              BrowserView::GetBrowserViewForBrowser(browsers_[1 - side])) {
+        remaining->InvalidateLayout();
+        remaining->GetWidget()->LayoutRootViewIfNecessary();
+      }
+    }
+    // An empty host is retained for Esc, but must not cover drop targets.
+    if (![host_ browserWindowForSide:HeliumDualPaneSideLeft] &&
+        ![host_ browserWindowForSide:HeliumDualPaneSideRight]) {
+      [host_.window orderOut:nil];
+    }
+    return true;
+  }
+
+  // Returns true when the pane remains in this pair. A completed tear-off
+  // from a pair with another live pane instead receives a fresh host below.
+  bool ResumePaneAfterDrag(BrowserView* view, bool canceled) {
+    const size_t side = SideIndex(RoleOf(view->browser()));
+    if (!drag_suspended_[side]) {
+      return true;
+    }
+    drag_suspended_[side] = false;
+    const auto hidden_before_drag = drag_hidden_before_;
+    drag_hidden_before_.fill(false);
+    if (!canceled && browsers_[1 - side]) {
+      return false;
+    }
+    NSWindow* pane = view->GetNativeWindow().GetNativeNSWindow();
+    if (!canceled) {
+      const NSRect original = drag_pane_frames_[side];
+      const NSRect current = pane.frame;
+      const NSPoint origin = host_.window.frame.origin;
+      [host_.window setFrameOrigin:
+          NSMakePoint(origin.x + current.origin.x - original.origin.x,
+                      origin.y + current.origin.y - original.origin.y)];
+    }
+    [host_ attachBrowserWindow:pane
+                          side:NativeSide(RoleOf(view->browser()))];
+    view->GetWidget()->OnSizeConstraintsChanged();
+    [host_ showAndActivate:NO];
+    [host_ activatePane:NativeSide(RoleOf(view->browser()))];
+    if (canceled) {
+      for (size_t index = 0; index < 2; ++index) {
+        if (!hidden_before_drag[index] || !browsers_[index]) continue;
+        if (auto* hidden_view =
+                BrowserView::GetBrowserViewForBrowser(browsers_[index])) {
+          SetHidden(hidden_view, true);
+        }
+      }
+    }
+    InvalidateRails();
+    ScheduleRailStyle();
+    ScheduleSave();
+    return true;
+  }
+
+  bool empty() const { return !browsers_[0] && !browsers_[1]; }
+  bool retired() const { return retired_; }
+  // The whole window is being closed, both panes with it.
+  bool closing() const { return closing_; }
+  bool creating_pane() const { return creating_pane_; }
+  BrowserWindowInterface* browser_at(size_t side) const { return browsers_[side]; }
+  HeliumDualWindowHost* host() const { return host_; }
+
+  // The browser for the empty pane on |side|, with a new tab page and not
+  // yet shown; null if there cannot be one. creating_pane_ stays set until
+  // the caller has shown it.
+  BrowserWindowInterface* CreatePane(HeliumDualPaneSide side,
+                                     bool user_gesture) {
+    const size_t index = side == HeliumDualPaneSideRight ? 1 : 0;
+    if (retired_ || closing_ || browsers_[index] || creating_pane_) {
+      return nullptr;
+    }
+    // Both profiles remain shared, exactly as two ordinary browser windows.
+    // The Browser/tab model/navigation controller are independent.
+    if (GetBrowserWindowCreationStatusForProfile(*profile_) !=
+        BrowserWindowInterface::CreationStatus::kOk) {
+      return nullptr;
+    }
+    creating_pane_ = true;
+    BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_NORMAL,
+                                     *profile_, user_gesture);
+    params.should_trigger_session_restore = false;
+    params.helium_dual_group_id = group_id_;
+    params.helium_dual_role =
+        index ? HeliumDualRole::kRight : HeliumDualRole::kLeft;
+    params.helium_dual_ratio = host_.splitRatio;
+    params.helium_dual_host_bounds =
+        base::SysNSStringToUTF8(NSStringFromRect(host_.normalFrame));
+    params.vertical_tab_strip_collapsed = true;
+    BrowserWindowInterface* created = CreateBrowserWindow(std::move(params));
+    chrome::AddAndReturnTabAt(created, GURL(), -1, true);
+    return created;
+  }
+
+  void RequestPane(HeliumDualPaneSide side) {
+    BrowserWindowInterface* created = CreatePane(side, /*user_gesture=*/true);
+    if (!created) {
+      return;
+    }
+    created->GetWindow()->Show();
+    if (auto* view = BrowserView::GetBrowserViewForBrowser(created)) {
+      view->SetFocusToLocationBar(true);
+    }
+    creating_pane_ = false;
+  }
+
+  // Start-up: the empty pane on |side| opens with |urls| as pinned tabs,
+  // which load when first brought to the front, as the pinned tabs of the
+  // window's first pane do. The pane already there stays the one in use;
+  // with |hidden| the new one shows only its tab strip.
+  bool OpenPaneWithPinnedTabs(HeliumDualPaneSide side,
+                              const std::vector<GURL>& urls,
+                              bool hidden) {
+    auto weak_this = lifetime_weak_factory_.GetWeakPtr();
+    BrowserWindowInterface* created = CreatePane(side, /*user_gesture=*/false);
+    if (!created) {
+      return false;
+    }
+    for (const GURL& url : urls) {
+      sessions::SerializedNavigationEntry navigation;
+      navigation.set_index(0);
+      navigation.set_virtual_url(url);
+      chrome::AddRestoredTab(
+          created, base::span_from_ref(navigation),
+          created->GetTabStripModel()->IndexOfFirstNonPinnedTab(),
+          /*selected_navigation=*/0, /*extension_app_id=*/std::string(),
+          /*group=*/std::nullopt, /*select=*/false, /*pin=*/true,
+          /*last_active_time_ticks=*/base::TimeTicks(),
+          /*last_active_time=*/base::Time(), /*storage_namespace=*/nullptr,
+          /*user_agent_override=*/sessions::SerializedUserAgentOverride(),
+          /*extra_data=*/{}, /*from_session_restore=*/false,
+          /*is_active_browser=*/std::nullopt,
+          chrome::RestoredTabLoadPolicy::kDeferUntilActivation);
+    }
+    created->GetWindow()->ShowInactive();
+    if (!weak_this) return true;
+    creating_pane_ = false;
+    auto* view = BrowserView::GetBrowserViewForBrowser(created);
+    if (hidden && view &&
+        browsers_[side == HeliumDualPaneSideRight ? 1 : 0] == created) {
+      SetHidden(view, true);
+    }
+    return true;
+  }
+
+  // Zen mode: the host's resize band beyond |pane| stands in for that pane's
+  // edge trigger. Only a strip that faces |edge| reveals.
+  void RevealZenSideChrome(HeliumDualPaneSide edge, HeliumDualPaneSide pane) {
+    BrowserWindowInterface* browser = browsers_[pane == HeliumDualPaneSideRight ? 1 : 0];
+    auto* view =
+        browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    auto* strip =
+        browser ? tabs::VerticalTabStripStateController::From(browser) : nullptr;
+    if (!view || !strip ||
+        strip->IsTabStripRightAligned() != (edge == HeliumDualPaneSideRight)) {
+      return;
+    }
+    view->RevealZenModeSideChromeFromEdge();
+  }
+
+  void Activated(HeliumDualPaneSide side) {
+    BrowserWindowInterface* browser = browsers_[side == HeliumDualPaneSideRight ? 1 : 0];
+    // AppKit may activate a native child during teardown after Chromium has
+    // removed its Browser from the collection. Do not reactivate that Browser.
+    if (browser && GlobalBrowserCollection::GetInstance()->FindBrowserWithID(
+                       browser->GetSessionID()) == browser) {
+      BrowserActiveStateManager::From(browser)->DidBecomeActive();
+    }
+  }
+
+  void FullscreenChanging(bool fullscreen) {
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (browser) {
+        if (auto* view = BrowserView::GetBrowserViewForBrowser(browser)) {
+          view->PrepareForHeliumDualFullscreen(fullscreen);
+        }
+      }
+    }
+  }
+
+  void SetBounds(const gfx::Rect& bounds) {
+    if (host_.fullscreen || host_.fullscreenTransition) {
+      pending_bounds_ = bounds;
+      [host_ requestFullscreen:NO];
+      return;
+    }
+    NSRect frame = gfx::ScreenRectToNSRect(bounds);
+    const NSSize minimum =
+        [host_.window
+            frameRectForContentRect:NSMakeRect(
+                                        0, 0, host_.window.contentMinSize.width,
+                                        host_.window.contentMinSize.height)]
+            .size;
+    frame.size.width = std::max(frame.size.width, minimum.width);
+    frame.size.height = std::max(frame.size.height, minimum.height);
+    [host_.window setFrame:frame display:YES];
+    [host_ relayout];
+    ScheduleSave();
+  }
+
+  void Restore() {
+    if (host_.fullscreen || host_.fullscreenTransition) {
+      pending_restore_ = true;
+      [host_ requestFullscreen:NO];
+    } else if (host_.window.zoomed) {
+      [host_.window zoom:nil];
+    }
+    [host_ showAndActivate:YES];
+  }
+
+  void FullscreenChanged() {
+    if (!host_.fullscreen && pending_restore_) {
+      pending_restore_ = false;
+      if (host_.window.zoomed) {
+        [host_.window zoom:nil];
+      }
+    }
+    if (!host_.fullscreen && pending_bounds_) {
+      const gfx::Rect bounds = *pending_bounds_;
+      pending_bounds_.reset();
+      SetBounds(bounds);
+    }
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (browser) {
+        if (auto* view = BrowserView::GetBrowserViewForBrowser(browser)) {
+          view->FullscreenStateChanged();
+        }
+      }
+    }
+    ScheduleZenState();
+    ScheduleSave();
+  }
+
+  void ScheduleSave() {
+    UpdateLiveGeometry();
+    save_timer_.Start(FROM_HERE, base::Milliseconds(200), this,
+                      &BrowserPair::Save);
+  }
+
+  void UpdateLiveGeometry() {
+    std::string bounds =
+        base::SysNSStringToUTF8(NSStringFromRect(host_.normalFrame));
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (browser) {
+        HeliumDualPaneState::From(browser)->set_ratio(host_.splitRatio);
+        HeliumDualPaneState::From(browser)->set_host_bounds(bounds);
+      }
+    }
+  }
+
+  void Save() {
+    UpdateLiveGeometry();
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (!browser) {
+        continue;
+      }
+      if (SessionService* service =
+              SessionServiceFactory::GetForProfile(browser->GetProfile())) {
+        const auto data = MakeExtraData(group_id_, RoleOf(browser),
+                                        HeliumDualPaneState::From(browser)->ratio(),
+                                        HeliumDualPaneState::From(browser)->host_bounds());
+        for (const auto& [key, value] : data) {
+          service->AddWindowExtraData(browser->GetSessionID(), key.c_str(),
+                                      value);
+        }
+      }
+    }
+  }
+
+  void RequestClose() {
+    if (retired_ || closing_) {
+      return;
+    }
+    Save();
+    closing_ = true;
+    PreflightWarnings(0);
+  }
+
+ private:
+  struct StagedResize {
+    uint64_t id = 0;
+    std::array<NSRect, 2> frames;
+    NSWindow* __weak windows[2];
+    base::TimeTicks started;
+    // Of the wait for the pages, then of the wait for the browser frames.
+    base::TimeTicks deadline;
+    bool pages_done = false;
+    base::TimeDelta pages_waited;
+    // Held until the pages have drawn.
+    std::vector<std::unique_ptr<ui::CompositorLock>> locks;
+    // Keeps the pages' resize deadline, and knows whether they have drawn.
+    ScopedNativeContentsResize contents;
+  };
+
+  void PollStagedResize() {
+    if (!staged_) {
+      staged_timer_.Stop();
+      return;
+    }
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (!staged_->pages_done) {
+      const bool pending = staged_->contents.HasPendingFrame();
+      if (pending && now < staged_->deadline) return;
+      pages_slow_ = pending;
+      staged_->pages_done = true;
+      staged_->pages_waited = now - staged_->started;
+      staged_->locks.clear();
+      staged_->deadline = now + kStagedFrameWait;
+    }
+    bool ready = true;
+    for (NSWindow* window : staged_->windows) {
+      auto* bridge = window
+          ? remote_cocoa::NativeWidgetNSWindowBridge::GetFromNSWindow(window)
+          : nullptr;
+      // A pane that is gone, or whose frame was set by something else, is
+      // not waited for.
+      ready &= !bridge || !bridge->HasStagedFrame() ||
+               bridge->HasStagedCompositorFrame();
+    }
+    if (!ready && now < staged_->deadline) return;
+    staged_timer_.Stop();
+    auto weak_this = lifetime_weak_factory_.GetWeakPtr();
+    const uint64_t id = staged_->id;
+    [host_ stagedPaneFramesAreReady];
+    // A host that no longer expected these frames did not commit them.
+    if (weak_this && staged_ && staged_->id == id) {
+      CancelStagedResize();
+    }
+  }
+
+  void OnCloseCancelled(BrowserWindowInterface*,
+                        BrowserWindowInterface::ClosingStatus status) {
+    // Chromium also emits this notification while accepted unload handlers
+    // finish asynchronously. That is progress, not a rejected close.
+    if (committing_close_ &&
+        (status == BrowserWindowInterface::ClosingStatus::kDeniedByUser ||
+         status == BrowserWindowInterface::ClosingStatus::kDeniedByPolicy)) {
+      CancelClose();
+    }
+  }
+
+  void CancelClose() {
+    if (!prepared_session_ids_.empty()) {
+      if (SessionService* service =
+              SessionServiceFactory::GetForProfile(profile_)) {
+        service->CancelWindowCloseGroup(prepared_session_ids_);
+      }
+      prepared_session_ids_.clear();
+    }
+    closing_ = false;
+    committing_close_ = false;
+    waiting_side_.reset();
+    weak_factory_.InvalidateWeakPtrs();
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (browser) {
+        UnloadController::From(browser)->ResetBeforeUnloadForShutdown();
+      }
+    }
+  }
+
+  void PreflightWarnings(size_t side) {
+    if (!closing_) {
+      return;
+    }
+    if (side == browsers_.size()) {
+      PreflightBeforeUnload(0);
+      return;
+    }
+    BrowserWindowInterface* browser = browsers_[side];
+    if (!browser) {
+      PreflightWarnings(side + 1);
+      return;
+    }
+    using Result = UnloadController::WarnBeforeClosingResult;
+    waiting_side_ = side;
+    auto callback = base::BindOnce(&BrowserPair::OnWarning,
+                                   weak_factory_.GetWeakPtr(), side);
+    bool last_occupied = true;
+    for (size_t next = side + 1; next < browsers_.size(); ++next) {
+      last_occupied = last_occupied && !browsers_[next];
+    }
+    Result result;
+    if (last_occupied) {
+      std::vector<BrowserWindowInterface*> closing_group;
+      for (BrowserWindowInterface* member : browsers_) {
+        if (member) {
+          closing_group.push_back(member);
+        }
+      }
+      result = UnloadController::From(browser)->MaybeWarnBeforeClosingForGroup(
+          std::move(callback), closing_group);
+    } else {
+      result = UnloadController::From(browser)->MaybeWarnBeforeClosing(
+          std::move(callback));
+    }
+    if (result == Result::kOkToClose) {
+      waiting_side_.reset();
+      PreflightWarnings(side + 1);
+    }
+  }
+
+  void OnWarning(size_t side,
+                 UnloadController::WarnBeforeClosingResult result) {
+    waiting_side_.reset();
+    if (result == UnloadController::WarnBeforeClosingResult::kOkToClose) {
+      // Helium can present multiple warnings in stages (multiple tabs, then
+      // downloads). Advance only after a synchronous all-clear.
+      PreflightWarnings(side);
+    } else {
+      CancelClose();
+    }
+  }
+
+  void PreflightBeforeUnload(size_t side) {
+    if (!closing_) {
+      return;
+    }
+    if (side == browsers_.size()) {
+      Save();
+      for (BrowserWindowInterface* browser : browsers_) {
+        if (browser) {
+          prepared_session_ids_.push_back(browser->GetSessionID());
+        }
+      }
+      SessionService* service = SessionServiceFactory::GetForProfile(profile_);
+      if (!service ||
+          !service->PrepareForWindowCloseGroup(prepared_session_ids_)) {
+        prepared_session_ids_.clear();
+      }
+      committing_close_ = true;
+      for (BrowserWindowInterface* browser : browsers_) {
+        // Close can synchronously notify cancellation (policy or a late
+        // download). Preserve the sibling when that happens.
+        if (!committing_close_) {
+          break;
+        }
+        if (browser) {
+          browser->GetWindow()->Close();
+        }
+      }
+      return;
+    }
+    BrowserWindowInterface* browser = browsers_[side];
+    if (!browser) {
+      PreflightBeforeUnload(side + 1);
+      return;
+    }
+    waiting_side_ = side;
+    bool waiting = UnloadController::From(browser)->RunBeforeUnloadForShutdown(
+        false, base::BindRepeating(&BrowserPair::OnBeforeUnload,
+                                   weak_factory_.GetWeakPtr(), side));
+    if (!waiting) {
+      waiting_side_.reset();
+      PreflightBeforeUnload(side + 1);
+    }
+  }
+
+  void OnBeforeUnload(size_t side, bool proceed) {
+    waiting_side_.reset();
+    if (proceed) {
+      PreflightBeforeUnload(side + 1);
+    } else {
+      CancelClose();
+    }
+  }
+
+  // Null once retired: the profile may be destroyed before this pair is.
+  raw_ptr<Profile> profile_;
+  const std::string group_id_;
+  std::array<raw_ptr<BrowserWindowInterface>, 2> browsers_{};
+  std::array<bool, 2> drag_suspended_{};
+  std::array<bool, 2> drag_hidden_before_{};
+  std::array<NSRect, 2> drag_pane_frames_{};
+  std::array<std::vector<std::pair<std::unique_ptr<views::ViewTracker>, bool>>, 2> hidden_views_;
+  std::array<bool, 2> visibility_changing_ = {};
+  std::array<base::CallbackListSubscription, 2> close_subscriptions_;
+  std::vector<SessionID> prepared_session_ids_;
+  HeliumDualWindowHost* __strong host_;
+  HeliumDualBrowserDelegate* __strong delegate_;
+  bool retired_ = false;
+  bool creating_pane_ = false;
+  bool detaching_ = false;
+  bool closing_ = false;
+  bool committing_close_ = false;
+  std::optional<size_t> waiting_side_;
+  std::optional<gfx::Rect> pending_bounds_;
+  bool pending_restore_ = false;
+  std::array<base::CallbackListSubscription, 2> paint_subscriptions_;
+  base::ScopedMultiSourceObservation<views::Widget, views::WidgetObserver>
+      widget_observations_{this};
+  base::ScopedMultiSourceObservation<views::View, views::ViewObserver>
+      rail_observations_{this};
+  std::optional<RailStyleInputs> rail_style_inputs_;
+  // Settled vertical extent of the visible pane's floating strip.
+  int floating_top_ = kZenFloatingPadding;
+  int floating_bottom_ = kZenFloatingPadding;
+  __weak NSWindow* window_controls_owner_ = nil;
+  // A divider gesture's frames, staged but not yet committed.
+  std::optional<StagedResize> staged_;
+  uint64_t staged_resize_count_ = 0;
+  // A page missed the last staged step's wait.
+  bool pages_slow_ = false;
+  base::RepeatingTimer staged_timer_;
+  base::OneShotTimer rail_style_timer_;
+  base::OneShotTimer zen_state_timer_;
+  base::OneShotTimer save_timer_;
+  // Close cancellation invalidates asynchronous close/preflight callbacks,
+  // but a live pair still needs its synchronous resize/drag liveness checks.
+  base::WeakPtrFactory<BrowserPair> weak_factory_{this};
+  base::WeakPtrFactory<BrowserPair> lifetime_weak_factory_{this};
+};
