+TEST_F(HeliumDualBrowserHostTest, HiddenBrowserViewsAttachRefreshAndDetach) {
+  BrowserView* left = browser_view();
+  ASSERT_EQ(HeliumDualRole::kLeft, left->browser()->helium_dual_role());
+  ASSERT_FALSE(left->GetWidget()->IsVisible());
+  NSWindow* left_window = left->GetNativeWindow().GetNativeNSWindow();
+  ASSERT_TRUE(left_window);
+  ASSERT_FALSE(left_window.parentWindow);
+
+  auto* left_elements = BrowserElementsViews::From(left->browser());
+  ASSERT_TRUE(left_elements);
+  auto* left_rail = left->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(left_rail);
+  const auto left_regions = left_elements->GetAllViews(
+      kTabStripRegionElementId, /*require_visible=*/false);
+  EXPECT_NE(left_regions.end(),
+            std::find(left_regions.begin(), left_regions.end(), left_rail));
+  EXPECT_TRUE(left_elements
+                  ->GetAllViews(kTabStripRegionElementId,
+                                /*require_visible=*/true)
+                  .empty());
+
+  // Invoke the production adapter, including Attach and the immediate theme
+  // refresh, without showing or activating a window. The old BrowserView
+  // GetViewByElementId call aborted here before a host could finish attaching.
+  helium_dual::EnsureHost(left);
+  NSWindow* host = left_window.parentWindow;
+  ASSERT_TRUE(host);
+  EXPECT_FALSE(host.visible);
+  EXPECT_EQ(1u, host.childWindows.count);
+  EXPECT_TRUE(helium_dual::HostBounds(left, /*restored=*/false).has_value());
+  helium_dual::EnsureHost(left);
+  EXPECT_EQ(host, left_window.parentWindow);
+  EXPECT_EQ(1u, host.childWindows.count);
+
+  Browser* right_browser =
+      CreateBrowserWithBrowserView(profile(), Browser::TYPE_NORMAL);
+  BrowserView* right = BrowserView::GetBrowserViewForBrowser(right_browser);
+  ASSERT_TRUE(right);
+  ASSERT_EQ(HeliumDualRole::kRight, right_browser->helium_dual_role());
+  ASSERT_FALSE(right->GetWidget()->IsVisible());
+  auto* right_elements = BrowserElementsViews::From(right_browser);
+  ASSERT_TRUE(right_elements);
+  EXPECT_NE(left_elements->GetContext(), right_elements->GetContext());
+  auto* right_rail = right->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(right_rail);
+  const auto right_regions = right_elements->GetAllViews(
+      kTabStripRegionElementId, /*require_visible=*/false);
+  EXPECT_NE(right_regions.end(),
+            std::find(right_regions.begin(), right_regions.end(), right_rail));
+  EXPECT_EQ(right_regions.end(),
+            std::find(right_regions.begin(), right_regions.end(), left_rail));
+
+  helium_dual::EnsureHost(right);
+  NSWindow* right_window = right->GetNativeWindow().GetNativeNSWindow();
+  EXPECT_EQ(host, right_window.parentWindow);
+  EXPECT_EQ(2u, host.childWindows.count);
+  // Bounds changes exercise the coalesced production rail-style refresh.
+  left_rail->SetBoundsRect(left_rail->bounds() + gfx::Vector2d(0, 1));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(host.visible);
+
+  // Detach used the same prohibited BrowserView API in the original change.
+  // Keep the remaining pane alive and then drain deferred host destruction.
+  helium_dual::DetachFromHost(right);
+  EXPECT_FALSE(right_window.parentWindow);
+  EXPECT_EQ(host, left_window.parentWindow);
+  EXPECT_EQ(1u, host.childWindows.count);
+  helium_dual::DetachFromHost(left);
+  EXPECT_FALSE(left_window.parentWindow);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(helium_dual::HostBounds(left, /*restored=*/false).has_value());
+}
