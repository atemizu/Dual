+BrowserPair* Find(const BrowserView* view) {
+  const BrowserWindowInterface* browser = view ? view->browser() : nullptr;
+  if (!browser) {
+    return nullptr;
+  }
+  auto profile = Pairs().find(browser->GetProfile());
+  if (profile == Pairs().end()) {
+    return nullptr;
+  }
+  auto pair =
+      profile->second.find(HeliumDualPaneState::From(browser)->group_id());
+  if (pair == profile->second.end() || !pair->second ||
+      pair->second->retired() ||
+      pair->second->browser_at(SideIndex(RoleOf(browser))) != browser) {
+    return nullptr;
+  }
+  return pair->second.get();
+}
