+// Created by Dual contributors on 2026-10-23. Licensed under GPL-3.0; see the
+// LICENSE file.
+
+#include "chrome/browser/ui/views/frame/browser_native_widget_dual_pane_linux.h"
+
+#include <set>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/ui/helium/helium_dual_browser.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/browser_widget.h"
+#include "content/public/browser/keyboard_event_processing_result.h"
+#include "ui/base/mojom/window_show_state.mojom.h"
+#include "ui/display/display.h"
+
+namespace {
+
+std::set<const BrowserNativeWidget*>& Panes() {
+  static base::NoDestructor<std::set<const BrowserNativeWidget*>> panes;
+  return *panes;
+}
+
+}  // namespace
+
+BrowserNativeWidgetDualPane::BrowserNativeWidgetDualPane(
+    BrowserWidget* browser_widget,
+    BrowserView* browser_view)
+    : views::NativeWidgetAura(browser_widget),
+      browser_view_(browser_view),
+      browser_widget_(browser_widget) {
+  Panes().insert(this);
+}
+
+BrowserNativeWidgetDualPane::~BrowserNativeWidgetDualPane() {
+  Panes().erase(this);
+}
+
+// static
+bool BrowserNativeWidgetDualPane::IsDualPane(
+    const BrowserNativeWidget* native_widget) {
+  return native_widget && Panes().contains(native_widget);
+}
+
+views::Widget::InitParams BrowserNativeWidgetDualPane::GetWidgetParams(
+    views::Widget::InitParams::Ownership ownership) {
+  views::Widget::InitParams params(ownership);
+  params.native_widget = this;
+  // A top-level window of the shared window's own window tree: it has its
+  // own focus and can be the active one, like the browser window it is.
+  params.parent = helium_dual::ReservePaneHost(browser_view_);
+  params.bounds = helium_dual::PaneBoundsInScreen(browser_view_);
+  return params;
+}
+
+bool BrowserNativeWidgetDualPane::UseCustomFrame() const {
+  return true;
+}
+
+bool BrowserNativeWidgetDualPane::UsesNativeSystemMenu() const {
+  return false;
+}
+
+bool BrowserNativeWidgetDualPane::ShouldSaveWindowPlacement() const {
+  return true;
+}
+
+// What is saved for the next window: the shared window's size and state.
+void BrowserNativeWidgetDualPane::GetWindowPlacement(
+    gfx::Rect* bounds,
+    ui::mojom::WindowShowState* show_state) const {
+  *bounds = GetRestoredBounds();
+  if (helium_dual::HostIsMaximized(browser_view_).value_or(false)) {
+    *show_state = ui::mojom::WindowShowState::kMaximized;
+  } else if (IsMinimized()) {
+    *show_state = ui::mojom::WindowShowState::kMinimized;
+  } else {
+    *show_state = ui::mojom::WindowShowState::kNormal;
+  }
+}
+
+content::KeyboardEventProcessingResult
+BrowserNativeWidgetDualPane::PreHandleKeyboardEvent(
+    const input::NativeWebKeyboardEvent& event) {
+  return content::KeyboardEventProcessingResult::NOT_HANDLED;
+}
+
+bool BrowserNativeWidgetDualPane::HandleKeyboardEvent(
+    const input::NativeWebKeyboardEvent& event) {
+  return false;
+}
+
+// The shared window has its own size; the pane's is set from it.
+bool BrowserNativeWidgetDualPane::ShouldRestorePreviousBrowserWidgetState()
+    const {
+  return false;
+}
+
+bool BrowserNativeWidgetDualPane::ShouldUseInitialVisibleOnAllWorkspaces()
+    const {
+  return true;
+}
+
+void BrowserNativeWidgetDualPane::Show(ui::mojom::WindowShowState show_state,
+                                       const gfx::Rect& restore_bounds) {
+  // A pane itself is only ever shown or not; the state is the window's.
+  views::NativeWidgetAura::Show(
+      show_state == ui::mojom::WindowShowState::kInactive
+          ? ui::mojom::WindowShowState::kInactive
+          : ui::mojom::WindowShowState::kNormal,
+      gfx::Rect());
+  helium_dual::ShowPaneWindow(browser_view_, show_state);
+}
+
+void BrowserNativeWidgetDualPane::Activate() {
+  helium_dual::ActivatePaneWindow(browser_view_);
+  views::NativeWidgetAura::Activate();
+}
+
+void BrowserNativeWidgetDualPane::Maximize() {
+  helium_dual::ZoomHost(browser_view_);
+}
+
+void BrowserNativeWidgetDualPane::Minimize() {
+  helium_dual::MinimizeHost(browser_view_);
+}
+
+bool BrowserNativeWidgetDualPane::IsMaximized() const {
+  return helium_dual::HostIsMaximized(browser_view_).value_or(false);
+}
+
+bool BrowserNativeWidgetDualPane::IsMinimized() const {
+  return helium_dual::HostIsMinimized(browser_view_).value_or(false);
+}
+
+void BrowserNativeWidgetDualPane::Restore() {
+  helium_dual::RestoreHost(browser_view_);
+}
+
+void BrowserNativeWidgetDualPane::SetFullscreen(bool fullscreen,
+                                                int64_t target_display_id) {
+  helium_dual::RequestHostFullscreen(browser_view_, fullscreen,
+                                     target_display_id);
+}
+
+bool BrowserNativeWidgetDualPane::IsFullscreen() const {
+  return helium_dual::HostIsFullscreen(browser_view_).value_or(false);
+}
+
+gfx::Rect BrowserNativeWidgetDualPane::GetRestoredBounds() const {
+  if (auto bounds = helium_dual::HostBounds(browser_view_, /*restored=*/true)) {
+    return *bounds;
+  }
+  return views::NativeWidgetAura::GetRestoredBounds();
+}
+
+bool BrowserNativeWidgetDualPane::SetWindowTitle(const std::u16string& title) {
+  const bool changed = views::NativeWidgetAura::SetWindowTitle(title);
+  helium_dual::PaneTitleChanged(browser_view_);
+  return changed;
+}
+
+void BrowserNativeWidgetDualPane::FlashFrame(bool flash) {
+  helium_dual::FlashHost(browser_view_, flash);
+}
+
+// A tab dragged out of a window makes a new window and moves it with the
+// pointer; for a pane, that is the shared window around it.
+views::Widget::MoveLoopResult BrowserNativeWidgetDualPane::RunMoveLoop(
+    const gfx::Vector2d& drag_offset,
+    views::Widget::MoveLoopSource source,
+    views::Widget::MoveLoopEscapeBehavior escape_behavior) {
+  return helium_dual::RunHostMoveLoop(browser_view_, drag_offset, source,
+                                      escape_behavior);
+}
+
+void BrowserNativeWidgetDualPane::EndMoveLoop() {
+  helium_dual::EndHostMoveLoop(browser_view_);
+}
