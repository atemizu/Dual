+// A launch button was pressed: open a browser in the empty pane.
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+              didRequestPane:(HeliumDualPaneSide)side;
+// Preflight both browsers' beforeunload handlers, then close them normally.
+// Call closeAfterBrowserShutdown only after both native panes are detached.
+- (void)heliumDualWindowHostDidRequestClose:(HeliumDualWindowHost*)host;
+@optional
+// Resize both panes in one transaction through Chromium's bridge. Separate
+// callbacks can expose the right pane's old drawing at its new screen origin.
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+          setLeftPaneFrame:(NSRect)leftFrame
+            rightPaneFrame:(NSRect)rightFrame;
+// A divider drag resizes the panes in two steps, so that a page that is slow
+// to draw at its new width never leaves a blank band. First the delegate has
+// both panes draw for these frames while they keep their present frames and
+// contents, and calls -stagedPaneFramesAreReady when they have (or when it
+// stops waiting). Returns NO if it cannot; the host then sets the frames
+// directly.
+- (BOOL)heliumDualWindowHost:(HeliumDualWindowHost*)host
+          stageLeftPaneFrame:(NSRect)leftFrame
+              rightPaneFrame:(NSRect)rightFrame;
