+      [[NSMenuItem alloc] initWithTitle:@"Close Tab"
+                                 action:@selector(commandDispatch:)
+                          keyEquivalent:@"w"];
+  close_tab.tag = IDC_CLOSE_TAB;
+  ASSERT_TRUE([right_window validateUserInterfaceItem:close_tab]);
+  // Previously NO: app-level _menuState does not contain IDC_CLOSE_TAB.
+  EXPECT_TRUE([app_controller validateUserInterfaceItem:close_tab]);
+  EXPECT_FALSE(menu_test_activation_target);
+
+  // Keep the actual selected pane's disabled state instead of blanket-enabling
+  // commands just because another pane supports them.
+  chrome::UpdateCommandEnabled(right_browser, IDC_CLOSE_TAB, false);
+  EXPECT_TRUE([left_window validateUserInterfaceItem:close_tab]);
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+  chrome::UpdateCommandEnabled(right_browser, IDC_CLOSE_TAB, true);
+  ASSERT_TRUE([app_controller validateUserInterfaceItem:close_tab]);
+  [app_controller commandDispatch:close_tab];
+  EXPECT_EQ(right_window, menu_test_activation_target);
+  EXPECT_EQ(1, right_browser->tab_strip_model()->count());
+  EXPECT_EQ(1, left->browser()->tab_strip_model()->count());
+  EXPECT_EQ(host, left_window.parentWindow);
+  EXPECT_EQ(host, right_window.parentWindow);
+
+  // A Dock action must not be reinterpreted as this host's browser action.
+  close_tab.action = @selector(commandFromDock:);
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+  close_tab.action = @selector(commandDispatch:);
+  // Ordinary windows and a missing key window retain app-level validation.
+  menu_test_key_window = left_window;
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+  menu_test_key_window = nil;
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+
+  EXPECT_FALSE(host.visible);
+  // The host can outlive its last pane until deferred destruction runs.
+  helium_dual::DetachFromHost(right);
+  helium_dual::DetachFromHost(left);
+  menu_test_key_window = host;
+  EXPECT_FALSE(helium_dual::BrowserWindowForHost(gfx::NativeWindow(host)));
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+  menu_test_key_window = nil;
+  menu_test_activation_target = nil;
+  base::RunLoop().RunUntilIdle();
+}
