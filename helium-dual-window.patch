+TEST_F(SessionServiceTest, HeliumDualLastHostPreservesBothPanes) {
+  const SessionID right_id = SessionID::NewUnique();
+  const SessionID left_tab = SessionID::NewUnique();
+  const SessionID right_tab = SessionID::NewUnique();
+  SerializedNavigationEntry left_nav;
+  SerializedNavigationEntry right_nav;
+  CreateAndWriteSessionWithTwoWindows(right_id, left_tab, right_tab, &left_nav,
+                                      &right_nav);
+  ASSERT_TRUE(service()->PrepareForWindowCloseGroup({window_id, right_id}));
+  EXPECT_FALSE(helper_.GetHasOpenTrackableBrowsers());
+  service()->WindowClosing(window_id);
+  service()->TabClosed(window_id, left_tab);
+  service()->WindowClosed(window_id);
+  service()->WindowClosing(right_id);
+  service()->TabClosed(right_id, right_tab);
+  service()->WindowClosed(right_id);
+
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  ReadWindows(&windows, nullptr, nullptr, nullptr);
+  ASSERT_EQ(2U, windows.size());
+  std::set<SessionID> restored;
+  for (const auto& window : windows) {
+    restored.insert(window->window_id);
+    ASSERT_EQ(1U, window->tabs.size());
+    EXPECT_EQ(window->window_id == window_id ? left_tab : right_tab,
+              window->tabs[0]->tab_id);
+  }
+  EXPECT_EQ((std::set<SessionID>{window_id, right_id}), restored);
+}
+
+TEST_F(SessionServiceTest, HeliumDualOtherTrackedWindowPreventsPendingGroup) {
+  const SessionID right_id = SessionID::NewUnique();
+  const SessionID third_id = SessionID::NewUnique();
+  const SessionID left_tab = SessionID::NewUnique();
+  const SessionID right_tab = SessionID::NewUnique();
+  SerializedNavigationEntry left_nav;
+  SerializedNavigationEntry right_nav;
+  CreateAndWriteSessionWithTwoWindows(right_id, left_tab, right_tab, &left_nav,
+                                      &right_nav);
+  service()->SetWindowType(third_id, Browser::TYPE_NORMAL);
+  service()->SetWindowBounds(third_id, window_bounds,
+                             ui::mojom::WindowShowState::kNormal);
+  CreateTabWithTestNavigationData(third_id, 0);
+  EXPECT_FALSE(service()->PrepareForWindowCloseGroup({window_id, right_id}));
+  service()->WindowClosing(window_id);
+  service()->TabClosed(window_id, left_tab);
+  service()->WindowClosed(window_id);
+  service()->WindowClosing(right_id);
+  service()->TabClosed(right_id, right_tab);
+  service()->WindowClosed(right_id);
+
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  ReadWindows(&windows, nullptr, nullptr, nullptr);
+  ASSERT_EQ(1U, windows.size());
+  EXPECT_EQ(third_id, windows[0]->window_id);
+}
+
+TEST_F(SessionServiceTest, HeliumDualCancelledGroupResumesLiveTracking) {
+  const SessionID right_id = SessionID::NewUnique();
+  const SessionID left_tab = SessionID::NewUnique();
+  const SessionID right_tab = SessionID::NewUnique();
+  SerializedNavigationEntry left_nav;
+  SerializedNavigationEntry right_nav;
+  CreateAndWriteSessionWithTwoWindows(right_id, left_tab, right_tab, &left_nav,
+                                      &right_nav);
+  ASSERT_TRUE(service()->PrepareForWindowCloseGroup({window_id, right_id}));
+  service()->CancelWindowCloseGroup({window_id, right_id});
+  EXPECT_TRUE(helper_.GetHasOpenTrackableBrowsers());
+  const SessionID new_tab = CreateTabWithTestNavigationData(right_id, 1);
