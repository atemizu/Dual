+#import <Cocoa/Cocoa.h>
+
+#include <algorithm>
+#include <memory>
+#include <string>
+
+#include "base/apple/scoped_objc_class_swizzler.h"
+#include "base/run_loop.h"
+#include "base/uuid.h"
+#include "chrome/app/chrome_command_ids.h"
+#import "chrome/browser/app_controller_mac.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_element_identifiers.h"
+#include "chrome/browser/ui/helium/helium_dual_browser_mac.h"
+#include "chrome/browser/ui/helium/helium_dual_state.h"
+#import "chrome/browser/ui/helium/helium_dual_window_host_mac.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/test_with_browser_view.h"
+#include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/interaction/browser_elements_views.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+NSWindow* menu_test_key_window;
+NSWindow* menu_test_activation_target;
+
+struct ResetMenuRoutingTestState {
+  ~ResetMenuRoutingTestState() {
+    menu_test_key_window = nil;
+    menu_test_activation_target = nil;
+  }
+};
+
+}  // namespace
+
+// Hold the OS focus boundary at the shell without showing a window or sending
+// input to other applications. Validation and command handling remain the real
+// AppController -> BrowserWidget -> BrowserCommandController implementation.
+@interface HeliumDualMenuRoutingTestState : NSObject
+- (NSWindow*)keyWindow;
+- (void)makeKeyAndOrderFront:(id)sender;
+@end
+
+@implementation HeliumDualMenuRoutingTestState
+- (NSWindow*)keyWindow {
+  return menu_test_key_window;
+}
+- (void)makeKeyAndOrderFront:(id)sender {
+  menu_test_activation_target = static_cast<NSWindow*>(self);
+}
+@end
+
+class HeliumDualBrowserHostTest : public TestWithBrowserView {
+ protected:
+  std::unique_ptr<Browser> CreateBrowser(
+      Profile* profile,
+      Browser::Type browser_type,
+      bool hosted_app,
+      BrowserWindow* browser_window) override {
+    CHECK_EQ(Browser::TYPE_NORMAL, browser_type);
+    CHECK(!hosted_app);
+    CHECK(!browser_window);
+    Browser::CreateParams params(profile, /*user_gesture=*/false);
+    params.helium_dual_group_id = group_id_;
+    params.helium_dual_role =
+        created_browser_ ? HeliumDualRole::kRight : HeliumDualRole::kLeft;
+    params.vertical_tab_strip_collapsed = true;
+    params.should_trigger_session_restore = false;
+    created_browser_ = true;
+    return Browser::DeprecatedCreateOwnedForTesting(params);
+  }
+
+ private:
+  const std::string group_id_ =
+      base::Uuid::GenerateRandomV4().AsLowercaseString();
+  bool created_browser_ = false;
+};
+
+TEST_F(HeliumDualBrowserHostTest, HiddenBrowserViewsAttachRefreshAndDetach) {
+  BrowserView* left = browser_view();
+  ASSERT_EQ(HeliumDualRole::kLeft, left->browser()->helium_dual_role());
+  ASSERT_FALSE(left->GetWidget()->IsVisible());
+  NSWindow* left_window = left->GetNativeWindow().GetNativeNSWindow();
+  ASSERT_TRUE(left_window);
+  ASSERT_FALSE(left_window.parentWindow);
+
+  auto* left_elements = BrowserElementsViews::From(left->browser());
+  ASSERT_TRUE(left_elements);
+  auto* left_rail = left->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(left_rail);
+  const auto left_regions = left_elements->GetAllViews(
+      kTabStripRegionElementId, /*require_visible=*/false);
+  EXPECT_NE(left_regions.end(),
+            std::find(left_regions.begin(), left_regions.end(), left_rail));
+  EXPECT_TRUE(left_elements
+                  ->GetAllViews(kTabStripRegionElementId,
+                                /*require_visible=*/true)
+                  .empty());
+
+  // Invoke the production adapter, including Attach and the immediate theme
+  // refresh, without showing or activating a window. The old BrowserView
+  // GetViewByElementId call aborted here before a host could finish attaching.
+  helium_dual::EnsureHost(left);
+  NSWindow* host = left_window.parentWindow;
+  ASSERT_TRUE(host);
+  EXPECT_FALSE(host.visible);
+  EXPECT_EQ(1u, host.childWindows.count);
+  EXPECT_TRUE(helium_dual::HostBounds(left, /*restored=*/false).has_value());
+  helium_dual::EnsureHost(left);
+  EXPECT_EQ(host, left_window.parentWindow);
+  EXPECT_EQ(1u, host.childWindows.count);
+
+  Browser* right_browser =
+      CreateBrowserWithBrowserView(profile(), Browser::TYPE_NORMAL);
+  BrowserView* right = BrowserView::GetBrowserViewForBrowser(right_browser);
+  ASSERT_TRUE(right);
+  ASSERT_EQ(HeliumDualRole::kRight, right_browser->helium_dual_role());
+  ASSERT_FALSE(right->GetWidget()->IsVisible());
+  auto* right_elements = BrowserElementsViews::From(right_browser);
+  ASSERT_TRUE(right_elements);
+  EXPECT_NE(left_elements->GetContext(), right_elements->GetContext());
+  auto* right_rail = right->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(right_rail);
+  const auto right_regions = right_elements->GetAllViews(
+      kTabStripRegionElementId, /*require_visible=*/false);
+  EXPECT_NE(right_regions.end(),
+            std::find(right_regions.begin(), right_regions.end(), right_rail));
+  EXPECT_EQ(right_regions.end(),
+            std::find(right_regions.begin(), right_regions.end(), left_rail));
+
+  helium_dual::EnsureHost(right);
+  NSWindow* right_window = right->GetNativeWindow().GetNativeNSWindow();
+  EXPECT_EQ(host, right_window.parentWindow);
+  EXPECT_EQ(2u, host.childWindows.count);
+  // Bounds changes exercise the coalesced production rail-style refresh.
+  left_rail->SetBoundsRect(left_rail->bounds() + gfx::Vector2d(0, 1));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(host.visible);
+
+  // Detach used the same prohibited BrowserView API in the original change.
+  // Keep the remaining pane alive and then drain deferred host destruction.
+  helium_dual::DetachFromHost(right);
+  EXPECT_FALSE(right_window.parentWindow);
+  EXPECT_EQ(host, left_window.parentWindow);
+  EXPECT_EQ(1u, host.childWindows.count);
+  helium_dual::DetachFromHost(left);
+  EXPECT_FALSE(left_window.parentWindow);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(helium_dual::HostBounds(left, /*restored=*/false).has_value());
+}
+
+TEST_F(HeliumDualBrowserHostTest,
+       HostKeyMenuValidatesAndClosesOnlyActivePaneTab) {
+  BrowserView* left = browser_view();
+  Browser* right_browser =
+      CreateBrowserWithBrowserView(profile(), Browser::TYPE_NORMAL);
+  BrowserView* right = BrowserView::GetBrowserViewForBrowser(right_browser);
+  ASSERT_TRUE(right);
+  AddTab(left->browser(), GURL("about:blank"));
+  AddTab(right_browser, GURL("about:blank"));
+  AddTab(right_browser, GURL("about:blank"));
+  helium_dual::EnsureHost(left);
+  helium_dual::EnsureHost(right);
+  NSWindow* left_window = left->GetNativeWindow().GetNativeNSWindow();
+  NSWindow* right_window = right->GetNativeWindow().GetNativeNSWindow();
+  NSWindow* host = right_window.parentWindow;
+  ASSERT_TRUE(host);
+  ASSERT_EQ(host, left_window.parentWindow);
+  ASSERT_TRUE([host.delegate isKindOfClass:HeliumDualWindowHost.class]);
+  HeliumDualWindowHost* host_controller =
+      static_cast<HeliumDualWindowHost*>(host.delegate);
+
+  AppController* app_controller = AppController.sharedController;
+  base::apple::ScopedObjCClassSwizzler key_window_swizzler(
+      [NSApp class], HeliumDualMenuRoutingTestState.class,
+      @selector(keyWindow));
+  base::apple::ScopedObjCClassSwizzler activation_swizzler(
+      [right_window class], HeliumDualMenuRoutingTestState.class,
+      @selector(makeKeyAndOrderFront:));
+  ResetMenuRoutingTestState reset_menu_state;
+  menu_test_key_window = host;
+  [host_controller activatePane:HeliumDualPaneSideRight];
+  ASSERT_EQ(right_window,
+            helium_dual::BrowserWindowForHost(gfx::NativeWindow(host))
+                .GetNativeNSWindow());
+  menu_test_activation_target = nil;
+  NSMenuItem* close_tab =
+      [[NSMenuItem alloc] initWithTitle:@"Close Tab"
+                                 action:@selector(commandDispatch:)
+                          keyEquivalent:@"w"];
+  close_tab.tag = IDC_CLOSE_TAB;
+  ASSERT_TRUE([right_window validateUserInterfaceItem:close_tab]);
+  // Previously NO: app-level _menuState does not contain IDC_CLOSE_TAB.
+  EXPECT_TRUE([app_controller validateUserInterfaceItem:close_tab]);
+  EXPECT_FALSE(menu_test_activation_target);
+
+  // Keep the actual selected pane's disabled state instead of blanket-enabling
+  // commands just because another pane supports them.
+  chrome::UpdateCommandEnabled(right_browser, IDC_CLOSE_TAB, false);
+  EXPECT_TRUE([left_window validateUserInterfaceItem:close_tab]);
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+  chrome::UpdateCommandEnabled(right_browser, IDC_CLOSE_TAB, true);
+  ASSERT_TRUE([app_controller validateUserInterfaceItem:close_tab]);
+  [app_controller commandDispatch:close_tab];
+  EXPECT_EQ(right_window, menu_test_activation_target);
+  EXPECT_EQ(1, right_browser->tab_strip_model()->count());
+  EXPECT_EQ(1, left->browser()->tab_strip_model()->count());
+  EXPECT_EQ(host, left_window.parentWindow);
+  EXPECT_EQ(host, right_window.parentWindow);
+
+  // A Dock action must not be reinterpreted as this host's browser action.
+  close_tab.action = @selector(commandFromDock:);
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+  close_tab.action = @selector(commandDispatch:);
+  // Ordinary windows and a missing key window retain app-level validation.
+  menu_test_key_window = left_window;
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+  menu_test_key_window = nil;
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+
+  EXPECT_FALSE(host.visible);
+  // The host can outlive its last pane until deferred destruction runs.
+  helium_dual::DetachFromHost(right);
+  helium_dual::DetachFromHost(left);
+  menu_test_key_window = host;
+  EXPECT_FALSE(helium_dual::BrowserWindowForHost(gfx::NativeWindow(host)));
+  EXPECT_FALSE([app_controller validateUserInterfaceItem:close_tab]);
+  menu_test_key_window = nil;
+  menu_test_activation_target = nil;
+  base::RunLoop().RunUntilIdle();
+}
