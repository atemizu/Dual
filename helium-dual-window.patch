+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (_cursorTrackingArea) {
+    [self removeTrackingArea:_cursorTrackingArea];
+  }
+  // The hosted browser, rather than the divider's parent, is the key window,
+  // and AppKit sends cursorUpdate: only to the key window. Track hover and
+  // movement throughout the active app so the divider can keep its cursor.
+  _cursorTrackingArea = [[NSTrackingArea alloc]
+      initWithRect:NSZeroRect
+           options:NSTrackingMouseEnteredAndExited | NSTrackingCursorUpdate |
+                   NSTrackingMouseMoved |
+                   NSTrackingActiveInActiveApp | NSTrackingInVisibleRect |
+                   NSTrackingEnabledDuringMouseDrag
