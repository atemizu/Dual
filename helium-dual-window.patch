+class BrowserPair : public views::WidgetObserver, public views::ViewObserver {
+ public:
+  BrowserPair(Profile* profile, std::string group_id, BrowserView* first)
+      : profile_(profile), group_id_(std::move(group_id)) {
+    BrowserWindowInterface* browser = first->browser();
+    ratio_ = ClampRatio(HeliumDualPaneState::From(browser)->ratio());
+    gfx::Rect bounds;
+    ui::mojom::WindowShowState state = ui::mojom::WindowShowState::kDefault;
+    if (auto saved = BoundsFromString(
+            HeliumDualPaneState::From(browser)->host_bounds())) {
+      bounds = *saved;
+    } else {
+      // A new window: where and how large Chromium would have made it.
+      WindowSizer::GetBrowserWindowBoundsAndShowState(
+          gfx::Rect(), browser, &bounds, &state);
+    }
+    // Keep it reachable if a display was disconnected.
+    const display::Display display =
+        display::Screen::Get()->GetDisplayMatching(bounds);
+    if (!display.work_area().Intersects(bounds)) {
+      bounds.set_origin(display.work_area().origin() + gfx::Vector2d(20, 20));
+    }
+    bounds.set_width(std::max(bounds.width(), MinimumSize().width()));
+    bounds.set_height(std::max(bounds.height(), MinimumSize().height()));
+    // A restored window comes back maximized if it was.
+    if (const auto* init_state = BrowserInitState::From(browser)) {
+      if (init_state->create_params().initial_show_state ==
+          ui::mojom::WindowShowState::kMaximized) {
+        state = ui::mojom::WindowShowState::kMaximized;
+      }
+    }
+    maximize_on_show_ = state == ui::mojom::WindowShowState::kMaximized;
+
+    delegate_ = std::make_unique<HostDelegate>(this);
+    contents_ = delegate_->SetContentsView(std::make_unique<HostContents>(this));
+    divider_ = contents_->AddChildView(std::make_unique<DividerView>(this));
+    for (size_t side = 0; side < 2; ++side) {
+      auto button = std::make_unique<TabStripFlatEdgeButton>();
+      button->SetCallback(base::BindRepeating(
+          &BrowserPair::RequestPane, base::Unretained(this), side));
+      button->SetIconSize(16);
+      button->SetCornerRadius(
+          GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius));
+      button->SetForegroundColorId(kColorToolbarButtonIconDisabled);
+      button->UpdateIcon(ui::ImageModel::FromVectorIcon(
+          features::IsRoundedIconsEnabled() ? vector_icons::kAddWeight500CustomIcon : vector_icons::kAddOldIcon, kColorToolbarButtonIconDisabled, 16));
+      button->SetShouldShowLabel(false);
+      button->SetTooltipText(LaunchLabel(side == 1));
+      button->GetViewAccessibility().SetName(LaunchLabel(side == 1));
+      launch_buttons_[side] = contents_->AddChildView(std::move(button));
+    }
+
+    widget_ = std::make_unique<views::Widget>();
+    widget_observations_.AddObservation(widget_.get());
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW);
+    params.delegate = delegate_.get();
+    params.name = "DualWindow";
+    params.bounds = bounds;
+    params.remove_standard_frame = true;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kOpaque;
+    // What the desktop knows Dual's browser windows by.
+    params.wm_class_name = shell_integration_linux::GetProgramClassName();
+    params.wm_class_class = shell_integration_linux::GetProgramClassClass();
+    params.wm_role_name = "browser";
+    params.wayland_app_id = params.wm_class_class;
+    widget_->Init(std::move(params));
+    UpdateTitle();
+  }
+
+  ~BrowserPair() override {
+    StopWatchingPointer();
+    rail_overlay_.reset();
+    widget_observations_.RemoveAllObservations();
+    rail_observations_.RemoveAllObservations();
+    // Panes are gone by now; the window goes with this.
+    widget_.reset();
+  }
+
+  views::Widget* widget() const { return widget_.get(); }
+  gfx::NativeView native_view() const { return widget_->GetNativeView(); }
+
+  // A pane's widget is about to be made: its place is taken.
+  void Reserve(BrowserView* view) {
+    const size_t side = SideIndex(RoleOf(view->browser()));
+    CHECK(!browsers_[side] || browsers_[side] == view->browser());
+    browsers_[side] = view->browser();
+  }
+
+  void Attach(BrowserView* view) {
+    BrowserWindowInterface* browser = view->browser();
+    const size_t side = SideIndex(RoleOf(browser));
+    if (attached_[side] == browser) {
+      return;
+    }
+    CHECK(browsers_[side] == browser);
+    attached_[side] = browser;
+    close_subscriptions_[side] =
+        browser->RegisterBrowserCloseCancelled(base::BindRepeating(
+            &BrowserPair::OnCloseCancelled, base::Unretained(this)));
+    view->GetWidget()->OnSizeConstraintsChanged();
+    widget_observations_.AddObservation(view->GetWidget());
+    if (auto* rail = GetPaneRail(browser)) {
+      rail_observations_.AddObservation(rail);
+    }
+    ScheduleRelayout();
+    InvalidateRails();
+    ScheduleZenState();
+    ScheduleSave();
+  }
+
+  // The bounds a pane's widget is made with, before the first layout.
+  gfx::Rect PaneBoundsInScreen(size_t side) {
+    std::array<gfx::Rect, 2> panes = ComputePaneRects();
+    if (!panes[side].IsEmpty()) {
+      return ToScreen(panes[side]);
+    }
+    // Before the window's first layout: all of it.
+    return widget_->GetClientAreaBoundsInScreen();
+  }
+
+  BrowserWindowInterface* browser_at(size_t side) const {
+    return browsers_[side];
+  }
+  bool retired() const { return retired_; }
+  bool closing() const { return closing_; }
+  bool creating_pane() const { return creating_pane_; }
+
+  // Showing and activating ----------------------------------------------------
+
+  void Show(BrowserView* view, bool activate) {
+    if (activate && IsHidden(view)) {
+      SetHidden(view, false);
+    }
+    if (!widget_->IsVisible()) {
+      Relayout();
+      if (maximize_on_show_) {
+        maximize_on_show_ = false;
+        widget_->Maximize();
+      }
+      if (activate) {
+        widget_->Show();
+      } else {
+        widget_->ShowInactive();
+      }
+    }
+    if (activate) {
+      ActivatePane(SideIndex(RoleOf(view->browser())));
+    }
+  }
+
+  void ShowPaneWithState(BrowserView* view,
+                         ui::mojom::WindowShowState state) {
+    if (state == ui::mojom::WindowShowState::kMaximized) {
+      maximize_on_show_ = true;
+    } else if (state == ui::mojom::WindowShowState::kFullscreen) {
+      widget_->SetFullscreen(true);
+    } else if (state == ui::mojom::WindowShowState::kMinimized) {
+      widget_->Minimize();
+    }
+  }
+
+  // Whether the desktop has this window active: the window itself (its
+  // contents) or one of its panes is (a pane being active, the window's own
+  // contents are not).
+  bool IsWindowActive() const {
+    if (widget_->IsActive()) {
+      return true;
+    }
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      if (view && view->GetWidget() && view->GetWidget()->IsActive()) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void ActivatePane(size_t side) {
+    BrowserWindowInterface* browser = browsers_[side];
+    auto* view =
+        browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    if (activating_ || !view || !view->GetWidget()) {
+      return;
+    }
+    base::AutoReset<bool> activating(&activating_, true);
+    active_side_ = side;
+    if (!IsWindowActive() && widget_->IsVisible()) {
+      widget_->Activate();
+    }
+    if (!view->GetWidget()->IsActive()) {
+      view->GetWidget()->Activate();
+    }
+  }
+
+  // A pane is being activated: bring the window up if need be.
+  void ActivateHost() {
+    if (activating_ || !widget_->IsVisible()) {
+      return;
+    }
+    base::AutoReset<bool> activating(&activating_, true);
+    if (!IsWindowActive()) {
+      widget_->Activate();
+    }
+  }
+
+  // Layout ---------------------------------------------------------------------
+
+  void ScheduleRelayout() {
+    if (!relayout_timer_.IsRunning()) {
+      relayout_timer_.Start(FROM_HERE, base::TimeDelta(), this,
+                            &BrowserPair::Relayout);
+    }
+  }
+
+  int EdgeInset() const {
+    return widget_->IsFullscreen() || widget_->IsMaximized() ? 0
+                                                              : kResizeEdgeInset;
+  }
+
+  int RailWidth() const { return VerticalTabStripRegionView::kCollapsedWidth; }
+
+  // The area the panes share: the window but the resize bands.
+  gfx::Rect PaneArea() const {
+    gfx::Rect area = contents_->GetLocalBounds();
+    const int edge = EdgeInset();
+    area.Inset(gfx::Insets::TLBR(0, edge, edge, edge));
+    return area;
+  }
+
+  std::array<gfx::Rect, 2> ComputePaneRects() const {
+    std::array<gfx::Rect, 2> rects;
+    const gfx::Rect area = PaneArea();
+    const bool both = browsers_[0] && browsers_[1];
+    if (both && !hidden_[0] && !hidden_[1]) {
+      const int available = std::max(0, area.width() - kDividerWidth);
+      const int minimum = std::min(kMinimumPaneWidth, available / 2);
+      const int left_width =
+          std::clamp(static_cast<int>(std::round(available * ratio_)),
+                     minimum, available - minimum);
+      rects[0] = gfx::Rect(area.x(), area.y(), left_width, area.height());
+      const int right_x = rects[0].right() + kDividerWidth;
+      rects[1] = gfx::Rect(right_x, area.y(),
+                           std::max(0, area.right() - right_x), area.height());
+    } else if (both) {
+      // One pane collapsed to its tab strip at its outer edge.
+      const size_t hidden = hidden_[0] ? 0 : 1;
+      const int rail_width =
+          std::min(hidden_rail_width_[hidden], area.width() / 2);
+      if (auto_hide_rails_) {
+        // Frameless: the strip floats over its sibling, which keeps the
+        // whole width.
+        rects[hidden] = FloatingRailRect(area, rail_width, hidden == 1);
+        rects[1 - hidden] = area;
+        return rects;
+      }
+      gfx::Rect rail(hidden == 0 ? area.x() : area.right() - rail_width,
+                     area.y(), rail_width, area.height());
+      gfx::Rect pane = area;
+      pane.set_width(area.width() - rail_width);
+      if (hidden == 0) {
+        pane.set_x(area.x() + rail_width);
+      }
+      rects[hidden] = rail;
+      rects[1 - hidden] = pane;
+    } else if (browsers_[0] || browsers_[1]) {
+      // A lone pane, with the rail for the other side beyond it.
+      const size_t lone = browsers_[0] ? 0 : 1;
+      gfx::Rect pane = area;
+      if (!auto_hide_rails_) {
+        pane.set_width(std::max(0, area.width() - RailWidth()));
+        if (lone == 1) {
+          pane.set_x(area.x() + RailWidth());
+        }
+      }
+      rects[lone] = pane;
+    }
+    return rects;
+  }
+
+  // Helium's floating side chrome geometry, in the window's coordinates.
+  gfx::Rect FloatingRailRect(const gfx::Rect& area, int width,
+                             bool right) const {
+    return gfx::Rect(
+        right ? area.right() - kFloatingRailInset - width
+              : area.x() + kFloatingRailInset,
+        area.y() + floating_top_, width,
+        std::max(0, area.height() - floating_top_ - floating_bottom_));
+  }
+
+  gfx::Rect ToScreen(const gfx::Rect& rect) const {
+    return rect + widget_->GetClientAreaBoundsInScreen().OffsetFromOrigin();
+  }
+
+  void Relayout() {
+    if (retired_ || laying_out_) {
+      return;
+    }
+    base::AutoReset<bool> laying_out(&laying_out_, true);
+    relayout_timer_.Stop();
+    const std::array<gfx::Rect, 2> rects = ComputePaneRects();
+    const gfx::Rect area = PaneArea();
+    const bool both = browsers_[0] && browsers_[1];
+    divider_->SetVisible(both && !hidden_[0] && !hidden_[1]);
+    if (divider_->GetVisible()) {
+      divider_->SetBounds(rects[0].right(), area.y(), kDividerWidth,
+                          area.height());
+    }
+    // The "+" for a missing side, where its tab strip's first row would be.
+    const int button_height =
+        GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+    const int padding =
+        GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+    for (size_t side = 0; side < 2; ++side) {
+      const bool show =
+          !auto_hide_rails_ && !browsers_[side] && browsers_[1 - side];
+      launch_buttons_[side]->SetVisible(show);
+      if (show) {
+        const int x = side == 0 ? area.x() : area.right() - RailWidth();
+        launch_buttons_[side]->SetBounds(x + padding, rail_button_top_,
+                                         RailWidth() - 2 * padding,
+                                         button_height);
+      }
+    }
+    UpdateWindowControlsOwner();
+    auto weak_this = weak_factory_.GetWeakPtr();
+    for (size_t side = 0; side < 2 && weak_this; ++side) {
+      BrowserWindowInterface* browser = browsers_[side];
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      if (!view || !view->GetWidget() || rects[side].IsEmpty()) {
+        continue;
+      }
+      const gfx::Rect target = ToScreen(rects[side]);
+      if (view->GetWidget()->GetWindowBoundsInScreen() != target) {
+        view->GetWidget()->SetBounds(target);
+      }
+    }
+    if (weak_this) {
+      UpdateColors();
+      LayoutRailOverlay();
+      ApplyRailVisibility(/*animated=*/false);
+      contents_->SchedulePaint();
+    }
+  }
+
+  gfx::Size MinimumSize() const {
+    const int edge = 2 * kResizeEdgeInset;
+    const bool both = browsers_[0] && browsers_[1];
+    const int width = both ? 2 * kMinimumPaneWidth + kDividerWidth
+                           : kMinimumPaneWidth + RailWidth();
+    return gfx::Size(width + edge, kMinimumPaneHeight + kResizeEdgeInset);
+  }
+
+  // The window's own parts take the colors of the toolbar of a pane.
+  void UpdateColors() {
+    BrowserWindowInterface* browser = browsers_[active_side_]
+                                          ? browsers_[active_side_].get()
+                                          : (browsers_[0] ? browsers_[0].get()
+                                                          : browsers_[1].get());
+    auto* view =
+        browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    if (!view || !view->GetWidget() || !view->GetColorProvider()) {
+      return;
+    }
+    const ui::ColorProvider* colors = view->GetColorProvider();
+    const SkColor background = colors->GetColor(kColorToolbar);
+    if (background_color_ != background) {
+      background_color_ = background;
+      contents_->SetBackground(views::CreateSolidBackground(background));
+      divider_->SetBackground(views::CreateSolidBackground(background));
+    }
+    // Frameless rails float like the visible pane's own strip.
+    if (BrowserWindowInterface* source = FloatingRailSource()) {
+      auto* source_view = BrowserView::GetBrowserViewForBrowser(source);
+      auto* source_rail = GetPaneRail(source);
+      if (source_view && source_view->GetWidget() && source_rail &&
+          !source_rail->size().IsEmpty()) {
+        const gfx::Rect pane = source_view->GetWidget()->GetWindowBoundsInScreen();
+        const gfx::Rect strip = source_rail->GetBoundsInScreen();
+        const float top_ratio = source_view->GetTopChromeRevealRatio();
+        if (top_ratio <= 0.f || top_ratio >= 1.f) {
+          // (Never closer to the window's edges than Helium's own padding.)
+          const int top = std::clamp(strip.y() - pane.y(), kFloatingRailInset,
+                                     std::max(kFloatingRailInset,
+                                              pane.height() / 2));
+          const int bottom = std::clamp(pane.bottom() - strip.bottom(),
+                                        kFloatingRailInset,
+                                        std::max(kFloatingRailInset,
+                                                 pane.height() / 2));
+          if (top != floating_top_ || bottom != floating_bottom_) {
+            floating_top_ = top;
+            floating_bottom_ = bottom;
+            ScheduleRelayout();
+          }
+        }
+        if (source_rail->width() != floating_width_) {
+          floating_width_ = source_rail->width();
+          ScheduleRelayout();
+        }
+      }
+    }
+    // The "+" sits where the pane's own strip has its first row.
+    if (auto* rail = GetPaneRail(browser); rail && rail->GetVisible()) {
+      const int top = rail->GetBoundsInScreen().y() -
+                      widget_->GetClientAreaBoundsInScreen().y() + 2;
+      if (top != rail_button_top_ && top >= 0) {
+        rail_button_top_ = top;
+        ScheduleRelayout();
+      }
+    }
+  }
+
+  // Frameless mode --------------------------------------------------------------
+
+  void ScheduleZenState() {
+    if (!zen_state_timer_.IsRunning()) {
+      zen_state_timer_.Start(FROM_HERE, base::TimeDelta(), this,
+                             &BrowserPair::UpdateZenState);
+    }
+  }
+
+  // The outer rails hide like Helium's side chrome, unless that is pinned.
+  void UpdateZenState() {
+    bool auto_hide = false;
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      if (!view || !view->GetWidget()) {
+        continue;
+      }
+      auto_hide |= view->IsZenModeEnabledForLayout() &&
+                   !view->IsZenModeSideChromePinned();
+    }
+    if (auto_hide == auto_hide_rails_) {
+      return;
+    }
+    auto_hide_rails_ = auto_hide;
+    rail_revealed_ = false;
+    rail_hide_timer_.Stop();
+    rail_poll_timer_.Stop();
+    if (auto_hide) {
+      WatchPointer();
+    } else {
+      StopWatchingPointer();
+    }
+    Relayout();
+  }
+
+  // The visible pane whose strip a frameless rail mirrors: a lone pane, or
+  // the sibling of a hidden one.
+  BrowserWindowInterface* FloatingRailSource() const {
+    if (!browsers_[0] != !browsers_[1]) {
+      return browsers_[0] ? browsers_[0].get() : browsers_[1].get();
+    }
+    for (size_t side = 0; side < 2; ++side) {
+      if (browsers_[side] && hidden_[1 - side]) {
+        return browsers_[side];
+      }
+    }
+    return nullptr;
+  }
+
+  // The window edge whose rail hides in frameless mode: a hidden pane's
+  // side, or the empty side next to a lone pane.
+  bool HideableRailEdge(size_t* edge) const {
+    if (!auto_hide_rails_ || closing_) {
+      return false;
+    }
+    if (browsers_[0] && browsers_[1]) {
+      if (hidden_[0] == hidden_[1]) {
+        return false;
+      }
+      *edge = hidden_[0] ? 0 : 1;
+      return true;
+    }
+    if (!browsers_[0] && !browsers_[1]) {
+      return false;
+    }
+    *edge = browsers_[0] ? 1 : 0;
+    return true;
+  }
+
+  void WatchPointer() {
+    if (pointer_watcher_ || !widget_->GetNativeWindow()) {
+      return;
+    }
+    pointer_watcher_ = std::make_unique<PointerWatcher>(this);
+    widget_->GetNativeWindow()->GetRootWindow()->AddPreTargetHandler(
+        pointer_watcher_.get());
+  }
+
+  void StopWatchingPointer() {
+    if (!pointer_watcher_) {
+      return;
+    }
+    if (widget_ && widget_->GetNativeWindow() &&
+        widget_->GetNativeWindow()->GetRootWindow()) {
+      widget_->GetNativeWindow()->GetRootWindow()->RemovePreTargetHandler(
+          pointer_watcher_.get());
+    }
+    pointer_watcher_.reset();
+  }
+
+  void PointerMoved() {
+    if (!auto_hide_rails_ || closing_ || retired_ || !widget_->IsVisible() ||
+        widget_->IsMinimized()) {
+      rail_poll_timer_.Stop();
+      return;
+    }
+    EvaluatePointer(display::Screen::Get()->GetCursorScreenPoint());
+    // Movement outside the window is not reported; poll while a rail shows.
+    if (rail_revealed_ && !rail_poll_timer_.IsRunning()) {
+      rail_poll_timer_.Start(FROM_HERE, kRailPollInterval, this,
+                             &BrowserPair::PointerMoved);
+    } else if (!rail_revealed_) {
+      rail_poll_timer_.Stop();
+    }
+  }
+
+  // The visible pane nearest |edge|, not counting a hidden frameless rail.
+  std::optional<size_t> PaneAtEdge(size_t edge) const {
+    size_t rail_edge = 1;
+    const bool has_rail = HideableRailEdge(&rail_edge);
+    const bool both = browsers_[0] && browsers_[1];
+    std::optional<size_t> best;
+    int best_distance = 0;
+    const gfx::Rect host = widget_->GetWindowBoundsInScreen();
+    for (size_t side = 0; side < 2; ++side) {
+      if (!browsers_[side] || (has_rail && both && side == rail_edge)) {
+        continue;
+      }
+      auto* view = BrowserView::GetBrowserViewForBrowser(browsers_[side]);
+      if (!view || !view->GetWidget()) {
+        continue;
+      }
+      const gfx::Rect frame = view->GetWidget()->GetWindowBoundsInScreen();
+      const int distance =
+          edge == 0 ? frame.x() - host.x() : host.right() - frame.right();
+      if (!best || distance < best_distance) {
+        best = side;
+        best_distance = distance;
+      }
+    }
+    return best;
+  }
+
+  void EvaluatePointer(const gfx::Point& point) {
+    const gfx::Rect host = widget_->GetWindowBoundsInScreen();
+    gfx::Rect around = host;
+    around.Inset(-1);
+    const bool inside = around.Contains(point);
+    const bool pressed = aura::Env::GetInstance()->IsMouseButtonDown();
+    size_t edge = 1;
+    const bool has_rail = HideableRailEdge(&edge);
+    // The resize band beyond a pane stands in for that pane's own frameless
+    // trigger, which no longer reaches the window's edge.
+    const int band = EdgeInset();
+    if (inside && band > 0 && !pressed) {
+      const bool left_band = point.x() - host.x() < band;
+      const bool right_band = host.right() - point.x() <= band;
+      const size_t band_edge = left_band ? 0 : 1;
+      if ((left_band || right_band) && !(has_rail && edge == band_edge)) {
+        if (std::optional<size_t> pane = PaneAtEdge(band_edge)) {
+          RevealZenSideChrome(band_edge, *pane);
+        }
+      }
+    }
+    if (!has_rail) {
+      return;
+    }
+    if (!inside) {
+      // Brief excursions outside the window keep the rail, as in Helium.
+      if (rail_revealed_) {
+        ScheduleRailHide(kRailCursorExitGrace);
+      }
+      return;
+    }
+    const bool right = edge == 1;
+    const int from_edge =
+        right ? host.right() - point.x() : point.x() - host.x();
+    const gfx::Rect rail = RailBoundsInScreen();
+    const int rail_reach =
+        rail.IsEmpty() ? 0
+                       : (right ? host.right() - rail.x()
+                                : rail.right() - host.x());
+    // A drag (a scroll bar, a text selection) passing the edge reveals nothing.
+    const bool in_trigger =
+        !pressed &&
+        from_edge < (band > 0 ? band : kRailRevealFullscreenTrigger);
+    const bool over_rail =
+        rail_revealed_ && from_edge < rail_reach + kRailRevealLeeway;
+    if (in_trigger || over_rail) {
+      rail_hide_timer_.Stop();
+      SetRailRevealed(true);
+    } else if (rail_revealed_) {
+      ScheduleRailHide(kRailHoverExitGrace);
+    }
+  }
+
+  void ScheduleRailHide(base::TimeDelta delay) {
+    if (rail_hide_timer_.IsRunning() &&
+        rail_hide_timer_.desired_run_time() - base::TimeTicks::Now() <= delay) {
+      return;  // Keep an earlier deadline.
+    }
+    rail_hide_timer_.Start(FROM_HERE, delay,
+                           base::BindOnce(&BrowserPair::RailHideTimerFired,
+                                          base::Unretained(this)));
+  }
+
+  void RailHideTimerFired() {
+    // Never hide a rail under a press, e.g. while one of its tabs is dragged.
+    if (aura::Env::GetInstance()->IsMouseButtonDown()) {
+      ScheduleRailHide(kRailHoverExitGrace);
+      return;
+    }
+    SetRailRevealed(false);
+  }
+
+  void SetRailRevealed(bool revealed) {
+    if (rail_revealed_ == revealed) {
+      return;
+    }
+    rail_revealed_ = revealed;
+    if (revealed) {
+      if (!rail_poll_timer_.IsRunning()) {
+        rail_poll_timer_.Start(FROM_HERE, kRailPollInterval, this,
+                               &BrowserPair::PointerMoved);
+      }
+    } else {
+      rail_hide_timer_.Stop();
+    }
+    ApplyRailVisibility(/*animated=*/true);
+  }
+
+  // Where the hideable rail is, shown or not.
+  gfx::Rect RailBoundsInScreen() const {
+    size_t edge = 1;
+    if (!HideableRailEdge(&edge)) {
+      return gfx::Rect();
+    }
+    if (browsers_[0] && browsers_[1]) {
+      auto* view = BrowserView::GetBrowserViewForBrowser(browsers_[edge]);
+      return view && view->GetWidget()
+                 ? view->GetWidget()->GetWindowBoundsInScreen()
+                 : gfx::Rect();
+    }
+    return rail_overlay_ ? rail_overlay_->GetWindowBoundsInScreen()
+                         : gfx::Rect();
+  }
+
+  // The panel with "+ New tab" beside a lone pane in frameless mode: a
+  // window of the window's own, above the pane.
+  void LayoutRailOverlay() {
+    size_t edge = 1;
+    const bool wanted =
+        HideableRailEdge(&edge) && !(browsers_[0] && browsers_[1]);
+    if (!wanted) {
+      if (rail_overlay_) {
+        rail_overlay_->Hide();
+      }
+      return;
+    }
+    if (!rail_overlay_) {
+      rail_overlay_ = std::make_unique<views::Widget>();
+      views::Widget::InitParams params(
+          views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+          views::Widget::InitParams::TYPE_POPUP);
+      params.native_widget = new views::NativeWidgetAura(rail_overlay_.get());
+      params.parent = widget_->GetNativeView();
+      params.activatable = views::Widget::InitParams::Activatable::kNo;
+      params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+      params.name = "DualRailPanel";
+      rail_overlay_->Init(std::move(params));
+      auto panel = std::make_unique<views::View>();
+      auto button = std::make_unique<TabStripFlatEdgeButton>();
+      button->SetCallback(base::BindRepeating(
+          [](BrowserPair* pair) {
+            size_t edge = 1;
+            if (pair->HideableRailEdge(&edge)) {
+              pair->RequestPane(edge);
+            }
+          },
+          base::Unretained(this)));
+      button->SetIconSize(16);
+      button->SetCornerRadius(
+          GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius));
+      button->SetForegroundColorId(kColorToolbarButtonIconDisabled);
+      button->UpdateIcon(ui::ImageModel::FromVectorIcon(
+          features::IsRoundedIconsEnabled() ? vector_icons::kAddWeight500CustomIcon : vector_icons::kAddOldIcon, kColorToolbarButtonIconDisabled, 16));
+      overlay_button_ = panel->AddChildView(std::move(button));
+      rail_panel_ = rail_overlay_->SetContentsView(std::move(panel));
+    }
+    const gfx::Rect area = PaneArea();
+    const int width =
+        std::min(floating_width_ > 0 ? floating_width_ : RailWidth(),
+                 area.width() / 2);
+    const gfx::Rect panel = FloatingRailRect(area, width, edge == 1);
+    rail_overlay_->SetBounds(ToScreen(panel));
+    const int padding =
+        GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+    const int button_height =
+        GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+    overlay_button_->SetBounds(padding, padding,
+                               std::max(0, panel.width() - 2 * padding),
+                               button_height);
+    const std::u16string label = LaunchLabel(edge == 1);
+    // As wide as the visible pane's strip: "+ New Tab", as on its own row.
+    constexpr int kLaunchTitleMinWidth = 100;
+    const bool titled = panel.width() >= kLaunchTitleMinWidth;
+    overlay_button_->SetText(titled ? Words(u"新しいタブ", u"New Tab")
+                                    : std::u16string());
+    overlay_button_->SetShouldShowLabel(titled);
+    overlay_button_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    overlay_button_->SetTooltipText(label);
+    overlay_button_->GetViewAccessibility().SetName(label);
+    if (background_color_) {
+      rail_panel_->SetBackground(views::CreateRoundedRectBackground(
+          *background_color_,
+          GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius) + 4));
+    }
+  }
+
+  // Everything but a hidden frameless rail is fully shown and takes events.
+  void ApplyRailVisibility(bool animated) {
+    size_t edge = 1;
+    const bool has_rail = HideableRailEdge(&edge);
+    const bool both = browsers_[0] && browsers_[1];
+    for (size_t side = 0; side < 2; ++side) {
+      auto* view = browsers_[side]
+                       ? BrowserView::GetBrowserViewForBrowser(browsers_[side])
+                       : nullptr;
+      aura::Window* window =
+          view && view->GetWidget() ? view->GetWidget()->GetNativeWindow()
+                                    : nullptr;
+      if (!window) {
+        continue;
+      }
+      const bool is_rail = has_rail && both && side == edge;
+      const bool show = !is_rail || rail_revealed_;
+      if (is_rail && show && window->parent()) {
+        // Above the pane it lies over.
+        window->parent()->StackChildAtTop(window);
+      }
+      window->SetEventTargetingPolicy(
+          show ? aura::EventTargetingPolicy::kTargetAndDescendants
+               : aura::EventTargetingPolicy::kNone);
+      SetOpacity(window->layer(), show ? 1.f : 0.f, animated && is_rail);
+    }
+    if (rail_overlay_) {
+      const bool show = has_rail && !both && rail_revealed_;
+      if (show && !rail_overlay_->IsVisible()) {
+        rail_overlay_->ShowInactive();
+        if (aura::Window* window = rail_overlay_->GetNativeWindow();
+            window && window->parent()) {
+          window->parent()->StackChildAtTop(window);
+        }
+        rail_overlay_->GetLayer()->SetOpacity(0.f);
+      }
+      if (rail_overlay_->IsVisible()) {
+        SetOpacity(rail_overlay_->GetLayer(), show ? 1.f : 0.f, animated);
+        if (!show && !animated) {
+          rail_overlay_->Hide();
+        }
+      }
+    }
+  }
+
+  static void SetOpacity(ui::Layer* layer, float opacity, bool animated) {
+    if (!layer || layer->GetTargetOpacity() == opacity) {
+      return;
+    }
+    ui::ScopedLayerAnimationSettings settings(layer->GetAnimator());
+    settings.SetTransitionDuration(animated ? kRailRevealDuration
+                                            : base::TimeDelta());
+    layer->SetOpacity(opacity);
+  }
+
+  // The band beyond |pane| reached: reveal its strip, if it faces |edge|.
+  void RevealZenSideChrome(size_t edge, size_t pane) {
+    BrowserWindowInterface* browser = browsers_[pane];
+    auto* view =
+        browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    auto* strip =
+        browser ? tabs::VerticalTabStripStateController::From(browser) : nullptr;
+    if (!view || !strip || strip->IsTabStripRightAligned() != (edge == 1)) {
+      return;
+    }
+    view->RevealZenModeSideChromeFromEdge();
+  }
+
+  // The divider ---------------------------------------------------------------
+
+  void DividerPressed() { ratio_at_press_ = ratio_; }
+
+  void DividerDragged(int x_in_contents) {
+    const gfx::Rect area = PaneArea();
+    const int available = std::max(1, area.width() - kDividerWidth);
+    const double ratio =
+        ClampRatio(static_cast<double>(x_in_contents - area.x()) / available);
+    if (ratio == ratio_) {
+      return;
+    }
+    ratio_ = ratio;
+    Relayout();
+  }
+
+  void DividerReleased() {
+    if (ratio_ != ratio_at_press_) {
+      ScheduleSave();
+    }
+  }
+
+  // Which pane shows the window's buttons (minimize, maximize, close): the
+  // one at the edge the desktop puts them at.
+  void UpdateWindowControlsOwner() {
+    const bool leading =
+        !views::WindowButtonOrderProvider::GetInstance()->leading_buttons()
+             .empty();
+    std::optional<size_t> owner;
+    if (browsers_[0] && browsers_[1]) {
+      size_t preferred = leading ? 0 : 1;
+      owner = hidden_[preferred] ? 1 - preferred : preferred;
+    } else if (browsers_[0]) {
+      owner = 0;
+    } else if (browsers_[1]) {
+      owner = 1;
+    }
+    if (owner == window_controls_owner_) {
+      return;
+    }
+    window_controls_owner_ = owner;
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (auto* view = browser ? BrowserView::GetBrowserViewForBrowser(browser)
+                               : nullptr;
+          view && view->GetWidget() && view->GetWidget()->non_client_view()) {
+        // The frame lays its buttons out (or not) and the pane's layout
+        // leaves room for them; both again.
+        views::NonClientView* frame = view->GetWidget()->non_client_view();
+        frame->ResetWindowControls();
+        frame->InvalidateLayout();
+        if (frame->frame_view()) {
+          frame->frame_view()->InvalidateLayout();
+        }
+        view->InvalidateLayout();
+        view->GetWidget()->LayoutRootViewIfNecessary();
+      }
+    }
+  }
+
+  bool ShowsWindowControls(const BrowserView* view) const {
+    return window_controls_owner_ &&
+           *window_controls_owner_ == SideIndex(RoleOf(view->browser()));
+  }
+
+  // The frame under |point| (in the window's coordinates), for its
+  // non-client hit test.
+  int PaneHitTest(const gfx::Point& point) {
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      views::Widget* pane = view ? view->GetWidget() : nullptr;
+      if (!pane || !pane->IsVisible() || !pane->non_client_view()) {
+        continue;
+      }
+      gfx::Point in_screen = point;
+      views::View::ConvertPointToScreen(widget_->GetRootView(), &in_screen);
+      const gfx::Rect bounds = pane->GetWindowBoundsInScreen();
+      if (!bounds.Contains(in_screen)) {
+        continue;
+      }
+      const int code = pane->non_client_view()->NonClientHitTest(
+          in_screen - bounds.OffsetFromOrigin());
+      switch (code) {
+        // A pane's own edges are not the window's.
+        case HTLEFT:
+        case HTRIGHT:
+        case HTTOP:
+        case HTBOTTOM:
+        case HTTOPLEFT:
+        case HTTOPRIGHT:
+        case HTBOTTOMLEFT:
+        case HTBOTTOMRIGHT:
+        case HTNOWHERE:
+          return HTCLIENT;
+        default:
+          return code;
+      }
+    }
+    return HTCLIENT;
+  }
+
+  // The window of the pane at |point| (in screen coordinates), if any.
+  gfx::NativeWindow PaneWindowAt(const gfx::Point& point) const {
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      views::Widget* pane = view ? view->GetWidget() : nullptr;
+      if (pane && pane->IsVisible() &&
+          pane->GetWindowBoundsInScreen().Contains(point)) {
+        return pane->GetNativeWindow();
+      }
+    }
+    return gfx::NativeWindow();
+  }
+
+  bool has_both() const { return browsers_[0] && browsers_[1]; }
+
+  bool HasVisiblePane() const {
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      if (view && view->GetWidget() && view->GetWidget()->IsVisible()) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Whether every pane of this window is one of |windows|.
+  bool AllPanesIn(const std::set<gfx::NativeWindow>& windows) const {
+    bool any = false;
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      if (!view || !view->GetWidget()) {
+        continue;
+      }
+      any = true;
+      if (!windows.contains(view->GetWidget()->GetNativeWindow())) {
+        return false;
+      }
+    }
+    return any;
+  }
+
+  // Hiding a pane ---------------------------------------------------------------
+
+  bool IsHidden(const BrowserView* view) const {
+    return hidden_[SideIndex(RoleOf(view->browser()))];
+  }
+  bool IsVisibilityChanging(const BrowserView* view) const {
+    return visibility_changing_[SideIndex(RoleOf(view->browser()))];
+  }
+  // A window with two panes always shows at least one. The one showing can
+  // be hidden even while the other is: the other is shown in its place.
+  bool CanHide(const BrowserView* view) const {
+    return browsers_[0] && browsers_[1] && !IsHidden(view);
+  }
+
+  void SetHidden(BrowserView* view, bool hidden) {
+    if (hidden == IsHidden(view) || (hidden && !CanHide(view))) {
+      return;
+    }
+    const size_t side = SideIndex(RoleOf(view->browser()));
+    const bool changing_places = hidden && hidden_[1 - side];
+    if (hidden) {
+      auto* rail = GetPaneRail(view->browser());
+      hidden_rail_width_[side] =
+          rail ? rail->width() : VerticalTabStripRegionView::kCollapsedWidth;
+      for (views::View* child : view->children()) {
+        if (child == rail) {
+          continue;
+        }
+        auto tracker = std::make_unique<views::ViewTracker>();
+        tracker->SetView(child);
+        hidden_views_[side].emplace_back(std::move(tracker),
+                                         child->GetVisible());
+      }
+    }
+    auto weak_this = weak_factory_.GetWeakPtr();
+    {
+      base::AutoReset<bool> transition(&visibility_changing_[side], true);
+      base::AutoReset<bool> other_transition(
+          &visibility_changing_[1 - side],
+          changing_places || visibility_changing_[1 - side]);
+      hidden_[side] = hidden;
+      if (changing_places) {
+        hidden_[1 - side] = false;
+      }
+      Relayout();
+      if (!weak_this) {
+        return;
+      }
+      if (!hidden) {
+        RestoreHiddenViews(side);
+      }
+      if (changing_places) {
+        RestoreHiddenViews(1 - side);
+      }
+    }
+    // Everything inside it too: a toolbar laid out at the strip's width has
+    // its address field snapped away until laid out again.
+    InvalidateLayoutOfTree(view);
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    if (!weak_this) {
+      return;
+    }
+    if (auto* other = changing_places && browsers_[1 - side]
+                          ? BrowserView::GetBrowserViewForBrowser(
+                                browsers_[1 - side])
+                          : nullptr) {
+      InvalidateLayoutOfTree(other);
+      other->GetWidget()->LayoutRootViewIfNecessary();
+      if (!weak_this) {
+        return;
+      }
+    }
+    InvalidateRails();
+    if (hidden) {
+      ActivatePane(1 - side);
+    } else {
+      ActivatePane(side);
+    }
+    // Once everything this set off has run: a pane's toolbar can still be
+    // laid out at the strip's width until then.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&BrowserPair::LayOutPanesAgain,
+                                  weak_factory_.GetWeakPtr()));
+    ScheduleSave();
+  }
+
+  void LayOutPanesAgain() {
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* view =
+          browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+      if (!view || !view->GetWidget()) {
+        continue;
+      }
+      // The toolbar decides what to show for its width when that width
+      // changes; back at the width it had before the pane was hidden, it would
+      // keep what it hid at the strip's width (the address field). Change the
+      // width once, then lay out at the right one.
+      views::Widget* pane = view->GetWidget();
+      const gfx::Rect bounds = pane->GetWindowBoundsInScreen();
+      if (bounds.width() > 1) {
+        pane->SetBounds(gfx::Rect(bounds.origin(),
+                                  gfx::Size(bounds.width() - 1, bounds.height())));
+        pane->LayoutRootViewIfNecessary();
+        pane->SetBounds(bounds);
+      }
+      InvalidateLayoutOfTree(view);
+      pane->LayoutRootViewIfNecessary();
+    }
+  }
+
+  void RestoreHiddenViews(size_t side) {
+    for (auto& [tracker, visible] : hidden_views_[side]) {
+      if (tracker->view()) {
+        tracker->view()->SetVisible(visible);
+      }
+    }
+    hidden_views_[side].clear();
+  }
+
+  // Each strip's hide button depends on its sibling (see CanHide()), and a
+  // tab's close button on whether its pane is hidden.
+  void InvalidateRails() {
+    for (BrowserWindowInterface* browser : browsers_) {
+      auto* rail = browser ? GetPaneRail(browser) : nullptr;
+      if (!rail) {
+        continue;
+      }
+      InvalidateLayoutOfTree(rail);
+      if (auto* widget = rail->GetWidget()) {
+        widget->LayoutRootViewIfNecessary();
+      }
+    }
+  }
+
+  // Opening a pane -----------------------------------------------------------
+
+  // The browser for the empty pane on |side|, with a new tab page and not
+  // yet shown; null if there cannot be one.
+  BrowserWindowInterface* CreatePane(size_t side, bool user_gesture) {
+    if (retired_ || closing_ || browsers_[side] || creating_pane_) {
+      return nullptr;
+    }
+    if (GetBrowserWindowCreationStatusForProfile(*profile_) !=
+        BrowserWindowInterface::CreationStatus::kOk) {
+      return nullptr;
+    }
+    creating_pane_ = true;
+    BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_NORMAL,
+                                     *profile_, user_gesture);
+    params.should_trigger_session_restore = false;
+    params.helium_dual_group_id = group_id_;
+    params.helium_dual_role = side ? HeliumDualRole::kRight
+                                   : HeliumDualRole::kLeft;
+    params.helium_dual_ratio = ratio_;
+    params.helium_dual_host_bounds = BoundsToString(NormalBounds());
+    params.vertical_tab_strip_collapsed = true;
+    BrowserWindowInterface* created = CreateBrowserWindow(std::move(params));
+    chrome::AddAndReturnTabAt(created, GURL(), -1, true);
+    return created;
+  }
+
+  void RequestPane(size_t side) {
+    BrowserWindowInterface* created = CreatePane(side, /*user_gesture=*/true);
+    if (!created) {
+      return;
+    }
+    created->GetWindow()->Show();
+    if (auto* view = BrowserView::GetBrowserViewForBrowser(created)) {
+      view->SetFocusToLocationBar(true);
+    }
+    creating_pane_ = false;
+  }
+
+  bool OpenPaneWithPinnedTabs(size_t side,
+                              const std::vector<GURL>& urls,
+                              bool hidden) {
+    auto weak_this = weak_factory_.GetWeakPtr();
+    BrowserWindowInterface* created = CreatePane(side, /*user_gesture=*/false);
+    if (!created) {
+      return false;
+    }
+    for (const GURL& url : urls) {
+      sessions::SerializedNavigationEntry navigation;
+      navigation.set_index(0);
+      navigation.set_virtual_url(url);
+      chrome::AddRestoredTab(
+          created, base::span_from_ref(navigation),
+          created->GetTabStripModel()->IndexOfFirstNonPinnedTab(),
+          /*selected_navigation=*/0, /*extension_app_id=*/std::string(),
+          /*group=*/std::nullopt, /*select=*/false, /*pin=*/true,
+          /*last_active_time_ticks=*/base::TimeTicks(),
+          /*last_active_time=*/base::Time(), /*storage_namespace=*/nullptr,
+          /*user_agent_override=*/sessions::SerializedUserAgentOverride(),
+          /*extra_data=*/{}, /*from_session_restore=*/false,
+          /*is_active_browser=*/std::nullopt,
+          chrome::RestoredTabLoadPolicy::kDeferUntilActivation);
+    }
+    created->GetWindow()->ShowInactive();
+    if (!weak_this) {
+      return true;
+    }
+    creating_pane_ = false;
+    auto* view = BrowserView::GetBrowserViewForBrowser(created);
+    if (hidden && view && browsers_[side] == created) {
+      SetHidden(view, true);
+    }
+    return true;
+  }
+
+  // Leaving --------------------------------------------------------------------
+
+  void Detach(BrowserView* view) {
+    Save();
+    BrowserWindowInterface* browser = view->browser();
+    const size_t side = SideIndex(RoleOf(browser));
+    if (browsers_[side] != browser) {
+      return;
+    }
+    if (widget_observations_.IsObservingSource(view->GetWidget())) {
+      widget_observations_.RemoveObservation(view->GetWidget());
+    }
+    if (auto* rail = GetPaneRail(browser);
+        rail && rail_observations_.IsObservingSource(rail)) {
+      rail_observations_.RemoveObservation(rail);
+    }
+    browsers_[side] = nullptr;
+    attached_[side] = nullptr;
+    hidden_[0] = hidden_[1] = false;
+    RestoreHiddenViews(0);
+    RestoreHiddenViews(1);
+    close_subscriptions_[side] = {};
+    if (closing_ && !committing_close_ &&
+        (!waiting_side_ || *waiting_side_ == side)) {
+      CancelClose();
+    }
+    if (!browsers_[0] && !browsers_[1]) {
+      Retire();
+    } else {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&BrowserPair::FinishDetach,
+                                    weak_factory_.GetWeakPtr()));
+      ScheduleSave();
+    }
+  }
+
+  void FinishDetach() {
+    if (retired_) {
+      return;
+    }
+    auto weak_this = weak_factory_.GetWeakPtr();
+    Relayout();
+    if (!weak_this) {
+      return;
+    }
+    for (BrowserWindowInterface* remaining : browsers_) {
+      if (!remaining) {
+        continue;
+      }
+      if (auto* remaining_view =
+              BrowserView::GetBrowserViewForBrowser(remaining)) {
+        remaining_view->InvalidateLayout();
+        if (auto* widget = remaining_view->GetWidget()) {
+          widget->LayoutRootViewIfNecessary();
+        }
+        if (!weak_this) {
+          return;
+        }
+        ActivatePane(SideIndex(RoleOf(remaining)));
+      }
+    }
+    InvalidateRails();
+  }
+
+  // The last pane is gone: so is the window, once this call has unwound.
+  void Retire() {
+    retired_ = true;
+    save_timer_.Stop();
+    relayout_timer_.Stop();
+    if (widget_) {
+      widget_->Hide();
+    }
+    weak_factory_.InvalidateWeakPtrs();
+    std::unique_ptr<BrowserPair> owned;
+    if (auto p = Pairs().find(profile_.get()); p != Pairs().end()) {
+      auto pair = p->second.find(group_id_);
+      if (pair != p->second.end() && pair->second.get() == this) {
+        owned = std::move(pair->second);
+        p->second.erase(pair);
+      }
+      if (p->second.empty()) {
+        RestoreRemaps().erase(profile_.get());
+        Pairs().erase(p);
+      }
+    }
+    profile_ = nullptr;
+    if (owned) {
+      base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+          FROM_HERE, std::move(owned));
+    }
+  }
+
+  // The window's state -------------------------------------------------------
+
+  gfx::Rect NormalBounds() const {
+    return widget_->IsMaximized() || widget_->IsFullscreen() ||
+                   widget_->IsMinimized()
+               ? widget_->GetRestoredBounds()
+               : widget_->GetWindowBoundsInScreen();
+  }
+
+  void SetBounds(const gfx::Rect& bounds) {
+    if (widget_->IsFullscreen()) {
+      pending_bounds_ = bounds;
+      widget_->SetFullscreen(false);
+      return;
+    }
+    gfx::Rect target = bounds;
+    target.set_width(std::max(target.width(), MinimumSize().width()));
+    target.set_height(std::max(target.height(), MinimumSize().height()));
+    widget_->SetBounds(target);
+    Relayout();
+    ScheduleSave();
+  }
+
+  void Maximize() { widget_->Maximize(); }
+  void Minimize() { widget_->Minimize(); }
+  void Restore() {
+    if (widget_->IsFullscreen()) {
+      widget_->SetFullscreen(false);
+    } else if (widget_->IsMaximized() || widget_->IsMinimized()) {
+      widget_->Restore();
+    }
+    widget_->Show();
+  }
+
+  void RequestFullscreen(BrowserView* view, bool fullscreen,
+                         int64_t display_id) {
+    if (widget_->IsFullscreen() != fullscreen) {
+      for (BrowserWindowInterface* browser : browsers_) {
+        if (auto* pane = browser ? BrowserView::GetBrowserViewForBrowser(browser)
+                                 : nullptr) {
+          pane->PrepareForHeliumDualFullscreen(fullscreen);
+        }
+      }
+      widget_->SetFullscreen(fullscreen, display_id);
+    } else {
+      // Content fullscreen may change while the window is already
+      // fullscreen; complete the browser's own transition.
+      view->PrepareForHeliumDualFullscreen(fullscreen);
+      view->FullscreenStateChanged();
+    }
+  }
+
+  void FullscreenChanged() {
+    if (!widget_->IsFullscreen() && pending_bounds_) {
+      const gfx::Rect bounds = *pending_bounds_;
+      pending_bounds_.reset();
+      SetBounds(bounds);
+    }
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (auto* view = browser ? BrowserView::GetBrowserViewForBrowser(browser)
+                               : nullptr) {
+        view->FullscreenStateChanged();
+      }
+    }
+    ScheduleSave();
+  }
+
+  void UpdateTitle() {
+    BrowserWindowInterface* browser = browsers_[active_side_]
+                                          ? browsers_[active_side_].get()
+                                          : (browsers_[0] ? browsers_[0].get()
+                                                          : browsers_[1].get());
+    auto* view =
+        browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    const std::u16string title =
+        view ? view->GetWindowTitle() : std::u16string(u"Dual");
+    if (title != delegate_->GetWindowTitle()) {
+      delegate_->SetTitle(title);
+    }
+  }
+
+  views::Widget::MoveLoopResult RunMoveLoop(
+      BrowserView* view,
+      const gfx::Vector2d& drag_offset,
+      views::Widget::MoveLoopSource source,
+      views::Widget::MoveLoopEscapeBehavior escape_behavior) {
+    // From the pane's origin to the window's.
+    const gfx::Vector2d pane_offset =
+        view->GetWidget()->GetWindowBoundsInScreen().origin() -
+        widget_->GetWindowBoundsInScreen().origin();
+    return widget_->RunMoveLoop(drag_offset + pane_offset, source,
+                                escape_behavior);
+  }
+
+  // Saving -------------------------------------------------------------------
+
+  void ScheduleSave() {
+    UpdateLiveGeometry();
+    save_timer_.Start(FROM_HERE, base::Milliseconds(200), this,
+                      &BrowserPair::Save);
+  }
+
+  void UpdateLiveGeometry() {
+    if (!widget_) {
+      return;
+    }
+    const std::string bounds = BoundsToString(NormalBounds());
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (browser) {
+        HeliumDualPaneState::From(browser)->set_ratio(ratio_);
+        HeliumDualPaneState::From(browser)->set_host_bounds(bounds);
+      }
+    }
+  }
+
+  void Save() {
+    UpdateLiveGeometry();
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (!browser) {
+        continue;
+      }
+      if (SessionService* service =
+              SessionServiceFactory::GetForProfile(browser->GetProfile())) {
+        const auto data =
+            MakeExtraData(group_id_, RoleOf(browser),
+                          HeliumDualPaneState::From(browser)->ratio(),
+                          HeliumDualPaneState::From(browser)->host_bounds());
+        for (const auto& [key, value] : data) {
+          service->AddWindowExtraData(browser->GetSessionID(), key.c_str(),
+                                      value);
+        }
+      }
+    }
+  }
+
+  // Closing the whole window -------------------------------------------------
+  // As on macOS: every warning (several tabs, downloads) and every page's
+  // "leave this site?" first, for both panes; then both close together, so
+  // that session restore brings both back.
+
+  void RequestClose() {
+    if (retired_ || closing_) {
+      return;
+    }
+    Save();
+    closing_ = true;
+    PreflightWarnings(0);
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (widget == widget_.get()) {
+      // The window itself: its active pane is what is in use.
+      if (active) {
+        ActivatePane(browsers_[active_side_] ? active_side_ : 1 - active_side_);
+      }
+      return;
+    }
+    if (!active) {
+      return;
+    }
+    for (size_t side = 0; side < 2; ++side) {
+      auto* view = browsers_[side]
+                       ? BrowserView::GetBrowserViewForBrowser(browsers_[side])
+                       : nullptr;
+      if (view && view->GetWidget() == widget) {
+        active_side_ = side;
+        UpdateTitle();
+        UpdateColors();
+      }
+    }
+  }
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& bounds) override {
+    if (widget != widget_.get()) {
+      return;
+    }
+    // A pane does not move within its window when the window moves, so its
+    // own observers are not told; a tab drag moving the window waits on them.
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (auto* view = browser ? BrowserView::GetBrowserViewForBrowser(browser)
+                               : nullptr;
+          view && view->GetWidget()) {
+        view->GetWidget()->OnNativeWidgetMove();
+      }
+    }
+    const bool fullscreen = widget_->IsFullscreen();
+    Relayout();
+    if (fullscreen != was_fullscreen_) {
+      was_fullscreen_ = fullscreen;
+      FullscreenChanged();
+    }
+    ScheduleSave();
+  }
+  void OnWidgetShowStateChanged(views::Widget* widget) override {
+    if (widget == widget_.get()) {
+      ScheduleRelayout();
+    }
+  }
+  void OnWidgetThemeChanged(views::Widget* widget) override {
+    background_color_.reset();
+    UpdateColors();
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    widget_observations_.RemoveObservation(widget);
+  }
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* view) override { UpdateColors(); }
+  void OnViewIsDeleting(views::View* view) override {
+    rail_observations_.RemoveObservation(view);
+  }
+
+ private:
+  void OnCloseCancelled(BrowserWindowInterface*,
+                        BrowserWindowInterface::ClosingStatus status) {
+    // Chromium also sends this while accepted unload handlers finish.
+    if (committing_close_ &&
+        (status == BrowserWindowInterface::ClosingStatus::kDeniedByUser ||
+         status == BrowserWindowInterface::ClosingStatus::kDeniedByPolicy)) {
+      CancelClose();
+    }
+  }
+
+  void CancelClose() {
+    if (!prepared_session_ids_.empty()) {
+      if (SessionService* service =
+              SessionServiceFactory::GetForProfile(profile_)) {
+        service->CancelWindowCloseGroup(prepared_session_ids_);
+      }
+      prepared_session_ids_.clear();
+    }
+    closing_ = false;
+    committing_close_ = false;
+    waiting_side_.reset();
+    close_weak_factory_.InvalidateWeakPtrs();
+    for (BrowserWindowInterface* browser : browsers_) {
+      if (browser) {
+        UnloadController::From(browser)->ResetBeforeUnloadForShutdown();
+      }
+    }
+  }
+
+  void PreflightWarnings(size_t side) {
+    if (!closing_) {
+      return;
+    }
+    if (side == browsers_.size()) {
+      PreflightBeforeUnload(0);
+      return;
+    }
+    BrowserWindowInterface* browser = browsers_[side];
+    if (!browser) {
+      PreflightWarnings(side + 1);
+      return;
+    }
+    using Result = UnloadController::WarnBeforeClosingResult;
+    waiting_side_ = side;
+    auto callback = base::BindOnce(&BrowserPair::OnWarning,
+                                   close_weak_factory_.GetWeakPtr(), side);
+    bool last_occupied = true;
+    for (size_t next = side + 1; next < browsers_.size(); ++next) {
+      last_occupied = last_occupied && !browsers_[next];
+    }
+    Result result;
+    if (last_occupied) {
+      std::vector<BrowserWindowInterface*> closing_group;
+      for (BrowserWindowInterface* member : browsers_) {
+        if (member) {
+          closing_group.push_back(member);
+        }
+      }
+      result = UnloadController::From(browser)->MaybeWarnBeforeClosingForGroup(
+          std::move(callback), closing_group);
+    } else {
+      result = UnloadController::From(browser)->MaybeWarnBeforeClosing(
+          std::move(callback));
+    }
+    if (result == Result::kOkToClose) {
+      waiting_side_.reset();
+      PreflightWarnings(side + 1);
+    }
+  }
+
+  void OnWarning(size_t side,
+                 UnloadController::WarnBeforeClosingResult result) {
+    waiting_side_.reset();
+    if (result == UnloadController::WarnBeforeClosingResult::kOkToClose) {
+      PreflightWarnings(side);
+    } else {
+      CancelClose();
+    }
+  }
+
+  void PreflightBeforeUnload(size_t side) {
+    if (!closing_) {
+      return;
+    }
+    if (side == browsers_.size()) {
+      Save();
+      for (BrowserWindowInterface* browser : browsers_) {
+        if (browser) {
+          prepared_session_ids_.push_back(browser->GetSessionID());
+        }
+      }
+      SessionService* service = SessionServiceFactory::GetForProfile(profile_);
+      if (!service ||
+          !service->PrepareForWindowCloseGroup(prepared_session_ids_)) {
+        prepared_session_ids_.clear();
+      }
+      committing_close_ = true;
+      for (BrowserWindowInterface* browser : browsers_) {
+        if (!committing_close_) {
+          break;
+        }
+        if (browser) {
+          browser->GetWindow()->Close();
+        }
+      }
+      return;
+    }
+    BrowserWindowInterface* browser = browsers_[side];
+    if (!browser) {
+      PreflightBeforeUnload(side + 1);
+      return;
+    }
+    waiting_side_ = side;
+    const bool waiting = UnloadController::From(browser)->RunBeforeUnloadForShutdown(
+        false, base::BindRepeating(&BrowserPair::OnBeforeUnload,
+                                   close_weak_factory_.GetWeakPtr(), side));
+    if (!waiting) {
+      waiting_side_.reset();
+      PreflightBeforeUnload(side + 1);
+    }
+  }
+
+  void OnBeforeUnload(size_t side, bool proceed) {
+    waiting_side_.reset();
+    if (proceed) {
+      PreflightBeforeUnload(side + 1);
+    } else {
+      CancelClose();
+    }
+  }
+
+  // Null once retired: the profile may be destroyed before this pair is.
+  raw_ptr<Profile> profile_;
+  const std::string group_id_;
+  // Reserved when a pane's widget is made, attached when it is shown.
+  std::array<raw_ptr<BrowserWindowInterface>, 2> browsers_{};
+  std::array<raw_ptr<BrowserWindowInterface>, 2> attached_{};
+  std::unique_ptr<HostDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<HostContents> contents_ = nullptr;
+  raw_ptr<DividerView> divider_ = nullptr;
+  std::array<raw_ptr<TabStripFlatEdgeButton>, 2> launch_buttons_{};
+  double ratio_ = kDefaultRatio;
+  double ratio_at_press_ = kDefaultRatio;
+  size_t active_side_ = 0;
+  std::array<bool, 2> hidden_{};
+  std::array<int, 2> hidden_rail_width_{
+      VerticalTabStripRegionView::kCollapsedWidth,
+      VerticalTabStripRegionView::kCollapsedWidth};
+  std::array<std::vector<std::pair<std::unique_ptr<views::ViewTracker>, bool>>,
+             2>
+      hidden_views_;
+  std::array<bool, 2> visibility_changing_{};
+  std::optional<size_t> window_controls_owner_;
+  std::optional<SkColor> background_color_;
+  int rail_button_top_ = 2;
+  bool maximize_on_show_ = false;
+  bool was_fullscreen_ = false;
+  bool laying_out_ = false;
+  bool activating_ = false;
+  std::optional<gfx::Rect> pending_bounds_;
+  std::array<base::CallbackListSubscription, 2> close_subscriptions_;
+  std::vector<SessionID> prepared_session_ids_;
+  bool retired_ = false;
+  bool creating_pane_ = false;
+  bool closing_ = false;
+  bool committing_close_ = false;
+  std::optional<size_t> waiting_side_;
+  base::ScopedMultiSourceObservation<views::Widget, views::WidgetObserver>
+      widget_observations_{this};
+  base::ScopedMultiSourceObservation<views::View, views::ViewObserver>
+      rail_observations_{this};
+  base::OneShotTimer relayout_timer_;
+  base::OneShotTimer save_timer_;
+  // Frameless mode.
+  bool auto_hide_rails_ = false;
+  bool rail_revealed_ = false;
+  int floating_top_ = kFloatingRailInset;
+  int floating_bottom_ = kFloatingRailInset;
+  int floating_width_ = 0;
+  std::unique_ptr<views::Widget> rail_overlay_;
+  raw_ptr<views::View> rail_panel_ = nullptr;
+  raw_ptr<TabStripFlatEdgeButton> overlay_button_ = nullptr;
+  std::unique_ptr<PointerWatcher> pointer_watcher_;
+  base::OneShotTimer zen_state_timer_;
+  base::OneShotTimer rail_hide_timer_;
+  base::RepeatingTimer rail_poll_timer_;
+  // Invalidated when a close is cancelled.
+  base::WeakPtrFactory<BrowserPair> close_weak_factory_{this};
+  base::WeakPtrFactory<BrowserPair> weak_factory_{this};
+};
+
+void PointerWatcher::OnMouseEvent(ui::MouseEvent* event) {
+  if (event->type() == ui::EventType::kMouseMoved ||
+      event->type() == ui::EventType::kMouseDragged ||
+      event->type() == ui::EventType::kMouseExited) {
+    pair_->PointerMoved();
+  }
+}
