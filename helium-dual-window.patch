+
+#ifndef HELIUM_DUAL_WINDOW_HOST_MAC_H_
+#define HELIUM_DUAL_WINDOW_HOST_MAC_H_
+
+#import <Cocoa/Cocoa.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+typedef NS_ENUM(NSInteger, HeliumDualPaneSide) {
+  HeliumDualPaneSideLeft = 0,
+  HeliumDualPaneSideRight = 1,
+};
+
+// Resolved by the adapter from the same layout constants, vector icon and
+// ColorProvider as the real vertical tab strip. No browser state is owned here.
+@interface HeliumDualRailStyle : NSObject
+@property(nonatomic) CGFloat width;
+@property(nonatomic) CGFloat buttonHeight;
+@property(nonatomic) CGFloat horizontalPadding;
+@property(nonatomic) CGFloat cornerRadius;
+@property(nonatomic) CGFloat buttonTop;
+@property(nonatomic, strong) NSColor* backgroundColor;
+@property(nonatomic, strong) NSColor* buttonColor;
+@property(nonatomic, strong) NSColor* hoverColor;
+@property(nonatomic, strong) NSColor* pressedColor;
+@property(nonatomic, strong) NSColor* separatorColor;
+@property(nonatomic, strong, nullable) NSImage* icon;
+@property(nonatomic, strong, nullable) NSImage* backgroundImage;
+@end
+
+@class HeliumDualWindowHost;
+
+// The host owns only the surrounding native frame. The delegate owns browser
+// policy and must retain the normal Browser / BrowserWidget ownership chain.
+@protocol HeliumDualWindowHostDelegate <NSObject>
+- (void)heliumDualWindowHostDidRequestRightPane:(HeliumDualWindowHost*)host;
+// Preflight both browsers' beforeunload handlers, then close them normally.
+// Call closeAfterBrowserShutdown only after both native panes are detached.
+- (void)heliumDualWindowHostDidRequestClose:(HeliumDualWindowHost*)host;
+@optional
+- (void)heliumDualWindowHostDidChangeFrame:(HeliumDualWindowHost*)host;
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+              didRequestPane:(HeliumDualPaneSide)side;
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+             didActivatePane:(HeliumDualPaneSide)side;
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+        willChangeFullscreen:(BOOL)fullscreen;
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+         didChangeFullscreen:(BOOL)fullscreen;
+- (void)heliumDualWindowHost:(HeliumDualWindowHost*)host
+         didChangeSplitRatio:(double)ratio;
+@end
+
+// Pure AppKit helper. Real Chromium BrowserWidgets remain top-level Widgets,
+// with their own native windows, focus managers, toolbars and command routing.
+// Cocoa child-window association supplies the unified visual frame.
+@interface HeliumDualWindowHost : NSObject <NSWindowDelegate>
+
+@property(nonatomic, weak, nullable) id<HeliumDualWindowHostDelegate> delegate;
+@property(nonatomic, readonly) NSWindow* window;
+// Last normal outer frame, never overwritten by fullscreen transition bounds.
+@property(nonatomic, readonly) NSRect normalFrame;
+// Like Chromium's native host, report the target state during a transition.
+@property(nonatomic, readonly, getter=isFullscreen) BOOL fullscreen;
+@property(nonatomic, readonly) BOOL fullscreenTransition;
+@property(nonatomic) double splitRatio;
+@property(nonatomic, readonly) BOOL hasRightPane;
+@property(nonatomic, readonly) HeliumDualPaneSide activePane;
+
+- (instancetype)initWithContentRect:(NSRect)contentRect
+                              title:(NSString*)title NS_DESIGNATED_INITIALIZER;
+- (instancetype)init NS_UNAVAILABLE;
+
+// The supplied pane remains owned by its browser. A pane must be detached from
+// this host before its BrowserWidget is destroyed. Attach before first Show.
+- (void)attachBrowserWindow:(NSWindow*)window side:(HeliumDualPaneSide)side;
+- (void)detachBrowserWindow:(NSWindow*)window;
+- (nullable NSWindow*)browserWindowForSide:(HeliumDualPaneSide)side;
+
+- (void)showAndActivate:(BOOL)activate;
+- (void)activatePane:(HeliumDualPaneSide)side;
+- (void)relayout;
+- (void)applyRailStyle:(HeliumDualRailStyle*)style;
+- (void)toggleFullscreen;
+- (void)requestFullscreen:(BOOL)fullscreen;
+- (void)closeAfterBrowserShutdown;
+
+@end
+
+NS_ASSUME_NONNULL_END
+
+#endif  // HELIUM_DUAL_WINDOW_HOST_MAC_H_
