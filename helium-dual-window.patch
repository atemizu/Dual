+namespace {
+BrowserPair* Find(const BrowserView* view, bool include_suspended = false) {
+  const BrowserWindowInterface* browser = view->browser();
+  auto profile = Pairs().find(browser->GetProfile());
+  if (profile == Pairs().end()) {
+    return nullptr;
+  }
+  auto pair = profile->second.find(HeliumDualPaneState::From(browser)->group_id());
+  if (pair == profile->second.end() || !pair->second ||
+      (!include_suspended && pair->second->IsPaneSuspended(view))) {
+    return nullptr;
+  }
+  return pair->second.get();
+}
+}  // namespace
+
+bool IsPaneHidden(const BrowserView* view) {
+  auto* pair = view ? Find(view) : nullptr;
+  return pair && pair->IsHidden(view);
+}
+bool IsPaneVisibilityChanging(const BrowserView* view) {
+  auto* pair = view ? Find(view) : nullptr;
+  return pair && pair->IsVisibilityChanging(view);
+}
+bool PaneShowsWindowControls(const BrowserView* view) {
+  auto* pair = view ? Find(view) : nullptr;
+  return pair && view->GetWidget() &&
+         pair->host().windowControlsPane ==
+             view->GetNativeWindow().GetNativeNSWindow();
+}
+void OnZenModeChanged(const BrowserView* view) {
+  // Deferred: this runs inside BrowserView's own Zen update, and the host
+  // relayout it can cause resizes that BrowserView.
+  if (auto* pair = view ? Find(view) : nullptr) pair->ScheduleZenState();
+}
+void SetPaneWindowControlsOpacity(const BrowserView* view, float opacity) {
+  auto* pair = view ? Find(view) : nullptr;
+  if (pair && view->GetWidget()) {
+    [pair->host() setWindowControlsAlpha:opacity
+                                 forPane:view->GetNativeWindow()
+                                             .GetNativeNSWindow()];
+  }
+}
+bool CanHidePane(const BrowserView* view) {
+  auto* pair = Find(view);
+  return pair && pair->CanHide(view);
+}
+void SetPaneHidden(BrowserView* view, bool hidden) {
+  if (auto* pair = Find(view)) pair->SetHidden(view, hidden);
+}
