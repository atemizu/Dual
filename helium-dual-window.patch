+// Native resize callbacks may pump tasks that close a tab or the entire pair.
+// Track Views lifetimes and restore the previous state, including nested use.
+class ScopedNativeContentsResize {
+ public:
+  void Add(ContentsWebView* view) {
+    auto tracker = std::make_unique<views::ViewTracker>();
+    tracker->SetView(view);
+    views_.emplace_back(std::move(tracker), view->is_resizing_native_view());
+    view->SetIsResizingNativeView(true);
+  }
+
+  ~ScopedNativeContentsResize() {
+    for (auto& [tracker, was_resizing] : views_) {
+      if (auto* view = tracker->view()) {
+        static_cast<ContentsWebView*>(view)->SetIsResizingNativeView(was_resizing);
+      }
+    }
+  }
+
+  bool HasPendingFrame() {
+    for (const auto& [tracker, was_resizing] : views_) {
+      if (auto* view = tracker->view()) {
+        if (content::HasPendingCompositorFrameForNativeResize(
+                static_cast<ContentsWebView*>(view)->web_contents())) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+
+ private:
+  std::vector<std::pair<std::unique_ptr<views::ViewTracker>, bool>> views_;
+};
