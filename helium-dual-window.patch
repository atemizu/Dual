+#include "extensions/browser/unpacked_installer.h"
+
+namespace helium_dual {
+
+namespace {
+
+constexpr char kBundledExtensionsPref[] = "helium.dual.bundled_extensions";
+
+constexpr char kRestoreBundledExtensionsSwitch[] =
+    "dual-restore-bundled-extensions";
+
+base::FilePath BundledExtensionsDirectory() {
+  base::FilePath program_directory;
+  if (!base::PathService::Get(base::DIR_EXE, &program_directory)) {
+    return base::FilePath();
+  }
+  return program_directory.Append("dual-extensions");
+}
+
+}  // namespace
+
+void RegisterBundledExtensionsPrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterDictionaryPref(kBundledExtensionsPref);
+}
+
+// As on macOS; see helium_dual_bundled_extensions.mm.
+void LoadBundledExtensions(Profile* profile) {
+  if (!extensions::profile_util::ProfileCanUseNonComponentExtensions(profile)) {
+    return;
+  }
+  const base::FilePath directory = BundledExtensionsDirectory();
+  if (directory.empty()) {
+    return;
+  }
+
+  ScopedDictPrefUpdate given(profile->GetPrefs(), kBundledExtensionsPref);
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kRestoreBundledExtensionsSwitch)) {
+    given->clear();
+  }
+
+  extensions::ExtensionPrefs* extension_prefs =
+      extensions::ExtensionPrefs::Get(profile);
+  base::FileEnumerator folders(directory, /*recursive=*/false,
+                               base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = folders.Next(); !path.empty();
+       path = folders.Next()) {
+    const std::string id = path.BaseName().value();
+    if (!crx_file::id_util::IdIsValid(id)) {
+      continue;
+    }
+
+    // An extension loaded this way is not kept between launches, but its
+    // record is, until the user removes the extension. A missing record for
+    // one given before therefore means it was removed.
+    const std::optional<bool> installed = given->FindBool(id);
+    if (installed.has_value() &&
+        (!*installed || !extension_prefs->GetInstalledExtensionInfo(id))) {
+      given->Set(id, false);
+      continue;
+    }
+
+    std::string loaded_id;
+    if (!extensions::UnpackedInstaller::Create(profile)->LoadFromCommandLine(
+            path, &loaded_id, /*only_allow_apps=*/false) ||
+        loaded_id != id) {
+      continue;
+    }
+    if (!installed.has_value()) {
+      // New to this profile: its button starts out pinned to the toolbar. If
+      // the user unpins it, it stays unpinned.
+      extensions::ExtensionIdList pinned =
+          extension_prefs->GetPinnedExtensions();
+      if (!std::ranges::contains(pinned, id)) {
+        pinned.push_back(id);
+        extension_prefs->SetPinnedExtensions(pinned);
+      }
+    }
+    given->Set(id, true);
+  }
+}
+
+}  // namespace helium_dual
