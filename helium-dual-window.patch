+void NativeWidgetNSWindowBridge::StageFrame(NSRect new_window_frame) {
+  // A live resize owns the window's size while it runs.
+  if (live_resize_.pending_window_frame.has_value()) {
+    return;
+  }
+  staged_.window_frame = new_window_frame;
+  staged_.ca_layer_params = std::nullopt;
+  SendWindowFrameChangeToHost(new_window_frame);
+}
+
+bool NativeWidgetNSWindowBridge::HasStagedCompositorFrame() const {
+  // A staged frame of the size already shown needs no new contents.
+  return staged_.window_frame.has_value() &&
+         (staged_.ca_layer_params.has_value() ||
+          compositor_frame_dip_size_ == content_dip_size_);
+}
+
+void NativeWidgetNSWindowBridge::CommitStagedFrame() {
+  if (!staged_.window_frame.has_value()) {
+    return;
+  }
+  const NSRect frame = staged_.window_frame.value();
+  std::optional<gfx::CALayerParams> ca_layer_params =
+      std::move(staged_.ca_layer_params);
+  staged_ = StagedResize();
+  if (ca_layer_params.has_value()) {
+    SetCALayerParams(std::move(ca_layer_params.value()));
+  }
+  [window_ setFrame:frame display:YES animate:NO];
+  // Cocoa sends no notification for a frame the window already had.
+  UpdateWindowGeometry();
+}
+
+void NativeWidgetNSWindowBridge::CancelStagedFrame() {
+  if (!staged_.window_frame.has_value()) {
+    return;
+  }
+  staged_ = StagedResize();
+  UpdateWindowGeometry();
+}
