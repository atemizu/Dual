+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  // WebUIDataSource is shared by the profile. Resolve the current owner when
+  // this page asks, so another window cannot overwrite its effective mode.
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
